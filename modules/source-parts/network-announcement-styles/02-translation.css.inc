/* Translation demo: a visible, operable control with restrained-area motion. */
#madar-hub #sa-panel-1 .sa-panel-heading{display:grid;grid-template-columns:40px minmax(0,1fr) auto;gap:10px}#madar-hub #sa-panel-1 .sa-panel-heading>div{min-width:0}
#madar-hub .sa button.sa-lang{position:relative;isolation:isolate;overflow:hidden;min-width:106px;min-height:48px;padding:7px 11px;border:1px solid #c5f4df;border-radius:13px;background:linear-gradient(115deg,#b9edda,#e9d29d 48%,#a2dedc 75%,#b9edda);background-size:250% 100%;color:#102d33;font-size:13px;gap:9px;box-shadow:0 0 0 3px #a5eadc12,0 0 24px #9eead746,0 5px 16px #0003;animation:sa-translate-glow 3.8s ease-in-out infinite;transition:transform .2s,box-shadow .2s}
#madar-hub .sa button.sa-lang:before{content:'';position:absolute;inset:-70% -70%;z-index:-1;background:linear-gradient(110deg,transparent 40%,#fff9 49%,transparent 58%);transform:translateX(-60%);animation:sa-translate-sheen 4.8s ease-in-out infinite;pointer-events:none}
#madar-hub .sa .sa-lang-icon{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border-radius:8px;background:#173c3820;border:1px solid #25423e20;animation:sa-translate-icon 3.8s ease-in-out infinite}#madar-hub .sa .sa-lang-icon svg{width:21px!important;height:21px!important;stroke-width:2}#madar-hub .sa .sa-lang-label{display:flex;flex-direction:column;gap:1px;align-items:center;position:relative}#madar-hub .sa .sa-lang-label b{font-size:13px;font-weight:800;line-height:1.4}#madar-hub .sa .sa-lang-label small{font:700 8px/1.4 'Segoe UI',sans-serif;letter-spacing:.6px;color:#31554e}
#madar-hub .sa button.sa-lang:hover{transform:translateY(-2px);box-shadow:0 0 0 4px #bdeed620,0 0 32px #b6ebcc66,0 7px 18px #0003}#madar-hub .sa button.sa-lang:active{transform:translateY(0) scale(.97)}#madar-hub .sa button.sa-lang[aria-pressed=true]{border-color:#f0d59d;background-position:70% 50%}#madar-hub .sa .sa-option-text{font-weight:400;flex:1;min-width:0}#madar-hub .sa .sa-question[dir=rtl]{font-family:inherit;text-align:right;font-size:15px}#madar-hub .sa .sa-option[dir=rtl]{text-align:right;font-family:inherit}#madar-hub .sa .sa-option[dir=rtl]>svg{margin-left:0;margin-inline-start:auto}
@keyframes sa-translate-glow{0%,100%{background-position:0% 50%;box-shadow:0 0 0 3px #a5eadc12,0 0 18px #9eead735,0 5px 16px #0003}50%{background-position:100% 50%;box-shadow:0 0 0 5px #c1ebcc20,0 0 34px #a9e9ce6b,0 5px 16px #0003}}
@keyframes sa-translate-sheen{0%,18%{transform:translateX(-65%)}52%,100%{transform:translateX(65%)}}@keyframes sa-translate-icon{0%,65%,100%{transform:translateY(0) rotate(0)}22%{transform:translateY(-2px) rotate(-8deg)}40%{transform:translateY(1px) rotate(5deg)}}
@media(max-width:400px){#madar-hub #sa-panel-1 .sa-panel-heading{grid-template-columns:30px minmax(0,1fr) auto;gap:7px}#madar-hub #sa-panel-1 .sa-mini-icon{width:30px;height:34px;border-radius:9px}#madar-hub #sa-panel-1 .sa-panel-heading h2{font-size:13px}#madar-hub .sa button.sa-lang{min-width:90px;padding:7px;gap:6px}#madar-hub .sa .sa-lang-icon{width:24px;height:26px;flex-basis:24px}#madar-hub .sa .sa-lang-label b{font-size:12px}#madar-hub .sa .sa-question[dir=rtl]{font-size:13px}}
@media(prefers-reduced-motion:reduce){#madar-hub .sa button.sa-lang:hover,#madar-hub .sa button.sa-lang:active{transform:none}}


