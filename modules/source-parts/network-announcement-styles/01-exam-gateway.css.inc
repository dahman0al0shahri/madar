/* Exam gateway: explicit Saudi appointment and a wall-clock based countdown. */
#madar-hub .sa-exam-schedule{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px 38px;border-bottom:1px solid #8ca4a72b;background:linear-gradient(100deg,#a6d9d308,#d7b7860a)}
#madar-hub .sa-exam-date>span{display:flex;align-items:center;gap:8px;color:#b9d3ce;font-size:12px;margin-bottom:8px}#madar-hub .sa-exam-date>span svg{color:#d4bd95}#madar-hub .sa-exam-date time{display:flex;flex-direction:column;gap:6px}#madar-hub .sa-exam-date strong{font-size:21px;color:#eee2cd;font-weight:700}#madar-hub .sa-exam-date small{font-size:13px;color:#aebdc1}#madar-hub .sa-exam-date small b{color:#e7dac1;font-weight:500}
#madar-hub .sa-countdown-wrap{text-align:center}#madar-hub .sa-countdown-label{display:block;font-size:11px;color:#b0c7c5;margin-bottom:10px}#madar-hub .sa-countdown{display:flex;align-items:center;gap:10px}#madar-hub .sa-time-unit{position:relative;display:flex;flex-direction:column;align-items:center;min-width:80px;padding:9px 13px 8px;background:linear-gradient(#1b3038,#11232c);border:1px solid #8caeac40;border-radius:12px;box-shadow:0 3px 9px #0002,0 1px 0 #d2e8e908 inset}#madar-hub .sa-time-unit:after{content:'';position:absolute;top:50%;left:5px;right:5px;border-top:1px solid #afc7c507;pointer-events:none}#madar-hub .sa-time-unit strong{font:500 35px/1.2 'Segoe UI',sans-serif;font-variant-numeric:tabular-nums;letter-spacing:1px;color:#e9d6b4}#madar-hub .sa-time-unit span{font-size:10px;color:#a4bec1;margin-top:3px}#madar-hub .sa-countdown>i{font:300 25px 'Segoe UI',sans-serif;color:#7b999d;font-style:normal;padding-bottom:15px}#madar-hub .sa[data-exam-reached=true] .sa-countdown-label{color:#e0c397}
@media(max-width:700px){#madar-hub .sa-exam-schedule{flex-direction:column;align-items:stretch;padding:22px 24px;gap:20px}#madar-hub .sa-exam-date strong{font-size:20px}#madar-hub .sa-countdown{justify-content:center}#madar-hub .sa-countdown-wrap{padding-top:16px;border-top:1px solid #8ca4a722}#madar-hub .sa-copy h1{font-size:30px}}
@media(max-width:400px){#madar-hub .sa-exam-schedule{padding:20px 17px}#madar-hub .sa-exam-date strong{font-size:18px}#madar-hub .sa-countdown{gap:6px}#madar-hub .sa-time-unit{min-width:65px;padding-inline:8px}#madar-hub .sa-time-unit strong{font-size:30px}#madar-hub .sa-copy h1{font-size:26px}}
#madar-hub .sa-detail-strip.sa-summary{display:flex;gap:16px;padding:23px 12px;text-align:start;max-width:100%;font-size:14px;line-height:2;color:#c1d2d3}#madar-hub .sa-summary p{margin:0!important;max-width:820px;font-size:inherit!important;line-height:inherit!important;color:inherit!important}#madar-hub .sa-summary .sa-summary-icon{display:flex;align-items:center;justify-content:center;flex:0 0 42px;height:42px;border:1px solid #9dc9c139;border-radius:13px;background:linear-gradient(140deg,#34605c40,#152b35);box-shadow:0 0 22px #8dc8bc0a}#madar-hub .sa-summary .sa-summary-icon svg{width:21px!important;height:21px!important;color:#d8c198}@media(max-width:700px){#madar-hub .sa-detail-strip.sa-summary{align-items:flex-start;font-size:12px;gap:12px;padding:23px 5px}#madar-hub .sa-summary .sa-summary-icon{flex-basis:36px;height:36px}}
