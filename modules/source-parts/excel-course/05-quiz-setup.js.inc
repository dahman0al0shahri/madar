function quiz(lessonId){
 shelf(D.lessons.find(l=>l.id===lessonId));
 root.innerHTML=`<nav class="quiz-subjects" aria-label="اختر برنامج الاختبار"><a class="button " href="#quiz">الوورد</a><a class="button primary" href="#quiz/excel" aria-current="page">الإكسل</a><a class="button" href="#quiz/access">الأكسس</a></nav><p class="eyebrow">EXCEL / استرجع قبل أن تكشف الإجابة</p><h1>اختبر نفسك بطريقتك</h1><p class="muted">${ar(D.questions.length)} سؤال اختيار من متعدد. أسئلة تدريبية، وليست أسئلة الاختبار الرسمي.</p><div id="excel-quiz-setup"><section class="panel"><h2>اختبار الإكسل الشامل</h2><p>سؤال من كل درس له أسئلة، ويشمل ملفات التمارين. مجموعها ${ar(D.lessons.filter(l=>D.questions.some(q=>q.lesson===l.id)).length)} سؤال. جاوب أول، والتصحيح يطلع لك في النهاية.</p><button id="excel-comprehensive" class="primary" ${!D.questions.length?'disabled':''}>ابدأ الاختبار الشامل</button></section><form id="excel-quiz-form" class="panel"><label class="field">نطاق المراجعة<select id="excel-scope"><option value="all">كل الدروس</option><option value="mistakes">أخطائي السابقة</option>${groups.map(g=>`<option value="unit:${g}">${unit(g)} كاملة</option>`).join('')}${groups.map(g=>`<optgroup label="${unit(g)}">${D.lessons.filter(l=>l.unit===g).map(l=>`<option value="${l.id}" ${l.id===lessonId?'selected':''}>${esc(l.title)}</option>`).join('')}</optgroup>`).join('')}</select></label><label class="field">عدد الأسئلة<input id="excel-count" aria-describedby="excel-available" type="number" min="1" max="100" value="${lessonId?'5':'10'}" required><small id="excel-available" class="muted" aria-live="polite"></small></label><label class="field">طريقة الحل<select id="excel-quiz-mode"><option value="practice">تدريب — التصحيح بعد كل سؤال</option><option value="exam">اختبار — التصحيح في النهاية</option></select></label><button class="primary">ابدأ المراجعة</button></form></div><div id="excel-question"></div>${statusBox()}`;
 const seenSessions=new Set();const recent=events.filter(e=>{if(e.kind!=='session'||seenSessions.has(e.payload?.sessionId))return false;seenSessions.add(e.payload.sessionId);return true;}).find(e=>e.kind==='session'&&excelBankCompatible(e.payload?.bankVersion,D.bankVersion,e.payload?.ids,D.questions)&&!e.payload.finished&&e.payload.ids.every(id=>D.questions.some(q=>q.id===id)));if(recent){$('#excel-quiz-form').insertAdjacentHTML('beforebegin','<section class="panel"><p>عندك مراجعة سابقة: '+ar(recent.payload.answers.length)+' إجابة محفوظة.</p><button id="excel-resume">كمل مراجعتي</button></section>');$('#excel-resume').onclick=()=>{$('#excel-quiz-setup').hidden=true;$('#excel-resume').parentElement.remove();run(recent.payload.ids.map(id=>D.questions.find(q=>q.id===id)),recent.payload.mode,recent.payload);};}
 $('#excel-comprehensive').onclick=()=>{const items=D.lessons.map(l=>{const pool=D.questions.filter(q=>q.lesson===l.id);return pool[Math.floor(Math.random()*pool.length)];}).filter(Boolean);for(let i=items.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[items[i],items[j]]=[items[j],items[i]];}if(!items.length)return;$('#excel-quiz-setup').hidden=true;run(items,'exam');};
 function availableQuestions(){const scope=$('#excel-scope').value;return D.questions.filter(q=>scope==='all'||(scope==='mistakes'?last('attempt',q.id)?.payload.correct===false:scope.startsWith('unit:')?String(q.unit)===scope.slice(5):q.lesson===scope));}
 function refreshCount(){const size=availableQuestions().length,count=$('#excel-count');count.max=String(Math.max(1,size));if(size&&Number(count.value)>size)count.value=String(size);$('#excel-available').textContent=size?'المتاح وفق اختيارك: '+ar(size)+' سؤالًا':$('#excel-scope').value==='mistakes'?'ما عندك أخطاء محفوظة للمراجعة الآن. اختر نطاقًا آخر.':'لا توجد أسئلة لهذا الاختيار.';$('#excel-quiz-form button').disabled=!size;}
 $('#excel-scope').onchange=refreshCount;refreshCount();
 $('#excel-quiz-form').onsubmit=e=>{e.preventDefault();const pool=availableQuestions(),requested=Number($('#excel-count').value);if(!Number.isInteger(requested)||requested<1||requested>pool.length){refreshCount();return;}for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}const items=pool.slice(0,requested);if(!items.length){message('لا توجد أسئلة لهذا الاختيار. اختر نطاقًا آخر.');return;}const mode=$('#excel-quiz-mode').value;$('#excel-quiz-setup').hidden=true;run(items,mode);};
}
