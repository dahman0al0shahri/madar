function lesson(l){
  root.addEventListener('madar-training',e=>{const {result,recall}=e.detail||{};if(typeof result!=='boolean')return;track(recall?'training_recall':'training_check',{lesson:l.id,value:result?'correct':'incorrect'});if(!recall)void save({eventId:crypto.randomUUID(),kind:'training',lesson:l.id,result});},{signal:listeners.signal});
 track('page_open',{lesson:l.id});shelf(l);let mode='summary';const index=D.lessons.indexOf(l);let vid='';try{vid=new URL(l.video).searchParams.get('v')||'';}catch{}
 root.innerHTML=`<div class="lesson-heading"><a class="back-to-library" href="#excel">مكتبة الوحدات</a><div class="intro-line"><span class="eyebrow">EXCEL / ${unit(l.unit)} · الدرس ${ar(l.sourceNumber||index+1)}</span><span class="chip">مرجع Excel</span></div><h1>${esc(l.title)}</h1></div><div class="lesson-workbench"><aside id="lesson-notes" class="lesson-notes" aria-label="ملاحظتي على الدرس"></aside><section id="video-section" aria-label="مصدر شرح الدرس"><div class="stage-bar"><span><i aria-hidden="true"></i>${vid?'شاهد لتفهم':'افهم من ملف التمرين'}</span><span class="stage-id">EXCEL / ${String(index+1).padStart(2,'0')}</span></div>${vid?`<div class="video-frame"><iframe data-lesson="${esc(l.id)}" src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(vid)}?rel=0&playsinline=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}" title="شرح فيديو: ${esc(l.title)}" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><div class="video-info"><span>الإدارة العامة لمركز التدرب الإلكتروني</span><a href="${esc(l.video)}" target="_blank" rel="noopener">فتح الفيديو في YouTube</a></div><p class="small muted">إذا تعذر تشغيل الفيديو، افتحه من الرابط. التشغيل يحتاج اتصالًا بالإنترنت.</p>`:`<div class="panel"><p class="eyebrow">ملفات التمارين</p><h2>${esc(l.title)}</h2><p>${rich(l.summary)}</p><p class="small muted">الموضع في المصدر: ${esc(l.locator||'ملف التمرين المرفق بالمقرر')}. لا يوجد فيديو مرفق بهذا الدرس.</p>${workbook.isLesson(l)?workbook.markup():''}</div>`}</section></div><p><a href="#about/report/lesson/${l.id}">بلّغ عن مشكلة في الدرس أو الفيديو</a></p><div id="excel-review"></div>`;
 window.MADAR_NOTES.mount(l.id).then(()=>{if(!vid&&root?.querySelector('#lesson-notes [data-note-time]'))root.querySelector('#lesson-notes [data-note-time]').hidden=true;});
 function review(){
 $('#excel-review').innerHTML=`<div class="review-heading"><div><p class="eyebrow">بعد المشاهدة والقراءة</p><h2>ثبّت ما تعلّمت.</h2></div><button id="excel-bookmark" aria-pressed="${marked(l.id)}">${marked(l.id)?'✓ محفوظ للمراجعة':'＋ برجع لها'}</button></div><div class="tabs" role="group" aria-label="طريقة المراجعة"><button data-ex-mode="summary" aria-pressed="${mode==='summary'}">ملخص للحفظ</button><button data-ex-mode="all" aria-pressed="${mode==='all'}">الشرح المكتوب الكامل</button></div><div class="reading reading-${mode}">${mode==='summary'?`<section class="panel concept"><h3>الفكرة التي تحفظها</h3><p>${rich(l.summary)}</p></section>`:l.sections.map(s=>`<section class="panel"><h3>${esc(s.title)}</h3>${sectionText(s)}${table(s.table)}</section>`).join('')}<div id="excel-lab"></div><section class="panel soft"><h3>استرجعها بعد فترة</h3><p>اختبر نفسك قبل إعادة فتح الشرح. أضف الدرس للمراجعة؛ الموعد اقتراح منك وليس تقييمًا لإتقانك.</p><div class="bottom-actions"><button data-review-delay="tomorrow">راجع غدًا</button><button data-review-delay="three_days">بعد ٣ أيام</button><button data-review-delay="clear">إلغاء الموعد</button></div>${statusBox()}</section><div class="bottom-actions"><a class="button primary" href="#quiz/excel/${l.id}">تدرّب على هذا الدرس</a><a class="button" href="#quiz/excel">خصّص مراجعتك</a></div><details class="source-box"><summary>مصدر الدرس وحدود المراجعة</summary><p>${esc(l.source_limit||'المراجعة مبنية على الملخص المنقول والوثائق؛ لم تتحقق جميع تفاصيل الفيديو مستقلاً. قد تختلف الواجهة باختلاف الإصدار.')}</p>${l.video?'<a target="_blank" rel="noopener" href="'+esc(l.video)+'">الفيديو الأصلي</a>':''}${(l.references||[]).map(r=>'<p><a target="_blank" rel="noopener" href="'+esc(r.url||r)+'">'+esc(r.title||'مرجع التصحيح')+'</a></p>').join('')}</details><div class="bottom-actions">${index?`<a class="button" href="${href(D.lessons[index-1])}">الدرس السابق</a>`:''}<span class="spacer"></span>${index<D.lessons.length-1?`<a class="button" href="${href(D.lessons[index+1])}">الدرس التالي</a>`:'<a href="#quiz/excel">مراجعة الإكسل</a>'}</div></div>`;
 all('[data-ex-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.exMode;track('review_mode',{lesson:l.id,value:mode});review();});
 $('#excel-bookmark').onclick=async e=>{const b=e.currentTarget;b.disabled=true;const ok=await save({eventId:crypto.randomUUID(),kind:'bookmark',lesson:l.id,value:!marked(l.id)});b.disabled=false;if(ok){track(marked(l.id)?'bookmark_add':'bookmark_remove',{lesson:l.id});b.setAttribute('aria-pressed',String(marked(l.id)));b.textContent=marked(l.id)?'✓ محفوظ للمراجعة':'＋ برجع لها';}};
 all('[data-review-delay]').forEach(b=>b.onclick=async()=>{b.disabled=true;await save({eventId:crypto.randomUUID(),kind:'review',lesson:l.id,value:b.dataset.reviewDelay});b.disabled=false;});

 const activity=D.activities?.[l.id];if(activity)window.MADAR_EXCEL_LAB.mount($('#excel-lab'),activity,l.id);else window.MADAR_EXCEL_GUIDE.mount($('#excel-lab'),D.guides?.[l.id]);
 }review();
}
