function shelf(current){
 document.querySelector('#sidebar').innerHTML=`<div class="shelf-title"><div><strong>دليلك في Excel</strong><br><span>١٢ وحدة · ملفات التمارين</span></div><button id="excel-toggle-index" aria-expanded="false">الفهرس</button></div><div class="units">${groups.map(g=>`<details class="unit" ${current?.unit===g?'open':''}><summary>${unit(g)}<small>${ar(D.lessons.filter(l=>l.unit===g).length)}</small></summary>${D.lessons.filter(l=>l.unit===g).map(l=>`<a class="lesson-link ${l.id===current?.id?'current':''}" ${l.id===current?.id?'aria-current="page"':''} href="${href(l)}"><span class="n">${ar(workbook.isLesson(l)?workbook.number(l):D.lessons.indexOf(l)+1)}</span>${esc(l.title)}</a>`).join('')}</details>`).join('')}</div><p class="side-note">شاهد لتفهم، ثم راجع لتتذكر.<br>فتح الدرس أو إتمام نشاط واحد لا يعني إتقان الوحدة.</p>`;
 document.querySelector('#excel-toggle-index').onclick=e=>{const open=document.querySelector('#sidebar').classList.toggle('expanded');e.currentTarget.setAttribute('aria-expanded',String(open));};
}
function statusBox(){if(window.MADAR_CONTENT_PREVIEW)return '<p role="status">معاينة خاصة: لا نحفظ نتائج أو ملاحظات هنا.</p>';return '<p id="excel-save-status" class="small muted" role="status">'+(saveError?'تعذر تحميل سجل المراجعة. أعد التحميل قبل حفظ نتائج جديدة.':(window.MADAR_ACCOUNT.user?'ملاحظاتك ومراجعاتك محفوظة في حسابك، ومنفصلة عن الوورد.':'ملاحظاتك ونتائجك تنحفظ على هذا المتصفح فقط.'))+'</p>';}
function library(filter='all'){
 shelf();const list=filter==='saved'?D.lessons.filter(l=>marked(l.id)||due(l.id)):filter==='mistakes'?D.lessons.filter(l=>D.questions.some(q=>q.lesson===l.id&&last('attempt',q.id)?.payload.correct===false)):D.lessons;
 root.innerHTML=`<p class="eyebrow">EXCEL / مساحتك للتعلّم</p><h1>${filter==='saved'?'برجع لها في الإكسل':filter==='mistakes'?'أخطائي في الإكسل':'الإكسل، درسًا بعد درس.'}</h1><p class="muted">دروس تطبيقات الحاسب المتقدمة وملفات التمارين. وجود الدرس هنا لا يحدد وحده نطاق اختبارك. شاهد، دوّن، افهم، ثم استرجع. اثنتا عشرة وحدة وملفات التمارين، مع ${ar(D.questions.length)} سؤال للمراجعة.</p><div class="bottom-actions"><a class="button primary" href="${href(list[0]||D.lessons[0])}">افتح أول درس</a><a class="button" href="#quiz/excel">اختبر نفسك</a><a href="#saved/excel">برجع لها</a><a href="#mistakes/excel">أخطائي</a></div>${statusBox()}<label class="field excel-search">ابحث عن درس<input id="excel-search" type="search" placeholder="اسم الدرس…"></label><div class="unit-collection">${groups.map(g=>{const rows=list.filter(l=>l.unit===g);return rows.length?`<article class="unit-card"><div class="unit-card-heading"><span class="unit-n">${unit(g)}</span><span class="unit-count">${ar(rows.length)} ${g==='workbook'?'تطبيقًا':'درسًا'}</span></div>${g==='workbook'?'<p>'+workbook.intro+'</p>'+workbook.markup():''}<div class="unit-lessons">${rows.map(l=>`<a data-title="${esc(l.title)}" href="${href(l)}"><span class="lesson-play" aria-hidden="true">${workbook.isLesson(l)?ar(workbook.number(l)):l.video?'▷':'▤'}</span><span>${esc(l.title)}${due(l.id)?'<small> · '+(new Date(due(l.id))<=new Date()?'حان وقت المراجعة':'مراجعة '+new Date(due(l.id)).toLocaleDateString('ar-SA',{calendar:'gregory'}))+'</small>':''}</span></a>`).join('')}</div></article>`:''}).join('')}</div>${!list.length?'<p class="empty">لا توجد دروس في هذه القائمة بعد.</p>':''}`;
 $('#excel-search').oninput=e=>{all('[data-title]').forEach(a=>a.hidden=!a.dataset.title.includes(e.target.value.trim()));all('.unit-card').forEach(c=>c.hidden=![...c.querySelectorAll('[data-title]')].some(a=>!a.hidden));};
}
