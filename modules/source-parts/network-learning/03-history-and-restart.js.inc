function history(){capture();const a=active(),records=a.helpArchive||a.training?.archive||[],events=a.data.assistance?.events||[];
 modal('سجل المساعدات — '+a.name,'<p>النص كما ظهر عند طلبه. إعادة القراءة لا تزيد العدد. قد تختلف أوامر الدخول عن وضع الجهاز الحالي.</p><div id="ml-help-history"></div>');
 const dest=$('#ml-help-history');if(!events.length){dest.textContent='لم تُسجل مساعدة في هذا المختبر.';return;}
 for(const ev of [...events].reverse()){const r=records.find(x=>x.attempt===ev[0]&&x.key===ev[1]&&x.hint===ev[2]),d=document.createElement('details'),sum=document.createElement('summary'),pre=document.createElement('pre');sum.textContent=(r?.goal||'مساعدة سابقة')+' · '+(r?.label||window.MadarAssistance.LABELS[ev[3]])+' · '+new Date(ev[4]).toLocaleString('ar-SA',{timeZone:'Asia/Riyadh'});pre.textContent=r?r.body+(r.remaining?'\nيبقى عليك: '+r.remaining:''):'هذا سجل قديم لم يحفظ النص وقت عرضه؛ لن نعرض نصًا جديدًا على أنه النص القديم.';d.append(sum,pre);dest.append(d);}
}
$('#ml-history').onclick=history;
$('#ml-restart').onclick=()=>{if(B.busy()){toast('أكمل حركة الكابل أولًا.');return;}capture();const a=active(),src=a.helper&&lab(a.sourceOriginal),data=clone(src?src.data:a.training?.initial||baseline);modal($('#ml-restart').textContent+'؟','<p>'+(src?'سيعود المساعد إلى الحالة الحالية لمختبر التمرين.':'سيعود هذا المختبر إلى حالته الأصلية عند البداية، وبنفس متطلبات الدرس أو التمرين وقيمه.')+'</p><ul><li>تُلغى تغييراتك على الأجهزة والكابلات وإعداداتها، وتُزال العناصر التي أضفتها.</li><li>'+(src?'تعود إلى الخطوة الحالية لمختبر التمرين':a.training?.assessment?'تعود إلى بداية خطوة إعادة التقييم':'تعود إلى أول خطوة')+'، وتُمسح مسودة الأوامر ونتائج الفحص الحالية وسجل التراجع. لا يمكن التراجع عن هذه الإعادة.</li><li>يبقى سجل المساعدات ونتائج المحاولات السابقة محفوظًا، ولا تتغير مختبراتك الأخرى.</li></ul><button id="ml-restart-cancel">إلغاء — الاحتفاظ بمحاولتي</button><button id="ml-restart-confirm" class="ml-danger">تأكيد الإعادة من البداية</button>');$('#ml-restart-cancel').onclick=close;$('#ml-restart-cancel').focus();$('#ml-restart-confirm').onclick=()=>{
 if(active().id!==a.id||B.busy())return;
 const previousAssistance=!!a.copied||!!a.training?.assessment?.helpUsed||a.data.assistance.events.some(e=>e[0]===a.data.assistance.attempt);const assistance=clone(a.data.assistance),attempt='attempt-'+uid();assistance.attempt=attempt;data.assistance=assistance;data.editUndo=null;data.lesson=null;data.vlanExercise=false;a.undo=null;a.configUndo=null;a.logs=[];a.results=[];a.resultSeen=0;a.verdict='';a.copied=false;clearTimeout(pendingPings.get(a.id));pendingPings.delete(a.id);
 if(a.training){a.training.evidence.push({type:'restart',at:new Date().toISOString(),previousStep:a.training.step});a.training.step=src?.training?.step||a.training.assessment?.target||practiceSequence(a.training)[0];a.training.checks={};a.training.observed={};a.training.completed=false;if(a.training.assessment){a.training.assessment.repeated=true;a.training.assessment.helpUsed=previousAssistance;a.training.assessment.finished=false;a.training.assessment.startedAt=Date.now();a.training.assessment.id=uid();a.training.assessment.answered=null;}}
 selected.clear();placing=false;$('#ml-paste-guide').hidden=true;if(src)a.aliases=clone(src.aliases);else if(a.kind==='original')a.aliases={};
 B.learning.clearFocus();learningIssue=null;diagnosticRevision=null;learningKey='';$('#ml-diagnosis').hidden=true;
 a.revision++;if(src){a.sourceRevision=src.revision;a.ignoreStale=null;}a.data=data;loading=true;B.restore(data);loading=false;root.dispatchEvent(new CustomEvent('labs:attempt-restarted'));close();changed('engine');render();toast('عاد المختبر إلى البداية. سجل المساعدة السابق محفوظ.');};};
$('#ml-helper').onclick=()=>{const a=active();if(!a.training){learningOriginalHelper();return;}const source=a.helper?lab(a.sourceOriginal):a;if(!source)return;const existing=state.labs.filter(x=>x.helper&&x.sourceOriginal===source.id&&x.training?.step===source.training.step).sort((a,b)=>(b.helperUseOrder||0)-(a.helperUseOrder||0))[0];if(existing)activate(existing.id);else cloneLab(source.id,true);};
$('#ml-verify').onclick=()=>{
 const a=active(),t=a.training;if(!t){learningOriginalVerify();return;}capture();let r=B.learning.check(t.exercise,t.step,false);
 if(r.ok&&t.step.endsWith('check')){const what=t.step==='vlan-check'?'vlan':'brief',missing=L.targets(t.step).find(id=>t.observed?.[id+'|'+what]?.revision!==a.revision);if(missing)r={ok:false,key:t.step,issues:[{device:missing,port:null,field:'دليل العرض',actual:'لم يُنفذ أمر العرض على الحالة الحالية',show:what==='vlan'?'show vlan brief':'show ip interface brief'}]};}
 t.checks[t.step]={ok:r.ok,at:new Date().toISOString()};
 root.dispatchEvent(new CustomEvent('labs:configuration-check',{detail:{step:t.step,ok:r.ok}}));
 if(!r.ok){learningIssue=r.issues[0];diagnosticRevision=a.revision;learningKey=a.id+'|'+t.step;t.checks[t.step]={ok:false,at:new Date().toISOString()};$('#ml-diagnosis').hidden=false;$('#ml-diagnostic-message').textContent='يوجد عدم تطابق في '+learningIssue.device+'؛ استخدم أمر العرض لتحديده ثم صححه.';$('#ml-diagnostic-output').textContent='';$('#ml-diagnostic-guide').textContent='';a.verdict='لم يكتمل المطلوب في هذه الخطوة. تقدر تراجعها أو تنتقل لغيرها.';}
 else{B.learning.clearFocus();learningIssue=null;$('#ml-diagnosis').hidden=true;a.verdict='الإعداد مطابق للمطلوب في هذه الخطوة.';t.evidence.push({type:'configuration-check',step:t.step,at:new Date().toISOString(),assistanceCount:(a.data.assistance?.events||[]).filter(x=>x[0]===a.data.assistance.attempt).length,copied:!!a.copied});if(t.assessment){assessmentQuestion(a);}else t.completed=practiceSequence(t).every(k=>t.checks[k]?.ok&&B.learning.check(t.exercise,k,false).ok);}
 changed('view');updateContext();if(!r.ok){learningKey=a.id+'|'+t.step;$('#ml-diagnosis').hidden=false;}
};
$('#ml-locate').onclick=()=>{if(!learningIssue)return;const issue=learningIssue,lines=B.learning.output(issue),pre=$('#ml-diagnostic-output');B.learning.recordDiagnostic(issue,()=>{
 pre.replaceChildren();let highlighted=0;const indices=L.highlight(lines,issue,issue.show==='show startup-config'?B.learning.output({...issue,show:'show running-config'}):[]);
 lines.forEach((line,i)=>{const el=document.createElement('span');el.textContent=line+'\n';if(indices.includes(i)){el.className='ml-error-line';highlighted++;}pre.append(el);});
 if(!highlighted){const missing=document.createElement('span');missing.className='ml-error-line';missing.dir='rtl';missing.textContent='لم يظهر السطر المطلوب: '+issue.field+' '+(issue.port||'')+'\n';pre.append(missing);}
 $('#ml-diagnostic-guide').textContent='الأمر: '+issue.show+' — اقرأ الجزء المضاء وقارنه بالمتطلبات. يبقى اختيار التصحيح وتنفيذه عليك.';B.learning.focus(issue);});changed('help');};
$('#ml-next-step').onclick=()=>{const t=active().training;if(!t||!t.checks[t.step]?.ok)return;const check=B.learning.check(t.exercise,t.step);if(!check.ok){$('#ml-verify').click();return;}const seq=practiceSequence(t),n=seq.indexOf(t.step)+1;if(seq.includes(t.step)){if(n<seq.length)t.step=seq[n];}else{t.step=seq.find(k=>L.order.indexOf(k)>L.order.indexOf(t.step))||seq[0];}active().verdict='';changed();updateContext();};
