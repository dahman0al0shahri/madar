function assessmentQuestion(a){const t=a.training;if(t.assessment.answered===true){finishAssessment(a);return;}
 const questions={create:['هل اسم VLAN وحده يربط منفذ الحاسب بها؟',['نعم','لا، يحتاج تعيين المنفذ'],1],management:['ما وظيفة ip default-gateway على Switch هنا؟',['بوابة حركة الإدارة إلى شبكة أخرى','تفعيل التوجيه بين جميع VLANs'],0],parking:['لماذا نستبعد منافذ الوصلات من shutdown؟',['حتى لا نقطع المسارات المستخدمة','لأن shutdown يغيّر عنوان IP'],0],access:['ما الذي يحدد شبكة الحاسب المتصل بمنفذ access؟',['اسم الحاسب','تعيين VLAN على منفذ Switch'],1],'vlan-check':['هل رؤية اسم VLAN وحده تثبت صحة ربط الحاسب؟',['لا؛ أفحص المنفذ أيضًا','نعم'],0],trunk:['ماذا يحدث إذا حُذفت شبكة القسم من allowed؟',['تُمنع حركة هذه VLAN على الوصلة','تتغير عناوين الحواسيب'],0],save:['هل تعديل running-config بعد الحفظ يحدّث startup-config تلقائيًا؟',['لا؛ يلزم حفظ جديد','نعم'],0],parent:['هل no shutdown وحده يثبت نجاح الاتصال بين VLANs؟',['نعم','لا؛ بقية إعدادات المسار مهمة'],1],subinterfaces:['إذا اختلف رقم الواجهة الفرعية عن رقم VLAN، ما الذي يحدد الشبكة؟',['رقم encapsulation dot1q','رقم الواجهة الفرعية وحده'],0],'router-check':['هل up/up يثبت أن عنوان البوابة صحيح؟',['نعم','لا؛ يجب فحص العنوان أيضًا'],1]};
 const [question,choices,answer]=questions[t.step];modal('فسّر نتيجة تنفيذك',`<p>${esc(question)}</p>${choices.map((c,i)=>`<button data-assessment-answer="${i}">${esc(c)}</button>`).join('')}`);body.querySelectorAll('[data-assessment-answer]').forEach(b=>b.onclick=()=>{const correct=+b.dataset.assessmentAnswer===answer;t.evidence.push({type:'interpretation',question,answer:choices[+b.dataset.assessmentAnswer],correct,at:new Date().toISOString()});t.assessment.answered=correct;if(!correct){t.assessment.interpretationRetried=true;active().verdict='الإعداد صحيح، لكن التفسير يحتاج مراجعة. افتح المساعدة ثم جرّب تقييمًا جديدًا.';close();changed();updateContext();}else{close();finishAssessment(a);}});
