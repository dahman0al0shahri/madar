function finishAssessment(a){const t=a.training,as=t.assessment;if(as.finished)return;const helped=as.helpUsed||a.copied||(a.data.assistance?.events||[]).some(e=>e[0]===a.data.assistance.attempt);as.finished=true;const result={id:as.id,step:t.step,seed:t.exercise.seed,at:new Date().toISOString(),assisted:!!helped,kind:as.kind,repeated:!!as.repeated||!!as.interpretationRetried,configuration:true,interpretation:true};t.assessments.push(result);const source=lab(as.source);if(source){source.learningResults??=[];source.learningResults.push(clone(result));if(source.training)source.training.assessments.push(clone(result));source.reviewQueue??={};if(!helped&&!as.repeated&&!as.interpretationRetried&&as.kind!=='retention')source.reviewQueue[t.step]={at:source.reviewQueue[t.step]?.at||Date.now()+24*60*60*1000,step:t.step,seed:t.exercise.seed};if(!helped&&!as.repeated&&!as.interpretationRetried&&as.kind==='retention')delete source.reviewQueue[t.step];source.reviewDue=Object.values(source.reviewQueue).sort((a,b)=>a.at-b.at)[0]||null;}
 a.verdict=(as.repeated||as.interpretationRetried)?'نجحت إعادة المحاولة نفسها؛ افتح تقييمًا بقيم جديدة لقياس الاستقلال.':helped?'نجح التنفيذ والتفسير بمساعدة؛ جرّب نسخة جديدة دونها.':'نجح التنفيذ والتفسير دون مساعدة مسجلة في هذه المحاولة. هذا دليل لهذه المهمة فقط، وليس حكمًا على المنهج كله.';changed();updateContext();}
function startAssessment(source,kind,step){if(B.busy()){toast('أكمل توصيل الكابل أولًا.');return;}capture();const previous=clone(active().data);const sourceSeed=source.training?.exercise.seed||0,seed=L.nextSeed([sourceSeed,source.reviewDue?.seed,source.learningResults?.at(-1)?.seed],crypto.getRandomValues(new Uint32Array(1))[0]),e=L.make(seed),data=B.learning.fresh(e);const target=step||source.training?.step||'create';
 // Provide only prerequisites, never the target's answer. The student performs the target.
 B.learning.prerequisites(e,target);const prepared=B.capture();loading=true;B.restore(previous);loading=false;const n=makeLab(uid(),kind==='retention'?'مراجعة الاحتفاظ':'إعادة تقييم مستقلة','scratch',prepared);n.course=source.course||state.course;n.training=training(e,prepared);n.training.step=target;n.training.assessment={id:uid(),target,source:source.id,kind,startedAt:Date.now(),helpUsed:false,answered:null,finished:false};n.sourceOriginal=source.id;state.labs.push(n);activate(n.id);close();}
$('#ml-retests').onclick=()=>{capture();const a=active(),source=a.helper?(lab(a.sourceOriginal)||a):a,t=source?.training;modal('إعادة تقييم ومراجعات',`<p>تقييم بإعدادات مختلفة، ثم سؤال يطلب تفسير التنفيذ. مرور الوقت وحده لا يسجل احتفاظًا.</p><label>الخطوة<select id="ml-assessment-step">${L.order.map(k=>`<option value="${k}" ${k===t?.step?'selected':''}>${esc(L.titles[k])}</option>`).join('')}</select></label><button id="ml-start-assessment">ابدأ تقييمًا بقيم جديدة</button><p>${source?.reviewDue?'مراجعة مقترحة بعد: '+new Date(source.reviewDue.at).toLocaleString('ar-SA',{timeZone:'Asia/Riyadh'}):'بعد نجاح مستقل هنا، تتاح مراجعة لاحقة بعد 24 ساعة؛ هذا توقيت تدريبي قابل للمراجعة، وليس معيار إتقان.'}</p><p>مراجعات مجدولة: ${Object.keys(source?.reviewQueue||{}).length}</p><button id="ml-start-retention" ${!source?.reviewDue||Date.now()<source.reviewDue.at?'disabled':''}>ابدأ مراجعة الاحتفاظ المستحقة</button><ul>${(source?.learningResults||[]).map(r=>`<li>${esc(L.titles[r.step])} — ${r.assisted?'بمساعدة':r.repeated?'إعادة المحاولة نفسها':'دون مساعدة مسجلة'} — ${r.kind==='retention'?'مراجعة لاحقة':'إعادة تقييم'} — ${esc(new Date(r.at).toLocaleString('ar-SA',{timeZone:'Asia/Riyadh'}))}</li>`).join('')}</ul>`);$('#ml-start-assessment').onclick=()=>startAssessment(source,'independent',$('#ml-assessment-step').value);$('#ml-start-retention').onclick=()=>{if(source?.reviewDue&&Date.now()>=source.reviewDue.at)startAssessment(source,'retention',source.reviewDue.step);};};
