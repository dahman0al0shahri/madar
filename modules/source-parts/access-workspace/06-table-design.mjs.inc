function design(){const t=s.tables[s.active];if(!t)return dataGrid();const f=t.fields.find(f=>f.name===s.selectedField);return `<div class="al-scroll" tabindex="0" aria-label="شبكة تصميم الحقول"><table class="al-design"><thead><tr><th>تحديد</th><th>اسم الحقل</th><th>نوع البيانات Data Type</th></tr></thead><tbody>${t.fields.map(f=>`<tr class="${f.name===s.selectedField?'al-selected':''}"><td><button data-select="${esc(f.name)}" aria-label="تحديد حقل ${esc(f.name)}">${f.primary?'🔑':'◂'}</button></td><th>${esc(f.name)}</th><td><select data-type="${esc(f.name)}" aria-label="نوع بيانات ${esc(f.name)}">${TYPES.map(v=>`<option ${f.type===v?'selected':''}>${v}</option>`).join('')}</select></td></tr>`).join('')}</tbody></table></div><button data-command="addField">+ إضافة حقل جديد</button>${f?`<section class="al-properties"><h4>خصائص الحقل: ${esc(f.name)}</h4><div class="al-property-grid">${[['caption','التسمية التوضيحية Caption'],['format','التنسيق Format'],['rule','قاعدة التحقق Validation Rule'],['validationText','رسالة التحقق Validation Text'],['default','القيمة الافتراضية Default Value'],['mask','قناع الإدخال Input Mask'],['size','حجم الحقل Field Size'],...(f.type==='ترقيم تلقائي'?[['newValues','القيم الجديدة New Values']]:[])].map(([k,label])=>`<label>${label}${k==='format'||k==='newValues'?`<select data-property="${k}">${(k==='format'?['','عملة','قياسي','نسبة مئوية']:['زيادة','عشوائي']).map(v=>`<option ${v===f[k]?'selected':''}>${esc(v)}</option>`).join('')}</select>`:`<input data-property="${k}" value="${esc(f[k]||'')}" maxlength="120" dir="auto">`}</label>`).join('')}</div></section>`:''}`;}
 