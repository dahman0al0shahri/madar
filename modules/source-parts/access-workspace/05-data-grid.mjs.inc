function dataGrid(){const t=s.tables[s.active];if(!t)return '<div class="al-empty"><h3>ابدأ بجدول جديد</h3><p>من تبويب إنشاء اختر جدول أو تصميم جدول.</p></div>';const fields=[...t.fields.filter(f=>t.frozen.includes(f.name)),...t.fields.filter(f=>!t.frozen.includes(f.name))].filter(f=>!t.hidden.includes(f.name));return `<div class="al-scroll" tabindex="0" aria-label="ورقة البيانات؛ مرّر الجدول أفقيًا عند الحاجة"><table class="al-data"><thead><tr><th>السجل</th>${fields.map(f=>`<th class="${t.frozen.includes(f.name)?'al-frozen':''}"><button data-select="${esc(f.name)}" aria-pressed="${s.selectedField===f.name}">${f.primary?'🔑 ':''}${esc(f.caption||f.name)}</button></th>`).join('')}<th><button data-command="addField">انقر للإضافة +</button></th></tr></thead><tbody>${visibleRows(s).map(r=>`<tr class="${r.المعرف===s.selectedRow?'al-selected':''}"><th><button data-row="${r.المعرف}" aria-label="تحديد سجل ${esc(r.الاسم||r.المعرف)}">${esc(r.المعرف??'•')}</button></th>${fields.map(f=>`<td class="${t.frozen.includes(f.name)?'al-frozen':''}">${f.type==='ترقيم تلقائي'?`<span>${esc(r[f.name])}</span>`:`<input aria-label="${esc(f.name+' سجل '+r.المعرف)}" data-cell="${esc(f.name)}" data-id="${r.المعرف}" value="${esc(r[f.name])}" inputmode="${['رقم','عملة'].includes(f.type)?'decimal':'text'}">`}${f.format==='عملة'?'<small>ر.س.</small>':''}</td>`).join('')}<td></td></tr>`).join('')}</tbody></table></div><div class="al-recordbar"><button data-command="addRecord">* سجل جديد</button><span>${ar(visibleRows(s).length)} ظاهر من ${ar(t.rows.length)} سجلًا ${s.filter?'· تصفية نشطة':''}</span>${s.found!==null?`<span>نتيجة البحث: السجل ${ar(s.found)}</span>`:''}</div>`;}
 