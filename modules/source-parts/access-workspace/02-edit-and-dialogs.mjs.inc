function bindEdit(el,action,values){let started=false;const commit=()=>{try{const next=reduce(s,action,values());if(JSON.stringify(next)===JSON.stringify(s))return;if(!started){history.push(JSON.stringify(s));history=history.slice(-40);future=[];started=true;}s=next;msg='';persist();const f=host.querySelector('[data-feedback]');if(f)f.textContent='';}catch(e){msg=e.message;const f=host.querySelector('[data-feedback]');if(f)f.textContent=msg;}};el.oninput=commit;el.onchange=commit;el.onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();commit();render();}};}
 const act=(action,v={})=>{try{const next=reduce(s,action,v);history.push(JSON.stringify(s));history=history.slice(-40);future=[];s=next;msg='';persist();render();return true;}catch(e){msg=e.message;const el=host.querySelector('[data-feedback]');if(el){el.textContent=msg;el.focus();}return false;}};
 const input=(name,label,value='',type='text',options)=>`<label>${esc(label)}${options?`<select name="${name}">${options.map(x=>`<option ${x===value?'selected':''}>${esc(x)}</option>`).join('')}</select>`:type==='checkbox'?`<input name="${name}" type="checkbox" ${value?'checked':''}>`:`<input name="${name}" type="${type}" value="${esc(value)}" maxlength="120" autocomplete="off">`}</label>`;
 function showDialog(title,body,submit){lastFocus=document.activeElement;dialog=document.createElement('dialog');dialog.className='al-dialog';dialog.setAttribute('aria-labelledby','al-dialog-title');dialog.innerHTML=`<form><header><h3 id="al-dialog-title">${esc(title)}</h3><button type="button" data-cancel aria-label="إغلاق الحوار">×</button></header><div class="al-dialog-body">${body}</div><p data-error role="alert"></p><footer><button type="submit" class="primary">تطبيق</button><button type="button" data-cancel>إلغاء</button></footer></form>`;document.body.append(dialog);dialog.querySelectorAll('[data-cancel]').forEach(b=>b.onclick=()=>dialog.close());dialog.addEventListener('close',()=>{dialog.remove();dialog=null;lastFocus?.isConnected&&lastFocus.focus();},{once:true});dialog.querySelector('form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.currentTarget),v=Object.fromEntries(f);for(const el of dialog.querySelectorAll('[type=checkbox]'))v[el.name]=el.checked;try{if(submit(v)!==false)dialog?.close();else dialog.querySelector('[data-error]').textContent=msg;}catch(e){dialog.querySelector('[data-error]').textContent=e.message;}};dialog.showModal();}
 const confirmAction=(title,text,action,v)=>showDialog(title,`<p>${esc(text)}</p><p>التراجع متاح هنا للتعلّم؛ الحذف في Access الحقيقي قد يكون نهائيًا.</p>`,()=>act(action,v));
 