function render(){if(!host.isConnected){dialog?.close();return;}const checks=s.check?.rows;const current=task.steps[Math.min(step,task.steps.length-1)];host.innerHTML=`<section class="al" aria-label="محاكي الأكسس"><header class="al-heading"><div><span class="al-kicker">ACCESS LAB / مختبر الأكسس</span><h3>${esc(lesson.id==='access-u10-04'?'إنشاء استعلامات التحديد بطريقة عرض التصميم':lesson.title)}</h3></div><span class="al-badge">تعلّم وتطبيق</span></header><div class="al-mission"><b>مهمتك</b><p>${esc(task.mission)}</p><div class="al-tools"><button data-mode="guided" aria-pressed="${mode==='guided'}">تدريب موجّه</button><button data-mode="independent" aria-pressed="${mode==='independent'}">تطبيق مستقل</button></div>${mode==='guided'?`<div class="al-guide"><span>الخطوة ${ar(step+1)} من ${ar(task.steps.length)}</span><p>${esc(current.hint)}</p><details><summary data-hint>لماذا هذه الخطوة؟</summary><p>${esc(current.why)}</p></details><div class="al-tools"><button data-step="-1" ${step===0?'disabled':''}>السابقة</button><button data-step="1" ${step===task.steps.length-1?'disabled':''}>الخطوة التالية</button></div><small>التنقل بين الإرشادات لا ينفذ الأوامر ولا يعد إنجازًا.</small></div>`:'<p>نفّذ المهمة بنفسك. يمكنك الرجوع للإرشاد في أي وقت؛ تُحفظ طريقة التدريب مع عملك.</p>'}</div><div class="al-save"><span data-save role="status">${esc(saveMsg)}</span><div class="al-tools"><button data-save-now>حفظ الآن</button><button data-download>تنزيل نسختي</button>${window.MADAR_ACCOUNT.user?'<button data-reload>تحميل نسخة الحساب</button>':''}</div></div><div class="al-window"><div class="al-titlebar"><b>A</b><span>${esc(s.name)}</span><div class="al-tools"><button data-undo ${!history.length?'disabled':''} aria-label="تراجع عن آخر تعديل">↶ تراجع</button><button data-redo ${!future.length?'disabled':''}>↷ إعادة</button></div></div><nav class="al-ribbon-tabs" aria-label="تبويبات أوامر الأكسس">${Object.keys(menus).map(tab=>`<button data-tab="${tab}" aria-pressed="${s.tab===tab}">${tab}</button>`).join('')}</nav><div class="al-ribbon">${(menus[s.tab]||menus['الصفحة الرئيسية']).map(([c,label])=>`<button data-command="${c}">${label}</button>`).join('')}</div><div class="al-database"><aside class="al-navigation"><h4>كافة كائنات Access</h4><button data-command="nav">خيارات جزء التنقل</button>${s.settings.navigation?'<small>التجميع: '+esc(s.settings.navigation)+'</small>':''}<details open><summary>الجداول (${Object.keys(s.tables).length})</summary>${Object.entries(s.tables).map(([name,t])=>`<button data-open="${esc(name)}" aria-pressed="${s.active===name}">${t.linked?'↗':'▦'} ${esc(name)}</button>`).join('')}</details><details open><summary>الاستعلامات (${Object.keys(s.queries).length})</summary>${Object.keys(s.queries).map(n=>`<button data-qopen="${esc(n)}">◇ ${esc(n)}</button>`).join('')}</details>${Object.keys(s.forms).length?'<p>النماذج: '+Object.keys(s.forms).map(esc).join('، ')+'</p>':''}</aside><section class="al-workspace"><div class="al-objectbar"><strong>${esc(s.active||'قاعدة جديدة')}</strong><span>${({data:'ورقة البيانات',design:'عرض التصميم',query:'تصميم الاستعلام',results:'نتائج الاستعلام',relations:'العلاقات',files:'الملفات',forms:'النماذج',print:'معاينة'})[s.view]}</span></div><div data-feedback class="al-feedback" role="status" tabindex="-1">${esc(msg)}</div>${workspace()}</section></div></div><section class="al-check"><div class="al-tools"><button class="primary" data-check>تحقق من عملي</button><button data-reset>ابدأ من جديد</button></div>${checks?`<h4>${checks.every(x=>x.ok)?'اكتملت المهمة في المحاكي':'راجع النقاط التالية ثم جرّب مرة أخرى'}</h4><ul>${checks.map(g=>`<li class="${g.ok?'al-ok':'al-fix'}"><b>${g.ok?'✓':'○'} ${esc(g.label)}</b>${!g.ok?'<p>'+esc(g.why)+'</p>':''}</li>`).join('')}</ul><p>هذه نتيجة تنفيذ داخل المحاكي ${s.check.mode==='guided'?'بإرشاد':'في وضع مستقل'}، وليست حكمًا بإتقان الدرس. جرّب لاحقًا على Microsoft Access.</p>`:'<p>التقييم يفحص البيانات والبنية الناتجة، لا مجرد الضغط على الأزرار.</p>'}</section><details class="al-limits"><summary>ما الذي يطبقه هذا التدريب؟</summary><p>الجداول والسجلات والخصائص والاستعلامات تعمل على بيانات تدريبية صغيرة داخل مدار. أسماء الأوامر مأخوذة من الدرس؛ الواجهة مصممة للمس والقراءة. لا يشغل المحاكي ملفات Access أو VBA ولا يتصل بمصادر خارجية حقيقية.</p>${task.note?'<p>'+esc(task.note)+'</p>':''}<p>يثبت إدخال الخلية عند Enter أو مغادرتها؛ يُحفظ آخر 40 تعديلًا للتراجع. ${window.MADAR_ACCOUNT.user?'الحفظ مرتبط بحسابك.':'حفظ الضيف في هذا المتصفح فقط.'}</p><a href="#about/report/lesson/${lesson.id}">بلّغ عن مشكلة في هذا التدريب</a></details></section>`;
 host.querySelectorAll('[data-command]').forEach(b=>b.onclick=()=>command(b.dataset.command));
 host.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{s.tab=b.dataset.tab;persist();render();});
 const tabChoice=document.createElement('label');tabChoice.className='al-tab-choice';tabChoice.innerHTML='تبويب الأوامر<select aria-label="تبويب الأوامر">'+Object.keys(menus).map(t=>`<option ${s.tab===t?'selected':''}>${t}</option>`).join('')+'</select>';host.querySelector('.al-ribbon-tabs').before(tabChoice);tabChoice.querySelector('select').onchange=e=>{s.tab=e.target.value;persist();render();};
 host.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>act('open',{name:b.dataset.open}));
 host.querySelectorAll('[data-qopen]').forEach(b=>b.onclick=()=>act('queryOpen',{name:b.dataset.qopen}));
 host.querySelectorAll('[data-select]').forEach(b=>b.onclick=()=>act('selectField',{name:b.dataset.select}));
 host.querySelectorAll('[data-row]').forEach(b=>b.onclick=()=>act('selectRow',{id:b.dataset.row}));
 host.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>act('view',{view:b.dataset.view}));
 host.querySelectorAll('[data-cell]').forEach(el=>bindEdit(el,'cell',()=>({id:el.dataset.id,field:el.dataset.cell,value:el.value})));
 host.querySelectorAll('[data-type]').forEach(el=>el.onchange=()=>{s.selectedField=el.dataset.type;act('property',{key:'type',value:el.value});});
 host.querySelectorAll('[data-property]').forEach(el=>bindEdit(el,'property',()=>({key:el.dataset.property,value:el.value})));
 host.querySelectorAll('[data-qfield]').forEach(b=>b.onclick=()=>act('queryField',{field:b.dataset.qfield}));
 host.querySelectorAll('[data-qremove]').forEach(b=>b.onclick=()=>act('queryRemoveField',{field:b.dataset.qremove}));
 host.querySelectorAll('[data-criteria]').forEach(el=>bindEdit(el,'criteria',()=>({field:el.dataset.criteria,value:el.value})));
 host.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;persist();render();});
 host.querySelectorAll('[data-step]').forEach(b=>b.onclick=()=>{step=Math.max(0,Math.min(task.steps.length-1,step+Number(b.dataset.step)));persist();render();});
 host.querySelector('[data-hint]')?.addEventListener('click',()=>{hints++;persist();});
 host.querySelector('[data-undo]').onclick=()=>{if(!history.length)return;future.push(JSON.stringify(s));s=JSON.parse(history.pop());msg='تراجعت عن آخر تعديل.';persist();render();};
 host.querySelector('[data-redo]').onclick=()=>{if(!future.length)return;history.push(JSON.stringify(s));s=JSON.parse(future.pop());msg='أعيد التعديل.';persist();render();};
 host.querySelector('[data-save-now]').onclick=()=>handle.save();host.querySelector('[data-download]').onclick=()=>handle.download();
 host.querySelector('[data-reload]')?.addEventListener('click',async()=>{if(await handle.reload()){const d=handle.snapshot;s=d?JSON.parse(d.current):initial(task);history=d?.history||[];future=d?.future||[];mode=d?.guide?.mode||'guided';step=d?.guide?.step||0;render();}});
 host.querySelector('[data-reset]').onclick=()=>showDialog('بدء التدريب من جديد','<p>ستعاد بيانات التدريب إلى البداية. يمكنك التراجع لاستعادة وضعك السابق.</p>',()=>{history.push(JSON.stringify(s));history=history.slice(-40);future=[];s=initial(task);step=0;persist();render();});
 host.querySelector('[data-check]').onclick=()=>{const rows=grade(s,task);s.check={rows,mode,hints,at:new Date().toISOString()};persist();host.dispatchEvent(new CustomEvent('madar-training',{bubbles:true,detail:{result:rows.every(g=>g.ok),mode,hints,lab:true}}));render();host.querySelector('.al-check').scrollIntoView({block:'nearest',behavior:'smooth'});};
 }
 handle.listen(t=>{saveMsg=t;const el=host.querySelector('[data-save]');if(el)el.textContent=t;});render();
 window.MADAR_ACTIVITY?.emit('training_open',{page:'access',lesson:lesson.id});
 // Remove modal on route/mode replacement, so it cannot act on another lesson.
 const observer=new MutationObserver(()=>{if(!host.isConnected){dialog?.close();observer.disconnect();}});observer.observe(document.querySelector('#main'),{childList:true,subtree:true});
 };
