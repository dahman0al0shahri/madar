function wizard(){let source='الموظفون',selected=[];showDialog('معالج الاستعلامات البسيطة',input('source','جداول / استعلامات',source,'text',Object.keys(s.tables))+'<div data-wizard></div>'+input('name','عنوان الاستعلام')+'<p>حدد الحقول ثم اضغط تطبيق لعرض النتائج. إنشاء شروط مخصصة متاح من تصميم الاستعلام.</p>',v=>act('wizard',{...v,fields:selected}));const panel=dialog.querySelector('[data-wizard]');function draw(){panel.innerHTML='<h4>الحقول المتاحة</h4><div class="al-tools">'+s.tables[source].fields.filter(f=>!selected.includes(f.name)).map(f=>`<button type="button" data-add="${esc(f.name)}">${esc(f.name)} ←</button>`).join('')+'</div><h4>الحقول المحددة</h4><div class="al-tools">'+selected.map(f=>`<button type="button" data-remove="${esc(f)}">${esc(f)} ×</button>`).join('')+'</div>';panel.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{selected.push(b.dataset.add);draw();});panel.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{selected=selected.filter(x=>x!==b.dataset.remove);draw();});}dialog.querySelector('[name=source]').onchange=e=>{source=e.target.value;selected=[];draw();};draw();}
 