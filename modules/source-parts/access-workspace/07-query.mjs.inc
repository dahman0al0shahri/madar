function query(){const q=s.query,t=s.tables[q.source];return `<section class="al-query-source"><h4>${esc(q.source)} · حقول المصدر</h4><p>انقر الحقل لإضافته إلى شبكة التصميم.</p><div class="al-tools">${(t?.fields||[]).map(f=>`<button data-qfield="${esc(f.name)}" ${q.fields.includes(f.name)?'disabled':''}>+ ${esc(f.name)}</button>`).join('')}</div></section><div class="al-scroll" tabindex="0" aria-label="شبكة تصميم الاستعلام"><table class="al-query"><tbody><tr><th>الحقل Field</th>${q.fields.map(f=>`<td>${esc(f)} <button data-qremove="${esc(f)}" aria-label="إزالة ${esc(f)} من الاستعلام">×</button></td>`).join('')}</tr><tr><th>الجدول Table</th>${q.fields.map(()=>`<td>${esc(q.source)}</td>`).join('')}</tr><tr><th>المعايير Criteria</th>${q.fields.map(f=>`<td><input data-criteria="${esc(f)}" aria-label="معايير ${esc(f)}" value="${esc(q.criteria[f]||'')}" dir="auto"></td>`).join('')}</tr>${q.type==='إلحاق'?`<tr><th>إلحاق بـ Append To</th>${q.fields.map(f=>`<td>${esc(s.tables[q.target]?.fields.some(x=>x.name===f)?f:'حقل غير مطابق')}</td>`).join('')}</tr>`:''}</tbody></table></div><p class="al-query-note">النوع: ${esc(q.type)} ${q.target?'· الهدف: '+esc(q.target):''} · ${q.fields.length?ar(q.fields.length)+' حقول':'أضف حقولًا من البطاقة أعلاه'}</p>`;}
 function resultTable(rows){if(!rows?.length)return '<p class="al-empty">لا توجد نتائج مطابقة.</p>';const keys=Object.keys(rows[0]);return '<div class="al-scroll" tabindex="0" aria-label="نتائج الاستعلام"><table><thead><tr>'+keys.map(k=>'<th>'+esc(k)+'</th>').join('')+'</tr></thead><tbody>'+rows.map(r=>'<tr>'+keys.map(k=>'<td>'+esc(r[k])+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>';}
 