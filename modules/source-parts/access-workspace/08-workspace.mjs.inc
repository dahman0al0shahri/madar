function workspace(){if(s.view==='design')return design();if(s.view==='query')return query();if(s.view==='results')return `<h3>نتائج الاستعلام · ${ar(s.results?.length||0)} سجلًا</h3><button data-view="query">العودة إلى تصميم الاستعلام</button>${resultTable(s.results)}`;if(s.view==='relations')return `<h3>العلاقات</h3>${s.relationships.map(r=>`<div class="al-relation"><strong>${esc(r.from)}<small>${esc(r.fromField)}</small></strong><b>1 ⟷ ∞</b><strong>${esc(r.to)}<small>${esc(r.toField)}</small></strong></div><p>${r.enforce?'✓ التكامل المرجعي مفروض':'التكامل المرجعي غير مفروض'}</p>`).join('')}`;if(s.view==='files')return `<h3>ناتج العملية في التدريب</h3><p class="small muted">تمثيلات تعليمية للملفات؛ ليست ملفات Microsoft فعلية.</p>${s.settings.compacted?'<p>ضغط تجريبي:12MB ←9MB. النسخة الاحتياطية مهمة قبل الصيانة.</p>':''}${s.settings.encrypted?'<p>✓ اكتمل إعداد الحماية التجريبي. لم تُحفظ كلمة المرور.</p>':''}<div class="al-file-list">${s.files.map(f=>`<article><b>${esc(f.name)}</b><small>${esc(f.kind)}</small></article>`).join('')}${s.exports.map(f=>`<article><b>${esc(f.name)} · ${esc(f.format)}</b><small>${ar(f.rows.length)} سجلًا · ${f.saved?'خطوات التصدير محفوظة':'لم تحفظ الخطوات'}</small></article>`).join('')}</div>`;if(s.view==='forms')return `<h3>النماذج</h3>${Object.entries(s.forms).map(([n,f])=>`<article class="al-form-preview"><h4>${esc(n)}</h4><p>${esc(f.type)} · ${esc(f.source)}</p>${f.source?resultTable(s.tables[f.source]?.rows):'<label>حقل نموذج تجريبي<input disabled placeholder="مساحة تصميم النموذج"></label>'}</article>`).join('')}`;if(s.view==='print')return `<h3>معاينة الطباعة</h3><p>${esc(s.settings.print.paper)} · ${esc(s.settings.print.orientation)} · معاينة تعليمية</p><div class="al-paper">${resultTable(s.tables[s.active]?.rows)}</div>`;return dataGrid();}
 