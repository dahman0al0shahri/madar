function edit(k,initial){const td=el.querySelector(`[data-cell="${k}"]`);td.innerHTML=`<input class="cell-editor" aria-label="تحرير ${k}" dir="ltr">`;const input=td.firstElementChild;input.value=initial??cells[k]??'';input.focus();if(initial===undefined)input.select();input.onclick=e=>e.stopPropagation();input.onkeydown=e=>{e.stopPropagation();if(e.key==='Enter'||e.key==='Tab'){e.preventDefault();write(k,input.value);}if(e.key==='Escape')render();};}
 function ribbon(){const extension=scenario?.ribbon(tab);if(extension)return extension;const group=(title,html)=>`<div class="sheet-group">${html}<small>${title}</small></div>`;if(tab==='home')return group('الحافظة',button('copy','نسخ')+button('paste','لصق')+button('paste-transpose','لصق خاص: تبديل الموضع'))+group('أنماط',button('cf','تنسيق شرطي')+button('style','أنماط الخلايا'))+group('رقم',button('format','تنسيق خلايا'))+group('تحرير',button('fill','تعبئة لأسفل'));if(tab==='insert')return '<p>أوامر إدراج الدرس تظهر عند تدريب الرموز.</p>';if(tab==='formulas')return (a.op==='CLOCK'?button('calculate','حساب الآن'):'')+group('مكتبة الدوال',button('function','إدراج دالة'))+group('تدقيق الصيغ',button('precedents','تتبع السابقات')+button('dependents','تتبع التوابع')+button('clear-trace','إزالة الأسهم'));if(tab==='data')return group('أدوات البيانات',button('validation','التحقق من صحة البيانات'));if(tab==='review')return group('تغييرات',button('protect',protect?'إلغاء حماية الورقة':'حماية ورقة')+button('changes','تعقب التغييرات: قبول/رفض'));if(tab==='developer')return group('عناصر التحكم',button('insert-control','إدراج')+button('control-format','تنسيق عنصر التحكم'));if(tab==='layout')return group('نسق',button('themes','ألوان')+button('fonts','خطوط'));return group('خيارات',button('options','خيارات'));
 }
 function dialog(title,body,ok,label='موافق'){el.querySelector('dialog')?.remove();const d=document.createElement('dialog');d.className='sheet-dialog';d.dir='rtl';d.setAttribute('aria-label',title);d.innerHTML=`<form method="dialog"><h4>${title}</h4>${body}<p class="dialog-error" role="alert"></p><footer><button type="submit">${label}</button><button type="button" data-cancel>إلغاء</button></footer></form>`;el.append(d);d.querySelector('[data-cancel]').onclick=()=>d.close();d.onclose=()=>{d.remove();if(!el.querySelector('dialog[open]'))el.querySelector('[aria-label="شريط الصيغة في التدريب"]')?.focus({preventScroll:true});};d.querySelector('form').onsubmit=e=>{e.preventDefault();try{const v=Object.fromEntries(new FormData(d.querySelector('form')));ok(v);d.close();}catch(e){d.querySelector('.dialog-error').textContent=e.message;}};d.showModal();}
 const input=(n,t,v,type='text')=>`<label>${t}<input name="${n}" type="${type}" value="${esc(v)}" ${type==='number'?'step="any"':''}></label>`;
 const select=(n,t,opts)=>`<label>${t}<select name="${n}">${opts.map(([v,l])=>`<option value="${v}">${l}</option>`).join('')}</select></label>`;
 const colors=[['red','تعبئة حمراء فاتحة مع نص أحمر داكن'],['blue','تعبئة زرقاء فاتحة'],['green','تعبئة خضراء فاتحة']];
 function fillDown(){if(scenario?.blocked())return;const keys=selected(),[c,r]=position(keys[0]);change(()=>{keys.slice(1).forEach(k=>{if(spills[k]||protect&&locked[k]!==false)return;const[x,y]=position(k),raw=cells[keys[0]]||'';let next=raw.startsWith('=')?shift(raw,x-c,y-r):raw;if(a.kind==='fill'&&a.customList){const index=a.customList.indexOf(raw);if(index>=0)next=a.customList[(index+y-r)%a.customList.length];}if(!validation[k]||allowed(next,validation[k]))cells[k]=next;});events.add('fill-'+selection);});}
 