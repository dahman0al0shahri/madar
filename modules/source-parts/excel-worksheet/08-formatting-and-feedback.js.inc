function cfDialog(){dialog('قاعدة تنسيق جديدة',`<p>تنسيق الخلايا التي تحتوي فقط · قيمة الخلية</p>${select('op','المقارنة',[['greater','أكبر من']])}${input('limit','القيمة',80,'number')}${select('color','تنسيق',colors)}`,v=>{if(!Number.isFinite(+v.limit))throw Error('أدخل حدًا رقميًا.');change(()=>rules.unshift({area:selection,limit:+v.limit,color:v.color}));});}
 function manage(){dialog('إدارة قواعد التنسيق الشرطي',`<p>تُفحص القواعد من الأعلى إلى الأسفل. المعروض: هذه الورقة</p>${rules.map((r,i)=>`<p>${i+1}. <bdi>${r.area}</bdi> أكبر من ${r.limit} · ${r.color==='blue'?'أزرق':'أحمر'}</p>`).join('')}${select('index','اختر القاعدة',rules.map((r,i)=>[i,`${i+1}: >${r.limit}`]))}${select('action','الإجراء',[['up','تحريك لأعلى'],['down','تحريك لأسفل'],['delete','حذف القاعدة'],['edit','تحرير القاعدة']])}${input('limit','حد المقارنة عند التحرير',80,'number')}`,v=>{const n=+v.index;change(()=>{if(v.action==='delete')rules.splice(n,1);if(v.action==='edit'&&rules[n])rules[n].limit=+v.limit;if(v.action==='up'&&n>0)[rules[n-1],rules[n]]=[rules[n],rules[n-1]];if(v.action==='down'&&n<rules.length-1)[rules[n+1],rules[n]]=[rules[n],rules[n+1]];});});}
 function functionDialog(){const name=spec?.[0].match(/^=(\w+)/)?.[1]||'IF';dialog('إدراج دالة · مكتبة الدوال',select('name','الدالة',['IF','AND','OR','NOT','ROUND','INT','SUM','COUNT','AVERAGE','MIN','MAX','SMALL','LARGE','COUNTIF','CONCATENATE','VLOOKUP','DATE','TIME','TODAY','NOW','COUNTIFS'].sort((x,y)=>x===name?-1:y===name?1:0).map(n=>[n,n])),v=>{const labels={TODAY:[],NOW:[],DATE:['Year — السنة','Month — الشهر','Day — اليوم'],TIME:['Hour — الساعة','Minute — الدقيقة','Second — الثانية'],COUNTIFS:['Criteria_range1 — النطاق الأول','Criteria1 — الشرط الأول','Criteria_range2 — النطاق الثاني','Criteria2 — الشرط الثاني'],IF:['Logical_test — الاختبار المنطقي','Value_if_true — عند التحقق','Value_if_false — عند عدم التحقق'],ROUND:['Number — الرقم','Num_digits — عدد المنازل'],VLOOKUP:['Lookup_value — قيمة البحث','Table_array — نطاق الجدول','Col_index_num — رقم العمود','Range_lookup — نوع المطابقة'],COUNTIF:['Range — النطاق','Criteria — الشرط'],SMALL:['Array — نطاق القيم','k — الرتبة'],LARGE:['Array — نطاق القيم','k — الرتبة'],NOT:['Logical — الشرط']}[v.name]||['الوسيط الأول','الوسيط الثاني (اختياري)','الوسيط الثالث (اختياري)'];dialog('وسيطات الدالة · '+v.name,labels.map((l,i)=>input('arg'+i,l,'')).join('')+'<p>اكتب النص بين علامتي تنصيص. يمكن إدخال مراجع خلايا أو دالة داخلية.</p>',args=>{const values=labels.map((_,i)=>args['arg'+i]);while(values.at(-1)==='')values.pop();write(active,'='+v.name+'('+values.join(',')+')');});},'التالي');}

 function formulaFeedback(){
 if(a.op==='CLOCK')return !/^=TODAY\(\)$/i.test(cells.C2||'')?'حدد C2 واكتب =TODAY().':!/^=NOW\(\)$/i.test(cells.D2||'')?'حدد D2 واكتب =NOW().':'اضغط تقديم ساعة المصدر دقيقة، وبعدها من صيغ اضغط حساب الآن.';
 if(a.op==='CROSSREF')return !/^=('?ورقة1'?)!\$?H\$?6$/i.test(cells.C2||'')?'في ورقة 2، حدد C2 واكتب =ورقة1!H6.':'افتح ورقة1 وغيّر H6 إلى 250، وبعدها ارجع لورقة 2.';
 if(a.op==='FIXEDLOOKUP')return 'راجع B2:B4: لازم كل خلية فيها VLOOKUP، والجدول ثابت كذا: $C$21:$D$25. ابدأ من B2 ثم تعبئة لأسفل.';
 if(a.op==='IF'&&['C2','C3','C4'].every(k=>(cells[k]||'').startsWith('=')&&value(cells,k)===(+cells['B'+k.slice(1)]>400?'عالية':'منخفضة'))&&!['D2','D3','D4'].every(k=>(cells[k]||'').includes('$F$2')))return 'خلصت جزء الشرط. باقي المرجع الثابت: في D2 اكتب =B2*$F$2، وحدد D2:D4 ثم تعبئة لأسفل.';
 if(['DATE','TIME'].includes(a.op)&&verifyFormula(cells,spec[0],a.op))return 'الصيغة صحيحة. باقي شكل العرض: حدد C2 وافتح تنسيق خلايا، واختر '+(a.op==='DATE'?'مخصص — تاريخ واكتب yyyy/MM/dd.':'مخصص — وقت واكتب hh:mm:ss.');
 const error=value(cells,'C2');if(typeof error==='string'&&error.startsWith('#'))return 'في الصيغة خطأ '+error+'. راجع الأقواس ومراجع الخلايا. استخدم أرقامًا إنجليزية، وحط النص بين علامتي تنصيص " ". تقدر تقارنها بمثال الدليل.';
 return a.guide?.retry;
 }

 