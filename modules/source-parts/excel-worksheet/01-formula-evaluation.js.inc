function evaluate(raw,cells,trail=[]){
 if(typeof raw!=='string'||!raw.startsWith('='))return raw===''||raw==null?'':raw[0]==="'"?raw.slice(1):Number.isFinite(Number(raw))?Number(raw):raw;
 let tokens=raw.slice(1).match(/'(?:[^']|'')+'!\$?[A-H]\$?\d+|[\u0600-\u06ffA-Za-z_][\u0600-\u06ffA-Za-z_0-9]*!\$?[A-H]\$?\d+|"(?:[^"]|"")*"|\$?[A-Za-z]+\$?\d+|[A-Za-z_]+|\d+(?:\.\d*)?|\.\d+|>=|<=|<>|[+\-*/^&=<>(),;:]/g)||[],i=0;
 if(tokens.join('').replace(/\s/g,'')!==raw.slice(1).replace(/\s/g,''))throw Error('#NAME?');
 const num=x=>{if(x===''||x===false)return 0;if(x===true)return 1;if(!Number.isFinite(Number(x)))throw Error('#VALUE!');return Number(x);};
 const val=raw=>{let a=raw.replace(/\$/g,'');const bang=a.lastIndexOf('!');if(bang>=0){let name=a.slice(0,bang).replace(/^'|'$/g,'').replace(/''/g,"'");a=name+'!'+a.slice(bang+1).toUpperCase();position(a.slice(a.lastIndexOf('!')+1));if(!Object.keys(cells).some(k=>k.startsWith(name+'!')))throw Error('#REF!');}else {a=a.toUpperCase();position(a);}if(trail.includes(a))throw Error('#CIRC!');let context=cells;if(bang>=0){const name=a.slice(0,a.lastIndexOf('!'));context={...cells};for(const k of Object.keys(context))if(/^[A-H]\d+$/.test(k))delete context[k];for(const [k,v]of Object.entries(cells))if(k.startsWith(name+'!'))context[k.slice(name.length+1)]=v;}return evaluate(cells[a]??'',context,[...trail,a]);};
 const take=t=>{if(tokens[i]!==t)throw Error('#VALUE!');i++;};
 const flat=a=>a.flat(Infinity),numbers=a=>flat(a).filter(x=>typeof x==='number');
 function call(name,args){const n=numbers(args),x=args[0],y=args[1];switch(name){
 case 'DATE':{let [year,month,day]=args.map(v=>Math.trunc(num(v)));if(year<0||year>=10000)throw Error('#NUM!');if(year<1900)year+=1900;const dt=new Date(0);dt.setUTCFullYear(year,month-1,day);dt.setUTCHours(0,0,0,0);if(!Number.isFinite(+dt)||dt.getUTCFullYear()<1900||dt.getUTCFullYear()>9999)throw Error('#NUM!');let serial=(+dt-Date.UTC(1899,11,31))/86400000;if(+dt>=Date.UTC(1900,2,1))serial++;if(year===1900&&month===2&&day===29)return 60;return serial;}
 case 'TIME':{const ns=args.map(v=>Math.trunc(num(v)));if(ns.some(v=>v>32767))throw Error('#NUM!');const total=ns[0]*3600+ns[1]*60+ns[2];if(total<0)throw Error('#NUM!');return (total%86400)/86400;}
 case 'TODAY':case 'NOW':{const serial=cells.__clock??((Date.now()+new Date().getTimezoneOffset()*-60000-Date.UTC(1899,11,30))/86400000);return name==='TODAY'?Math.floor(serial):serial;}
 case 'COUNTIFS':{if(args.length<2||args.length%2)throw Error('#VALUE!');const arrays=args.filter((_,i)=>i%2===0);if(arrays.some(a=>!Array.isArray(a)||!Array.isArray(a[0])||a.length!==arrays[0].length||a[0].length!==arrays[0][0].length))throw Error('#VALUE!');const lists=arrays.map(a=>a.flat());return lists[0].filter((_,i)=>lists.every((list,j)=>{const m=/^(>=|<=|<>|>|<|=)?(.*)$/.exec(String(args[j*2+1])),b=Number.isFinite(Number(m[2]))?Number(m[2]):m[2];const a=list[i]===''?0:list[i];return compare(typeof a==='string'?a.toLowerCase():a,typeof b==='string'?b.toLowerCase():b,m[1]||'=');})).length;}
 case 'IF':return x?args[1]:(args[2]??false);case 'AND':return flat(args).every(Boolean);case 'OR':return flat(args).some(Boolean);case 'NOT':return !x;
 case 'SUM':return n.reduce((s,v)=>s+v,0);case 'COUNT':return n.length;case 'AVERAGE':if(!n.length)throw Error('#DIV/0!');return n.reduce((s,v)=>s+v,0)/n.length;
 case 'MIN':return n.length?Math.min(...n):0;case 'MAX':return n.length?Math.max(...n):0;case 'INT':return Math.floor(num(x));case 'ROUND':return globalThis.MADAR_EXCEL_CORE.round(num(x),num(y));
 case 'SMALL':case 'LARGE':{const ns=numbers([x]).sort((a,b)=>name==='SMALL'?a-b:b-a);if(!Number.isInteger(y)||y<1||y>ns.length)throw Error('#NUM!');return ns[y-1];}
 case 'TRANSPOSE':if(!Array.isArray(x)||!Array.isArray(x[0]))throw Error('#VALUE!');return x[0].map((_,c)=>x.map(row=>row[c]));
 case 'CONCATENATE':return flat(args).join('');case 'COUNTIF':{const m=/^(>=|<=|<>|>|<|=)?(.*)$/.exec(String(y)),b=Number.isFinite(Number(m[2]))?Number(m[2]):m[2];return flat([x]).filter(a=>compare(a,b,m[1]||'=')).length;}
 case 'VLOOKUP':{if(args[3]!==false)throw Error('استخدم FALSE للمطابقة التامة في هذا التدريب');const rows=y;if(!Array.isArray(rows)||!Array.isArray(rows[0]))throw Error('#VALUE!');if(!Number.isInteger(args[2])||args[2]<1||args[2]>rows[0].length)throw Error('#REF!');const row=rows.find(r=>r[0]===x);if(!row)throw Error('#N/A');return row[args[2]-1];}
 default:throw Error('الدالة غير متاحة في هذا التدريب');}}
 function atom(){const t=tokens[i++];if(t===undefined)throw Error('#VALUE!');if(t==='-'||t==='+')return {unary:t,node:atom()};if(t==='('){const node=expression();take(')');return node;}if(t.startsWith('"'))return {literal:t.slice(1,-1).replace(/""/g,'"')};if(/^\d|^\./.test(t))return {literal:+t};if(/^(TRUE|FALSE)$/i.test(t))return {literal:t.toUpperCase()==='TRUE'};if(t.includes('!'))return {ref:t};if(/^\$?[A-H]\$?\d+$/i.test(t)){if(tokens[i]===':'){i++;return {area:t+':'+tokens[i++]};}return {ref:t};}take('(');const args=[];if(tokens[i]!==')'){args.push(expression());while(tokens[i]===','||tokens[i]===';'){i++;args.push(expression());}}take(')');return {func:t.toUpperCase(),args};}
 function chain(next,ops){let node=next();while(ops.includes(tokens[i])){const op=tokens[i++];node={op,left:node,right:next()};}return node;}
 function power(){return chain(atom,['^']);}function product(){return chain(power,['*','/']);}function sum(){return chain(product,['+','-','&']);}function expression(){return chain(sum,['>','<','>=','<=','=','<>']);}
 function run(n){if(Object.hasOwn(n,'literal'))return n.literal;if(n.ref)return val(n.ref);if(n.area){const [a,b]=n.area.split(':'),keys=range(n.area),width=Math.abs(position(b)[0]-position(a)[0])+1;return Array.from({length:keys.length/width},(_,r)=>keys.slice(r*width,(r+1)*width).map(val));}if(n.unary)return (n.unary==='-'?-1:1)*num(run(n.node));if(n.func){if(n.func==='IF'){if(n.args.length<2||n.args.length>3)throw Error('#VALUE!');return run(n.args[0])?run(n.args[1]):n.args[2]?run(n.args[2]):false;}const arity={TODAY:0,NOW:0,DATE:3,TIME:3,NOT:1,ROUND:2,INT:1,SMALL:2,LARGE:2,COUNTIF:2,VLOOKUP:4};if(Object.hasOwn(arity,n.func)?n.args.length!==arity[n.func]:!n.args.length)throw Error('#VALUE!');return call(n.func,n.args.map(run));}const x=run(n.left),y=run(n.right);if(n.op==='&')return String(x)+y;if(['>','<','>=','<=','=','<>'].includes(n.op))return compare(x,y,n.op);if(n.op==='/'&&num(y)===0)throw Error('#DIV/0!');return n.op==='+'?num(x)+num(y):n.op==='-'?num(x)-num(y):n.op==='*'?num(x)*num(y):n.op==='/'?num(x)/num(y):num(x)**num(y);}
 const tree=expression();if(i!==tokens.length)throw Error('#VALUE!');return run(tree);
}
