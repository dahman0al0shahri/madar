function render(){if(!initializing)store?.update(snapshot());const sel=selected();el.innerHTML=`<section class="excel-lab sheet-lab ${portal?'sheet-expanded':''}" dir="rtl"><header class="sheet-intro"><div><p class="eyebrow">تدريب داخل ورقة عمل</p><h3>${esc(a.title)}</h3></div>${button('expand',portal?'العودة إلى الدرس':'توسيع مساحة التدريب')}</header><div class="worksheet-save"><p role="status" class="worksheet-save-status"></p>${button('save-work','حفظ الآن')}${button('reload-work','تحميل نسخة الحساب')}${button('download-work','تنزيل نسخة التدريب')}</div><p class="sheet-task">${esc(task)}</p><div class="sheet-guide-host"></div><div class="sheet-window"><div class="sheet-title"><span>تدريب مَدار · ${esc(sheetName)}</span>${scenario?.quick()||''}<div>${button('undo','↶ تراجع')}${button('redo','↷ إعادة')}</div></div><nav class="sheet-tabs" aria-label="تبويبات التدريب">${[['file','ملف'],['home','الصفحة الرئيسية'],['insert','إدراج'],['layout','تخطيط الصفحة'],['formulas','صيغ'],['data','بيانات'],['review','مراجعة'],['developer','المطور']].map(([id,name])=>`<button data-tab="${id}" aria-pressed="${tab===id}">${name}</button>`).join('')}</nav><div class="sheet-ribbon">${ribbon()}</div><div class="sheet-formula"><label>مربع الاسم<input aria-label="مربع الاسم في التدريب" value="${selection}" dir="ltr"></label>${button('function','fx')}<label class="sheet-fx">شريط الصيغة<input aria-label="شريط الصيغة في التدريب" value="${esc(extra.closed?'':cells[active]||'')}" dir="ltr" autocomplete="off"></label>${button('commit','✓')}</div><div class="sheet-scroll" tabindex="0" aria-label="شبكة التدريب؛ يمكن تمريرها أفقياً"><table class="sheet-grid" role="grid" aria-label="ورقة عمل التدريب"><thead><tr><th></th>${[...cols].map(c=>`<th scope="col">${c}</th>`).join('')}</tr></thead><tbody>${Array.from({length:rowCount},(_,i)=>`<tr><th scope="row">${i+1}</th>${[...cols].map((c,j)=>{const k=addr(j,i+1);return `<td role="gridcell" data-cell="${k}" style="${formats[k]?.font?'font-family:'+esc(formats[k].font):''}" tabindex="${k===active?0:-1}" aria-label="${k}: ${esc(display(k))}" aria-selected="${sel.includes(k)}" class="${k===active?'active ':''}${color(k)?'cell-'+color(k):''} ${formats[k]?.bold?'cell-bold':''} ${trace.includes(k)?'cell-trace':''}"><span dir="auto">${esc(display(k))}</span>${scenario?.note(k)?`<span class="cell-note-mark" title="${esc(scenario.note(k).text)}" aria-label="تعليق: ${esc(scenario.note(k).text)}">◢</span>`:''}${control?.anchor===k?`<div class="cell-spin" aria-label="زر زيادة ونقصان">${button('spin-up','▲')}${button('spin-down','▼')}</div>`:''}${k===sel.at(-1)?'<span class="fill-handle" draggable="true" title="اسحب لتعبئة النطاق"></span>':''}</td>`;}).join('')}</tr>`).join('')}</tbody></table></div>${control?`<div class="sheet-control"><span>زر زيادة ونقصان · <bdi>${esc(control.link||'غير مرتبط')}</bdi></span>${button('control-format','تنسيق عنصر التحكم')}</div>`:''}<footer class="sheet-status"><span>${insertMode?'انقر خلية لوضع عنصر التحكم':'جاهز'} · <bdi>${selection}</bdi></span><span>${a.op==='CROSSREF'?button('sheet-one','ورقة1')+button('sheet-two','ورقة 2'):esc(sheetName)}</span></footer></div>${scenario?.panel()||''}${a.op==='CLOCK'?'<aside class="training-panel"><p>ساعة المصدر التجريبية تتغير فقط بالزر. نتيجة NOW تبقى حتى «حساب الآن».</p>'+button('clock-forward','تقديم ساعة المصدر دقيقة')+'</aside>':''}<p class="sheet-help">اضغط الخلية اللي تبغاها، واكتب في شريط الصيغة ثم Enter. لتحديد أكثر من خلية، اكتب مثلًا B2:B5 في مربع الاسم. إذا ما عرفت المكان، افتح «أول مرة تستخدم Excel؟» فوق.</p><div class="sheet-actions">${button('check','تحقق من المهمة')}${button('hint','تلميح عند الحاجة')}${button('reset','إعادة التدريب')}</div><div class="sheet-message" role="status" aria-live="polite"></div><div class="sheet-recall"></div><details class="sheet-limits"><summary>حدود التدريب وما تمت مراجعته</summary><p>محاكاة تعليمية محددة بأوامر الدرس وشبكة A1:H${rowCount}، وليست Microsoft Excel. الواجهة تستلهم ترتيب أوامر نسخة الدروس المكتبية. سلوك الصيغ الأساسية والتنسيق والتحقق يُراجع مع نسخة الويب، وقد تختلف أماكن قوائمها. عناصر تحكم النموذج والتعقب القديم ممثلان وفق الدرس والوثائق، ولم يُختبرا في Excel المكتبي. الصيغ المدعومة: IF، AND، OR، NOT، INT، ROUND، SUM، COUNT، AVERAGE، MIN، MAX، SMALL، LARGE، COUNTIF، CONCATENATE، DATE، TIME، TODAY، NOW، COUNTIFS بشروط المقارنة، والمراجع بين ورقتي المثال، وVLOOKUP المطابقة التامة. لا تدعم الصيغ المتقدمة أو جميع تحويلات الأنواع. هذا النشاط لا يسجل إتقانًا أو درجة في حسابك.</p></details></section>`;
 window.MADAR_EXCEL_GUIDE.mount(el.querySelector('.sheet-guide-host'),a.guide,{state:guideState,onLocate:id=>{tab=id;render();const target=el.querySelector('[data-tab="'+id+'"]');target.focus();target.scrollIntoView({block:'center',behavior:'auto'});}});
 el.querySelector('[data-action=undo]').disabled=!history.length;el.querySelector('[data-action=redo]').disabled=!future.length;
 store?.listen(t=>{const p=el.querySelector('.worksheet-save-status');if(p)p.textContent=t;});el.querySelector('[data-action=reload-work]').hidden=!window.MADAR_ACCOUNT?.user;el.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;render();});el.querySelectorAll('[data-action]').forEach(b=>b.onclick=e=>{e.stopPropagation();act(b.dataset.action);});
 const name=el.querySelector('[aria-label="مربع الاسم في التدريب"]'),fx=el.querySelector('[aria-label="شريط الصيغة في التدريب"]');name.onkeydown=e=>{if(e.key==='Enter'){try{const candidate=name.value.toUpperCase().replace(/\$/g,'');const keys=range(candidate);if(keys.some(k=>position(k)[1]>rowCount))throw Error('range');selection=candidate;active=keys[0];render();}catch{message('اكتب عنوانًا أو نطاقًا داخل الشبكة الظاهرة.');}}};fx.onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();write(active,fx.value);}if(e.key==='Escape')fx.value=cells[active]||'';};
 let dragStart=null;el.querySelectorAll('[data-cell]').forEach(td=>{const k=td.dataset.cell;td.onclick=e=>{if(insertMode){change(()=>{control={link:'',min:0,max:100,step:1,current:0,anchor:k};insertMode=false;});return;}selection=e.shiftKey?active+':'+k:k;if(!e.shiftKey)active=k;render();el.querySelector(`[data-cell="${k}"]`).focus();};td.oncontextmenu=e=>{if(control?.anchor===k){e.preventDefault();act('control-format');}};td.ondblclick=()=>edit(k);td.onkeydown=e=>{if(e.key==='F2'||e.key==='Enter'){e.preventDefault();edit(k);}else if(e.key.length===1&&!e.ctrlKey&&!e.metaKey){e.preventDefault();edit(k,e.key);}else if(e.key==='Delete'){e.preventDefault();write(k,'');}else if(['ArrowDown','ArrowUp','ArrowLeft','ArrowRight','Tab'].includes(e.key)){e.preventDefault();let[c,r]=position(k);if(e.key==='ArrowDown')r++;if(e.key==='ArrowUp')r--;if(e.key==='ArrowLeft'||e.key==='Tab')c++;if(e.key==='ArrowRight')c--;c=Math.max(0,Math.min(7,c));r=Math.max(1,Math.min(rowCount,r));active=addr(c,r);selection=active;render();el.querySelector(`[data-cell="${active}"]`).focus();}};td.ondragover=e=>e.preventDefault();td.ondrop=e=>{e.preventDefault();if(dragStart){selection=dragStart+':'+k;fillDown();}};const h=td.querySelector('.fill-handle');if(h)h.ondragstart=e=>{dragStart=active;e.dataTransfer.setData('text/plain',active);};});
 }
 