function finishQuiz(){const finished=quiz;window.MADAR_QUALITY?.record(finished,finished.items);finished.items.forEach(mark);const score=finished.items.filter(isCorrect).length;activity('quiz_finish',{value:score});saved.history.push({title:finished.title,mode:finished.mode,score,total:finished.items.length,date:new Date().toISOString()});saved.history=saved.history.slice(-30);saved.active=null;saved.lastResult=finished;quiz=null;persist();lastResult=finished;sessionStorageSafe(finished);location.hash='#results';results(finished);}
function sessionStorageSafe(value){if(window.MADAR_CONTENT_PREVIEW)return;try{sessionStorage.setItem('madar-last-result'+(account.user?':'+account.user.id:':guest'),JSON.stringify(value));}catch(e){}}
function results(done){done=done||lastResult||saved.lastResult;if(!done){try{done=JSON.parse(sessionStorage.getItem('madar-last-result'+(account.user?':'+account.user.id:':guest')));}catch(e){}}if(!compatibleWordSession(done)||!Array.isArray(done.items)||done.items.some(i=>!Q(i.id))){$('#main').innerHTML='<h1>لا توجد نتيجة مفتوحة</h1><a class="button" href="#quiz">اختبر نفسك</a>';return;}const score=done.items.filter(isCorrect).length;$('#main').innerHTML=`<p class="eyebrow">انتهت هذه الجلسة</p><h1>${ar(score)} من ${ar(done.items.length)}</h1><p class="muted">${esc(done.title)} · ${done.mode==='practice'?'تدريب مع تصحيح أثناء الحل':'اختبار دون تصحيح أثناء الحل'}</p><div class="panel"><h2>${score===done.items.length?'أحسنت في هذه المجموعة.':'الخطوة التالية: راجع سبب الخطأ ثم حاول مجددًا.'}</h2><p>هذه نتيجة الأسئلة التي أجبت عنها فقط. تكرار الأسئلة قد يجعلها مألوفة، لذلك لا تعتبر الدرجة وحدها دليلًا على إتقان المقرر.</p><div class="bottom-actions"><a class="button primary" href="#mistakes">مراجعة أخطائي</a><a class="button" href="#quiz">مراجعة جديدة</a></div></div><div class="panel result-list"><h2>إجاباتك وتفسيراتها</h2>${done.items.map((i,n)=>{const q=Q(i.id);return `<details><summary><span class="${isCorrect(i)?'right-label':'wrong-label'}">${isCorrect(i)?'✓ صحيح':'× يحتاج مراجعة'}</span> · ${ar(n+1)}. ${esc(q.prompt)}</summary><p>إجابتك: ${esc(q.type==='order'?(i.answer||[]).map(x=>q.options[x]).join(' ثم '):q.options[i.answer]||'لم تجب')}</p>${explanation(i)}</details>`;}).join('')}</div>`;}
function savedView(){document.querySelector('#sidebar').innerHTML='';document.querySelector('.course-badge').textContent='الوورد والإكسل والأكسس';const filter=location.hash.split('/')[1];window.MADAR_SAVED.mount(filter==='word'?'Word':filter==='excel'?'Excel':filter==='access'?'Access':'all');}
function mistakesView(){const scope=location.hash.split('/')[1];document.querySelector('#sidebar').innerHTML='';document.querySelector('.course-badge').textContent='الوورد والإكسل والأكسس';window.MADAR_MISTAKES.mount(scope==='word'?'Word':scope==='excel'?'Excel':scope==='access'?'Access':'all');}
window.MADAR_WORD_REVIEW={data:D,state:()=>saved,removeBookmark(id){if(account.error||syncBlocked||window.MADAR_CONTENT_PREVIEW)return false;saved.bookmarks=saved.bookmarks.filter(x=>x!==id);persist();return true;},setReview(value){saved.mistakeReview=value;persist();},record(item){if(account.error||syncBlocked)return false;mark(item);persist();return true;},finish(entry){saved.mistakeHistory=(saved.mistakeHistory||[]).filter(h=>h.id!==entry.id).concat(entry).slice(-30);persist();}};
