جلسة'})[v];document.body.dataset.view=v;activity('page_open',{...(v==='learn'?{lesson:L(id)?.id||lastLesson}:{})});$('.course-badge').innerHTML=accessRoute?'<b lang="en">A</b> Microsoft Access <span class="prototype-badge">تعلّم وتطبيق</span>':excelRoute?'<b lang="en">X</b> Microsoft Excel <span class="prototype-badge">تعلّم وتطبيق</span>':'<b lang="en">W</b> Microsoft Word <span class="prototype-badge">نسخة تجريبية</span>';if(accessRoute)window.MADAR_ACCESS.mount();else if(v==='excel'||excelQuiz)window.MADAR_PAID_EXCEL.mount();else renderSide();if(accessRoute||v==='excel'||excelQuiz){}else if(v==='account')accountView();else if(v==='reference')window.MADAR_REFERENCE.mount();else if(v==='home')homeView();else if(v==='word')wordView();else if(v==='learn')lessonView(id||lastLesson);else if(v==='quiz')quizSetup();else if(v==='saved')savedView();else if(v==='mistakes')mistakesView();else if(v==='about')about();else if(v==='session')renderQuestion();else results();window.scrollTo(0,0);$('#main').focus({preventScroll:true});window.MADAR_TRANSITIONS.afterRender();}
$$('[data-nav]').forEach(a=>a.insertAdjacentHTML('afterbegin',icon(a.dataset.nav)));window.addEventListener('hashchange',()=>window.MADAR_TRANSITIONS.navigate(route));applyTheme();$('#account-label').textContent=account.user?'حسابي':'الدخول';route();if(window.MADAR_CONTENT_CHANGED){const n=document.createElement('p');n.className='activity-disclosure';n.textContent='تحدّث محتوى الأسئلة. ابدأ جلسة جديدة؛ تبقى الدرجات السابقة محفوظة، ولا نعيد تصحيحها بمفتاح الإجابة الجديد.';document.querySelector('.workspace-bar').after(n);}if(syncMessage)syncStatus(syncMessage);if(syncDirty&&!syncBlocked)void flushSync();
