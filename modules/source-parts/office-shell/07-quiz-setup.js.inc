function wordQuizNotice(){
 const added=D.questions.filter(q=>q.unit>=6&&!q.paused).length;
 if(!added)return '';
 const fresh=!wordNoticeShown;wordNoticeShown=true;
 return `<aside class="word-quiz-news ${fresh?'is-new':''}" aria-labelledby="word-news-title"><div class="word-news-copy"><span class="word-news-label">جديد في الوورد</span><h2 id="word-news-title">${ar(added)} سؤالًا جديدًا…<br>جاهز تختبر فهمك؟</h2><p>مواقف من دروسك، وتفسير يوضح لك ليه الإجابة صح.<br>بنك الوورد صار <strong>${ar(D.questions.length)} سؤالًا</strong> للمراجعة.</p><button type="button" id="word-news-action">${saved.active?'كمّل جلستك':'اختَر مراجعتك'}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button></div><div class="word-news-art" aria-hidden="true"><div class="word-news-sheet back"></div><div class="word-news-sheet front"><span class="word-news-lines"></span><b dir="ltr">+${ar(added)}</b><span>سؤالًا جديدًا</span><i></i></div><span class="word-news-total">${ar(D.questions.length)} سؤالًا الآن</span></div></aside>`;
}
function quizSetup(){
 renderSide();
 const lessons=D.lessons.filter(l=>D.questions.some(q=>q.lesson===l.id));
 const groups=[...new Set(lessons.map(l=>l.unit))];
 const unitLabel=n=>`الوحدة ${ar(n)} · ${D.unitNames[n-1]}`;
 $('#main').innerHTML=`<nav class="quiz-subjects" aria-label="اختر برنامج الاختبار"><a class="button primary" href="#quiz" aria-current="page">الوورد</a><a class="button" href="#quiz/excel">الإكسل</a><a class="button" href="#quiz/access">الأكسس</a></nav>${wordQuizNotice()}<p class="eyebrow">WORD / استرجع قبل أن تكشف الإجابة</p><h1>اختبر نفسك بطريقتك</h1><p class="muted">${D.questions.length?ar(D.questions.length)+' سؤال اختيار من متعدد.':'الأسئلة موقوفة مؤقتًا للمراجعة.'} أسئلة تدريبية، وليست أسئلة الاختبار الرسمي.</p>
 <div id="word-quiz-setup"><section class="panel"><h2>اختبار الوورد الشامل</h2><p>سؤال من كل درس له أسئلة. مجموعها ${ar(lessons.length)} سؤال. جاوب أول، والتصحيح يطلع لك في النهاية.</p><button id="comprehensive" class="primary" ${saved.active||!D.questions.length?'disabled':''}>ابدأ الاختبار الشامل</button></section>
 ${saved.active?`<section class="panel resume"><h2>لديك جلسة لم تنتهِ</h2><p>${esc(saved.active.title)} · عند السؤال ${ar(saved.active.index+1)} من ${ar(saved.active.items.length)}</p><button class="primary" id="resume">متابعة الجلسة</button> <button id="discard">ترك الجلسة غير المكتملة</button></section>`:''}
 <form id="quiz-form" class="panel"><label class="field">نطاق المراجعة<select id="word-scope" name="scope"><option value="all">كل الدروس</option><option value="mistakes">أخطائي السابقة</option>${groups.map(g=>`<option value="unit:${g}">${esc(unitLabel(g))} كاملة</option>`).join('')}${groups.map(g=>`<optgroup label="${esc(unitLabel(g))}">${lessons.filter(l=>l.unit===g).map(l=>`<option value="${l.id}">${esc(l.title)}</option>`).join('')}</optgroup>`).join('')}<option value="custom">اختيار دروس متعددة</option></select></label>
 <fieldset id="word-custom-scope" hidden><legend>حدد الدروس التي تريد مراجعتها</legend><div class="bottom-actions"><button type="button" id="select-all">تحديد الكل</button><button type="button" id="select-none">إلغاء التحديد</button></div><div class="scope">${groups.map(g=>`<details><summary><input type="checkbox" class="unit-check" data-unit="${g}" aria-label="تحديد الوحدة ${ar(g)}" checked><span>${esc(unitLabel(g))}</span></summary>${lessons.filter(l=>l.unit===g).map(l=>`<label class="check"><input type="checkbox" name="lesson" value="${l.id}" data-unit="${l.unit}" checked>${esc(l.title)}</label>`).join('')}</details>`).join('')}</div></fieldset>
 <label class="field">عدد الأسئلة<input id="word-count" name="count" type="number" value="10" min="1" max="${Math.max(1,D.questions.length)}" aria-describedby="available" required><small id="available" class="muted" aria-live="polite"></small></label><label class="field">طريقة الحل<select id="word-quiz-mode" name="mode"><option value="practice">تدريب — التصحيح بعد كل سؤال</option><option value="exam">اختبار — التصحيح في النهاية</option></select></label><p id="form-error" class="error" role="alert"></p><button class="primary" type="submit" ${saved.active||!D.questions.length?'disabled':''}>ابدأ المراجعة</button></form></div>
 <p class="privacy">${account.user?'نتائجك محفوظة في حسابك عند اكتمال المزامنة. يمكنك المتابعة من جهاز آخر.':'أنت تتصفح كضيف: الحفظ في هذا المتصفح فقط. سجّل الدخول لحفظ تقدّمك بين الأجهزة.'} <a href="#account">حسابي وحالة الحفظ</a></p>${saved.history.length?`<div class="panel soft"><h2>جلساتك الأخيرة</h2>${saved.history.slice(-5).reverse().map(h=>`<p>${esc(h.title)} · ${ar(h.score)} / ${ar(h.total)} · ${h.mode==='practice'?'تدريب':'اختبار'}</p>`).join('')}<p class="muted small">نتيجة هذه الأسئلة لا تعني إتقان المقرر كله.</p></div>`:''}`;
 if($('#resume')){$('#resume').onclick=()=>{activity('quiz_resume');quiz=saved.active;location.hash='#session';if(location.hash==='#session')renderQuestion();};$('#discard').onclick=()=>{activity('quiz_discard');saved.active=null;quiz=null;persist();quizSetup();};}
 $('#comprehensive').onclick=()=>startQuiz(shuffle(lessons.map(l=>shuffle(D.questions.filter(q=>q.lesson===l.id))[0]).filter(Boolean)),'exam','الاختبار الشامل');
 const available=()=>{const scope=$('#word-scope').value,ids=$$('input[name=lesson]:checked').map(x=>x.value);return D.questions.filter(q=>scope==='all'||(scope==='mistakes'?saved.mistakes.includes(q.id):scope==='custom'?ids.includes(q.lesson):scope.startsWith('unit:')?String(q.unit)===scope.slice(5):q.lesson===scope));};
 const refresh=()=>{const count=available().length,input=$('#word-count'),scope=$('#word-scope').value;$('#word-custom-scope').hidden=scope!=='custom';$('#available').textContent=`المتاح وفق اختيارك: ${ar(count)} سؤالًا`;input.max=String(Math.max(1,count));if(Number(input.value)>count&&count)input.value=String(count);$('#quiz-form button[type=submit]').disabled=!!saved.active||!count;$('#form-error').textContent=count?'':scope==='mistakes'?'ما عندك أخطاء محفوظة للمراجعة الآن. اختر نطاقًا آخر.':'حدد درسًا له أسئلة لبدء المراجعة.';$$('.unit-check').forEach(c=>{const children=$$(`input[name=lesson][data-unit="${c.dataset.unit}"]`),checked=children.filter(x=>x.checked).length;c.checked=checked===children.length;c.indeterminate=checked>0&&checked<children.length;});};
 $('#word-scope').onchange=refresh;
 $$('.unit-check').forEach(c=>c.onchange=()=>{$$(`input[name=lesson][data-unit="${c.dataset.unit}"]`).forEach(x=>x.checked=c.checked);refresh();});
 $$('input[name=lesson]').forEach(c=>c.onchange=refresh);
 $('#select-all').onclick=()=>{$$('input[name=lesson]').forEach(x=>x.checked=true);refresh();};$('#select-none').onclick=()=>{$$('input[name=lesson]').forEach(x=>x.checked=false);refresh();};refresh();
 $('#quiz-form').onsubmit=e=>{e.preventDefault();const pool=available(),count=Number($('#word-count').value);if(!pool.length){refresh();return;}if(!Number.isInteger(count)||count<1||count>pool.length){$('#form-error').textContent=`اختر عددًا من ١ إلى ${ar(pool.length)} حسب النطاق الحالي.`;return;}startQuiz(shuffle(pool).slice(0,count),$('#word-quiz-mode').value,'مراجعة مخصصة');};
 const newsAction=$('#word-news-action');if(newsAction)newsAction.onclick=()=>{const target=saved.active?$('#resume'):$('#word-scope');target?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'center'});target?.focus({preventScroll:true});};
 window.MADAR_PROGRAM_UI?.afterRender();
}
