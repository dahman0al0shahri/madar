function startQuiz(questions,how,title){if(!questions.length){toast('لم تُضف أسئلة لهذا الدرس بعد.');return;}if(saved.active){toast('تابع جلستك السابقة أو اتركها أولًا من صفحة اختبر نفسك.');location.hash='#quiz';return;}quiz={sessionId:crypto.randomUUID(),bankVersion:D.bankVersion,mode:how,title,index:0,items:questions.map(q=>{let order=q.options.map((_,i)=>i);if(q.type!=='tf')order=shuffle(order);if(q.type==='order'&&order.every((n,i)=>n===i))order.push(order.shift());return {id:q.id,order,answer:null,checked:false};})};saved.active=quiz;activity('quiz_start',{value:questions.length});persist();location.hash='#session';renderQuestion();}
function isCorrect(item){const q=Q(item.id);return q.type==='order'?JSON.stringify(item.answer)===JSON.stringify(q.answer):item.answer===q.answer;}
function correctText(q){return q.type==='order'?q.answer.map(i=>q.options[i]).join(' ثم '):q.options[q.answer];}
function mark(item){const ok=isCorrect(item);if(ok)saved.mistakes=saved.mistakes.filter(id=>id!==item.id);else if(!saved.mistakes.includes(item.id))saved.mistakes.push(item.id);}
function explanation(item){const q=Q(item.id),ok=isCorrect(item),chosen=Number.isInteger(item.answer)?item.answer:null;return `<div class="feedback ${ok?'':'wrong'}"><h3>${ok?'إجابة صحيحة':'راجع هذه النقطة'}</h3><p><strong>الإجابة الصحيحة:</strong> ${esc(correctText(q))}</p><p>${esc(q.explanation)}</p>${!ok&&chosen!==null?`<p class="selected-reason"><strong>لماذا لا يناسب اختيارك؟</strong> ${esc(q.rationales[chosen])}</p>`:''}<details class="answer-reasons"><summary>لماذا لا تناسب البدائل الأخرى؟</summary>${q.options.map((opt,i)=>i===q.answer?'':`<p><strong>${esc(opt)}</strong><br>${esc(q.rationales[i])}</p>`).join('')}</details><p class="source-locator">من الدرس: ${esc(L(q.lesson).title)} · ${esc(q.source.section)}</p><a href="${link(L(q.lesson))}">راجع الدرس ومصادره</a> · <a href="#about/report/question/${q.id}">بلّغ عن مشكلة في السؤال</a></div>`;}
function renderQuestion(){quiz=quiz||saved.active;if(!quiz){location.hash='#quiz';return;}const item=quiz.items[quiz.index],q=Q(item.id),locked=quiz.mode==='practice'&&item.checked;
 $('#main').innerHTML=`<div class="quiz-header"><div><p class="eyebrow">${quiz.mode==='practice'?'تدريب مع التصحيح':'اختبار · التصحيح في النهاية'}</p><h1>${esc(quiz.title)}</h1></div><span class="chip">${ar(quiz.index+1)} / ${ar(quiz.items.length)}</span></div><div class="progress" aria-hidden="true"><span style="width:${100*(quiz.index+1)/quiz.items.length}%"></span></div><section class="panel"><div class="intro-line"><span class="muted small">الوحدة ${ar(q.unit)} · ${typeNames[q.type]}</span>${quiz.mode==='practice'?`<span class="chip">${esc(L(q.lesson).title)}</span>`:''}</div><h2 id="question-title">${esc(q.prompt)}</h2>${q.type==='order'?`<p class="muted small">حرّك الخطوات للأعلى أو للأسفل حتى يصبح أول إجراء في الأعلى.</p><ol class="order-list">${item.order.map((n,i)=>`<li><span class="section-number">${ar(i+1)}</span><span class="text">${esc(q.options[n])}</span><button data-move="${i}" data-delta="-1" aria-label="رفع: ${esc(q.options[n])}" ${locked||i===0?'disabled':''}>أعلى</button><button data-move="${i}" data-delta="1" aria-label="خفض: ${esc(q.options[n])}" ${locked||i===item.order.length-1?'disabled':''}>أسفل</button></li>`).join('')}</ol>`:`<fieldset class="options" aria-labelledby="question-title">${item.order.map((n,pos)=>`<label class="option ${locked?(n===q.answer?'option-correct':item.answer===n?'option-wrong':''):''}"><input type="radio" name="answer" value="${n}" ${item.answer===n?'checked':''} ${locked?'disabled':''}><span class="option-letter" aria-hidden="true">${['أ','ب','ج','د'][pos]}</span><span>${esc(q.options[n])}</span></label>`).join('')}</fieldset>`}<p id="answer-error" role="alert" class="error"></p>${locked?explanation(item):''}<div class="bottom-actions"><button id="prev-q" ${quiz.index===0?'disabled':''}>السابق</button>${quiz.mode==='practice'&&!locked?'<button class="primary" id="check">تحقق من إجابتي</button>':`<button class="primary" id="next-q">${quiz.index===quiz.items.length-1?'إنهاء وعرض النتيجة':'التالي'}</button>`}<span class="spacer"></span><a href="#quiz">حفظ الجلسة والعودة</a></div><p class="small muted"><a href="#about/report/question/${q.id}">بلّغ عن مشكلة في السؤال</a> · تبقى جلستك محفوظة للمتابعة.</p></section>`;
 $$('input[name=answer]').forEach(x=>x.onchange=()=>{item.answer=Number(x.value);activity('quiz_answer',{question:item.id,lesson:q.lesson,value:item.answer});saved.active=quiz;persist();});
 $$('[data-move]').forEach(b=>b.onclick=()=>{const i=Number(b.dataset.move),j=i+Number(b.dataset.delta);[item.order[i],item.order[j]]=[item.order[j],item.order[i]];item.answer=[...item.order];persist();renderQuestion();const focus=$$('[data-move]').find(x=>Number(x.dataset.move)===j&&x.dataset.delta===b.dataset.delta&&!x.disabled);focus?.focus();});
 $('#prev-q').onclick=()=>{activity('quiz_previous',{question:item.id});quiz.index--;persist();renderQuestion();};
 function capture(){if(q.type==='order')item.answer=[...item.order];if(item.answer===null){$('#answer-error').textContent='اختر إجابة قبل المتابعة.';return false;}return true;}
 if($('#check'))$('#check').onclick=()=>{if(!capture())return;window.MADAR_QUALITY?.record(quiz,[item]);item.checked=true;activity('quiz_check',{question:item.id,lesson:q.lesson,value:isCorrect(item)?'correct':'incorrect'});mark(item);persist();renderQuestion();};
 if($('#next-q'))$('#next-q').onclick=()=>{if(!capture())return;if(quiz.index<quiz.items.length-1){activity('quiz_next',{question:item.id});quiz.index++;persist();renderQuestion();$('#main').focus();window.scrollTo(0,0);}else{const missing=quiz.items.findIndex(i=>i.answer===null);if(missing!==-1){quiz.index=missing;persist();renderQuestion();$('#answer-error').textContent='أكمل هذا السؤال قبل إنهاء الجلسة.';}else finishQuiz();}};
 window.MADAR_PROGRAM_UI?.afterRender();
}
