function renderReview(l){
 const sections=l.sections.filter(s=>mode==='all'||(mode==='steps'&&s.kind==='steps')||(mode==='summary'&&s.kind==='summary'));
 $('#review').innerHTML=`<div class="review-heading"><div><p class="eyebrow">بعد المشاهدة</p><h2>ثبّت ما تعلّمت.</h2></div><button id="bookmark" aria-pressed="${saved.bookmarks.includes(l.id)}">${saved.bookmarks.includes(l.id)?'✓ محفوظ للمراجعة':'＋ برجع لها'}</button></div>
 <div class="tabs" role="group" aria-label="طريقة المراجعة"><button data-mode="summary" aria-pressed="${mode==='summary'}">ملخص للحفظ</button><button data-mode="all" aria-pressed="${mode==='all'}">الشرح المكتوب الكامل</button></div>
 <div class="reading reading-${mode}">${mode==='differences'?`<div class="compare">${l.difference.map(d=>{const [a,...b]=d.split(':');return `<div><h3>${esc(a)}</h3><p>${esc(b.join(':'))}</p></div>`;}).join('')}</div><div class="panel soft" style="margin-top:22px"><h3>مثال يساعدك على التمييز</h3><p>${esc(l.example)}</p></div>`:sections.map((s,i)=>`<section class="panel ${s.kind==='concept'?'concept':''}"><h3>${s.kind==='steps'?`<span class="section-number">${String(i+1).padStart(2,'0')}</span>`:''}${esc(s.title)}</h3>${s.html}</section>`).join('')}
 ${mode==='summary'?`<div class="panel soft"><h3>مثال بسيط للمراجعة</h3><p>${esc(l.example)}</p></div>`:''}
 ${['summary','differences'].includes(mode)&&diagrams[l.id]?`<figure style="margin:0"><img class="diagram" src="assets/${diagrams[l.id]}.svg" alt="${esc(l.difference.join(' '))}" width="800" height="330"><figcaption class="diagram-caption">رسم للمراجعة؛ ليس لقطة من واجهة Word. <a href="assets/${diagrams[l.id]}.svg" target="_blank" rel="noopener">فتح الرسم بحجمه الكامل</a></figcaption></figure>`:''}
 ${mode==='steps'?`<div class="panel soft"><h3>احفظ المسار</h3><ol class="commands">${l.steps.map(s=>`<li>${esc(s)}</li>`).join('')}</ol></div>`:''}
 <div class="bottom-actions"><button class="primary" id="lesson-practice">تدرّب على هذا الدرس</button><a class="button" href="#quiz">خصّص اختبارك</a><a href="#about/report/lesson/${l.id}">بلّغ عن مشكلة في الدرس</a></div>
 <details class="source-box"><summary>مصدر الدرس وحدود المراجعة</summary><p>الفيديو الأصلي هو أساس الشرح في هذه الصفحة. نص المراجعة مبني على الملخص المنقول له، مع صياغة تعليمية وتصحيحات من وثائق Microsoft. لم نتحقق من جميع تفاصيل الصوت والصورة. ${l.provenance==='general'?'الملخص المرسل لهذا الدرس استند إلى العنوان والخطوات العامة لعدم توفر التفريغ؛ لذلك لا نعد النص نقلًا حرفيًا للفيديو.':''} قد تختلف أسماء بعض الأوامر قليلًا بحسب إصدار Word ولغة الواجهة.</p><a href="${esc(l.video)}" target="_blank" rel="noopener">الفيديو الأصلي</a>${l.references.length?`<ul>${l.references.map((url,i)=>`<li><a href="${esc(url)}" target="_blank" rel="noopener">مرجع Microsoft ${ar(i+1)}</a></li>`).join('')}</ul>`:''}</details>
 <div class="bottom-actions">${l.number>1?`<a class="button" href="${link(D.lessons[l.number-2])}">الدرس السابق</a>`:''}<span class="spacer"></span>${l.number<D.lessons.length?`<a class="button" href="${link(D.lessons[l.number])}">الدرس التالي</a>`:`<a class="button" href="#quiz">مراجعة وحدات Word</a>`}</div></div>`;
 $$('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;activity('review_mode',{lesson:l.id,value:mode});renderReview(l);});
 $('#bookmark').onclick=()=>{saved.bookmarks=saved.bookmarks.includes(l.id)?saved.bookmarks.filter(x=>x!==l.id):[...saved.bookmarks,l.id];persist();activity(saved.bookmarks.includes(l.id)?'bookmark_add':'bookmark_remove',{lesson:l.id});renderReview(l);toast(saved.bookmarks.includes(l.id)?'أضيف الدرس إلى برجع لها':'أزيل الدرس من القائمة');};
 $('#lesson-practice').onclick=()=>startQuiz(D.questions.filter(q=>q.lesson===l.id),'practice','تدريب: '+l.title);
}
let wordNoticeShown=false;
