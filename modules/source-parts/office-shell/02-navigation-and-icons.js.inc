function renderSide(){const current=L(lastLesson);$('#sidebar').innerHTML=`<div class="shelf-title"><div><strong>دليلك في Word</strong><br><span>${ar(D.unitNames.length)} وحدات · ${ar(D.lessons.length)} درسًا</span></div><button id="toggle-index" aria-expanded="false">الفهرس</button></div><div class="units">${D.unitNames.map((name,i)=>`<details class="unit" ${current?.unit===i+1?'open':''}><summary>${ar(i+1)}. ${esc(name)}<small>${ar(D.lessons.filter(l=>l.unit===i+1).length)}</small></summary>${D.lessons.filter(l=>l.unit===i+1).map(l=>`<a class="lesson-link ${l.id===lastLesson?'current':''}" ${l.id===lastLesson?'aria-current="page"':''} href="${link(l)}"><span class="n">${String(l.number).padStart(2,'0')}</span>${esc(l.title)}</a>`).join('')}</details>`).join('')}</div><p class="side-note">شاهد لتفهم، ثم راجع لتتذكر. فتح الدرس وحده لا يعني أنك أتقنته.<br><br>مراجعة الوورد: ${ar(D.questions.length)} سؤال اختيار من متعدد.</p>`;$('#toggle-index').onclick=()=>{const on=$('#sidebar').classList.toggle('expanded');$('#toggle-index').setAttribute('aria-expanded',String(on));};}

