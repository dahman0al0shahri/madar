/* One row above the canvas; narrow screens scroll the tools, never the page. */
#madar-labs #madar-free .ml-workspace-toolbar{display:flex;align-items:center;gap:4px;max-width:100%;min-width:0;background:linear-gradient(110deg,#16242a,#101c21);border:1px solid #465d67;border-radius:12px 12px 0 0;padding:8px;direction:rtl}
#madar-labs .ml-tools-track{display:flex;align-items:center;flex:1;min-width:0;gap:10px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;scrollbar-color:#638692 transparent;direction:rtl;padding:3px 2px 7px}
#madar-labs .ml-tools-group{display:flex;align-items:center;flex:0 0 auto;gap:6px;padding-inline-end:10px;border-inline-end:1px solid #40545e}
#madar-labs #madar-free .ml-tools-track button{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;min-height:44px;padding:8px 11px;font-size:12px}
#madar-labs #madar-free .ml-tools-track #nf-plus,#madar-labs #madar-free .ml-tools-track #nf-minus{min-width:46px;font-size:23px;line-height:1}
#madar-labs #madar-free .ml-tools-arrow{flex:0 0 44px;width:44px;min-height:44px;padding:0;font-size:27px;color:#b3e4ed;border-color:#648f9b;background:#213b45;box-shadow:0 0 10px #7ab6c21c}
#madar-labs #madar-free .ml-tools-arrow:disabled{opacity:.3;box-shadow:none}
#madar-labs .ml-tools-track button[aria-pressed=true]{background:#24474c;border-color:#82d8d0;color:#e7fffc}
#madar-labs #ml-tools-guide{padding:14px 18px;background:#132128;border:1px solid #465d67;border-top:0;color:#c0d4dc;font-size:12px}
#madar-labs #ml-tools-guide>span{display:block;margin-block:6px}
#madar-labs #ml-tools-guide details{margin-top:10px}
#madar-labs #ml-quick-delete{border-color:#81515c;color:#ffb9c5}
#madar-labs #ml-skip-step{min-height:46px;border:1px solid #7dd5cd;background:#1b4144;color:#e3fffb;font-weight:700;box-shadow:inset 0 1px 0 #b6fff018}
#madar-labs #ml-skip-step:hover:not(:disabled){background:#28575a;border-color:#b2fff5}
#madar-labs .ml-free-steps{padding:12px 14px;border:1px solid #46646a;border-radius:10px;background:#14282d}

