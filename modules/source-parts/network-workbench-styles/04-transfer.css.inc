/* Explicit transfer and freely selected steps; touch targets remain at least 44px. */
#madar-labs .ml-transfer-tools,#madar-labs .ml-free-steps{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0}
#madar-labs .ml-free-steps label{flex:1 1 220px;min-width:0;display:flex;flex-direction:column;gap:4px}
#madar-labs .ml-free-steps small{flex-basis:100%;color:#b9c5cc}
#madar-labs .ml-free-steps select,#madar-labs .ml-free-steps button,#madar-labs .ml-transfer-tools button{min-height:44px}
#madar-labs .ml-free-steps select{width:100%;min-width:0;max-width:100%}
#madar-labs .ml-config-map{display:grid;grid-template-columns:minmax(90px,1fr) minmax(120px,2fr);align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #43515a}
#madar-labs .ml-config-map select{min-width:0;width:100%}
#madar-labs #madar-free .ml-zoom-dock{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:10px 14px;background:#152229;border-block:1px solid #42545c}
#madar-labs #madar-free .ml-zoom-dock button{min-width:48px;min-height:48px;font-size:24px;line-height:1;padding:8px 12px;border-color:#7795a2;background:#243943}
#madar-labs #madar-free .ml-zoom-dock #nf-all{font-size:14px}

