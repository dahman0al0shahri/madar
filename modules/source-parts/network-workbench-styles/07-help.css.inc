/* Help location and explicit independent-workspace confirmation. */
#madar-labs .ml-help-choices{display:grid;gap:12px}
#madar-labs .ml-help-choices button{display:grid;gap:7px;width:100%;text-align:start;padding:18px;border:1px solid #46696d;border-radius:14px;background:#17292e}
#madar-labs .ml-help-choices strong{font-size:17px;color:#e6f7f5}
#madar-labs .ml-help-choices span,#madar-labs .ml-help-choice-note{font-size:14px;line-height:1.8;color:#b8c9cd}
#madar-labs .ml-help-warning{padding:18px;border:1px solid #df697d;border-inline-start:4px solid #ff8497;border-radius:14px;background:#341d28;color:#ffb6c2;line-height:1.9}
#madar-labs .ml-help-warning strong{display:block;color:#ff91a5;font-size:18px}
#madar-labs .ml-help-warning ul{padding-inline-start:22px;margin-bottom:0}
#madar-labs .ml-help-warning li+li{margin-top:10px}
#madar-labs .ml-help-confirm-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
@media(max-width:520px){#madar-labs .ml-help-confirm-actions button{width:100%}#madar-labs .ml-help-warning{padding:13px;font-size:14px}}
