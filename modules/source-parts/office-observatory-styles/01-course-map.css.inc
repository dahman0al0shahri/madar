/* The entry is a working course map, not a gate before the lessons. */
.welcome{display:grid;grid-template-columns:1.12fr 1fr;min-height:410px;align-items:center;border:1px solid #365263;border-radius:9px;overflow:hidden;position:relative;background:linear-gradient(125deg,#122633,#101d29 50%,#0c1721);box-shadow:0 20px 60px #0002}.welcome:before{content:'';position:absolute;inset:0;background-image:linear-gradient(#4968770b 1px,transparent 1px),linear-gradient(90deg,#4968770b 1px,transparent 1px);background-size:36px 36px;pointer-events:none}.welcome-copy{padding:36px 36px 26px;position:relative;z-index:1}.welcome h1{font-size:clamp(2.05rem,3.4vw,3.5rem);line-height:1.45;margin:20px 0 20px;letter-spacing:-1px}.welcome h1 em{font-style:normal;color:var(--accent)}.welcome-description{font-size:.95rem;line-height:1.95;color:#b3c8d7;max-width:420px}.welcome-actions{display:flex;gap:10px;flex-wrap:wrap;margin:28px 0 25px}.welcome-facts{display:flex;gap:23px;border-top:1px solid #314957;padding-top:20px;color:var(--muted);font-size:.72rem}.welcome-facts b{font-size:1rem;font-weight:500;margin-inline-end:4px;color:#e2edf5}
.course-orbit{height:410px;position:relative;direction:ltr;isolation:isolate;min-width:0}.orbit-grid{position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at center,#48b6d116,transparent 68%)}.orbital-ring{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border:1px solid #467e913d;border-radius:50%;pointer-events:none}.ring-a{width:280px;height:280px}.ring-b{width:340px;height:340px;border-style:dashed;border-color:#41677833}.orbit-core{position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-50%);display:flex;align-items:center;flex-direction:column;justify-content:center;width:180px;height:180px;border:1px solid #406274;border-radius:50%;background:radial-gradient(circle at 30% 20%,#274657,#122330 65%);box-shadow:0 0 45px #50b9d112,inset 0 0 25px #82c9de0a}.orbit-core>span{font-size:1.5rem;color:var(--accent);line-height:1.4}.orbit-core strong{font:400 35px/1.5 'Segoe UI',sans-serif;letter-spacing:2px}.orbit-core small{font-size:.63rem;color:#9dbacc;margin-top:3px}.orbit-node{position:absolute;transform:translate(-50%,-50%);display:flex;gap:7px;direction:rtl;align-items:center;min-height:43px;padding:7px 10px;background:#112530;border:1px solid #436173;border-radius:6px;color:#bed9e5;font-size:.68rem;white-space:nowrap;box-shadow:0 6px 20px #0003}.orbit-node b{font:10px ui-monospace,monospace;color:var(--accent);border-inline-end:1px solid #476474;padding-inline-end:7px}.orbit-node:hover{transform:translate(-50%,-50%);background:#244456;border-color:#8cdaed;color:white;box-shadow:0 0 22px #69d5e722}.node-1{left:50%;top:14%}.node-2{left:80%;top:38%}.node-3{left:72%;top:77%}.node-4{left:26%;top:77%}.node-5{left:20%;top:38%}.orbit-caption{position:absolute;bottom:14px;width:100%;text-align:center;font-size:.65rem;color:#9fb8c9;direction:rtl}
.course-library{margin-top:45px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}.section-heading .eyebrow{font:10px/1.6 ui-monospace,monospace;letter-spacing:2px;margin-bottom:12px;color:#85b2c6}.section-heading h2{font-size:1.65rem;margin:0}.section-heading>p{font-size:.83rem;color:var(--muted);margin:0}.unit-collection{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.unit-card{border:1px solid #2b4556;border-radius:8px;background:linear-gradient(155deg,#142733,#0e1a24);padding:23px 22px 16px;scroll-margin-top:25px;position:relative}.unit-card:before{content:'';position:absolute;top:-1px;right:22px;width:34px;height:2px;background:#6eafc3}.unit-card-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.unit-n{font:300 29px/1 'Segoe UI',sans-serif;letter-spacing:1px;color:#8fd2e5}.unit-count{color:var(--muted);font-size:.7rem}.unit-card h3{font-size:1.08rem;line-height:1.65;margin-bottom:20px;color:#e9f2f7}.unit-lessons{border-top:1px solid #2b4554}.unit-lessons a{display:flex;align-items:start;gap:9px;text-decoration:none;font-size:.79rem;line-height:1.8;padding:11px 0;color:#b3c8d6;border-bottom:1px solid #263b4870}.unit-lessons a:last-child{border-bottom:0}.unit-lessons a:hover{color:var(--accent)}.lesson-play{font-family:'Segoe UI',sans-serif;line-height:1.9;color:#7baabd;flex-shrink:0}.home-review{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:29px 33px;margin-top:28px;border:1px solid #304b5b;border-radius:8px;background:linear-gradient(100deg,#0c1822,#162e3b)}.home-review h2{font-size:1.6rem;margin-bottom:8px}.home-review p{font-size:.87rem;color:var(--muted);margin-bottom:0}.home-review .eyebrow{color:var(--accent);margin-bottom:10px}
