/* MADAR — a quiet observatory for video and revision. */
:root{--bg:#090f16;--surface:#101c27;--raised:#192b38;--ink:#e7eef4;--muted:#a9bdcd;--line:#2d4454;--accent:#8cdaed;--gold:#e2c595;--radius:12px}
html{scroll-padding-top:24px}body{background:radial-gradient(ellipse at 30% 0,#17344466,transparent 52%),var(--bg);line-height:1.85}a,button{-webkit-tap-highlight-color:transparent}button,.button{border-radius:6px;min-height:46px;border-color:#405767;background:#182b38;font-size:.9rem;padding:11px 21px}.primary{color:#0b2732!important;background:var(--accent)!important;border-color:var(--accent)!important;box-shadow:0 3px 22px #88d9ed12}button:hover,.button:hover{background:#254251;border-color:#8cbed0}.quiet-button{border-color:transparent;background:transparent;color:var(--ink)}.quiet-button:hover{background:#1c354355}:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
.app-frame{display:grid;grid-template-columns:224px minmax(0,1fr);min-height:100vh}.workspace{min-width:0}.top{height:100dvh;position:sticky;top:0;z-index:5;display:flex;flex-direction:column;align-items:stretch;flex-wrap:nowrap;padding:32px 20px 22px;gap:0;border:0;border-inline-end:1px solid var(--line);background:linear-gradient(175deg,#111d28,#090f17)}
.brand{gap:12px;font-size:1.9rem;font-weight:600;line-height:1.2}.brand small{font:8px/2 'Segoe UI',sans-serif;letter-spacing:1.4px;color:#9fbdcc;display:block;margin-top:8px}.orbit{width:43px;height:48px;border:1px solid #6593a9;border-radius:3px;transform:rotate(-6deg);font-size:2rem;background:linear-gradient(135deg,#29455466,#13233155);box-shadow:0 0 27px #57c7e31a;flex-shrink:0}.edition{border-bottom:1px solid var(--line);padding:15px 0 24px;margin:0;color:var(--muted);font-size:.75rem}
nav{display:grid;gap:8px;margin:26px 0 0;width:100%}nav a{display:flex;align-items:center;gap:12px;padding:12px 10px;min-height:48px;border:1px solid transparent;border-radius:5px;font-size:.88rem;white-space:nowrap}nav a svg{width:19px;height:19px;flex-shrink:0}nav a.active{color:var(--accent);background:linear-gradient(270deg,#23455299,transparent);border-color:#385567;box-shadow:inset -2px 0 var(--accent)}nav a:hover{color:var(--ink);background:#1a2d3a}nav a:last-child{margin-top:22px;border-top-color:var(--line);border-radius:0}.rail-foot{margin-top:auto;padding-top:24px;border-top:1px solid var(--line)}.rail-sign{font:10px ui-monospace,monospace;letter-spacing:4px;color:var(--accent)}.rail-foot p{font-size:1.05rem;line-height:1.8;margin:14px 0}.rail-foot small{font-size:.7rem;color:var(--muted)}
.workspace-bar{display:flex;justify-content:space-between;align-items:center;min-height:76px;padding:18px 38px;gap:18px;border-bottom:1px solid var(--line);font-size:.8rem;background:#0a121b99;color:var(--muted)}.bar-home{text-decoration:none;color:var(--muted)}.divider{margin:0 13px;color:#627f92}.workspace-bar strong{font-weight:500}.course-badge{display:flex;align-items:center;gap:9px;font:12px 'Segoe UI',sans-serif;color:#b5cad8}.course-badge b{width:26px;height:28px;display:grid;place-items:center;background:#223e58;border:1px solid #456b88;border-radius:4px;font-size:15px}.prototype-badge{font:11px Plex;color:var(--gold);border:1px solid #665636;background:#30291c88;border-radius:4px;padding:4px 8px;margin-inline-start:10px}
.shell{max-width:1640px;padding:34px 38px 65px;grid-template-columns:minmax(0,1fr) 254px;gap:32px;align-items:start}#main{min-width:0;grid-column:1;grid-row:1}#sidebar{grid-column:2;grid-row:1;position:sticky;top:24px;border:1px solid #2c4455;border-radius:8px;padding:20px 15px;max-height:calc(100dvh - 48px);overflow:auto;scrollbar-width:thin;scrollbar-color:#3a5467 transparent;background:#101c2688}
body:not([data-view=learn]) .shell{display:block;max-width:1360px}body:not([data-view=learn]) #sidebar{display:none}body:not([data-view=learn]) #main{max-width:1100px;margin:auto}
.shelf-title{padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid var(--line)}.shelf-title strong{font-size:1rem}.shelf-title span{font-size:.75rem}.unit{border-top:0;border-bottom:1px solid #293e4d;padding:4px 0}.unit:last-child{border-bottom:0}.unit summary{font-size:.85rem;line-height:1.8;padding:14px 2px;gap:8px}.unit summary small{margin-inline-start:auto;font:10px ui-monospace,monospace;color:var(--muted)}.unit[open]>summary{color:var(--accent)}.lesson-link{font-size:.8rem!important;line-height:1.85;padding:11px 8px!important;margin:3px 0;border-radius:5px!important;gap:8px;color:var(--muted)}.lesson-link.current{background:#1b3949;color:#e0f6ff;border-color:#436f82;box-shadow:inset -2px 0 var(--accent)}.lesson-link .n{font:10px/2.5 ui-monospace,monospace;color:#8fb8ca}.side-note{font-size:.7rem;line-height:1.8;color:#9ab0c2;border-top:1px solid var(--line);margin-top:20px;padding-top:20px;margin-bottom:0}
h1{font-size:clamp(1.8rem,2.5vw,2.65rem);font-weight:600;line-height:1.5;letter-spacing:-.5px}h2{font-weight:600}.eyebrow{font-size:.73rem;color:var(--accent);letter-spacing:.4px}.tiny-square{display:inline-block;width:5px;height:5px;background:var(--accent);margin-inline-end:8px;box-shadow:0 0 12px #8cdaed88}
