const oldOpenLesson=root.openLesson,oldLessonProgress=root.lessonProgress,oldLearningRender=learningRender,oldCloneLab=cloneLab;
cloneLab=function(id,helper=false){const source=lab(id),n=oldCloneLab(id,helper);if(source.practical){n.practical=clone(source.practical);n.practical.checks={};n.practical.observations=[];n.practical.history=[...(n.practical.history||[]),{at:new Date().toISOString(),help:clone(n.practical.help),copied:true}];n.practical.help=[];n.practical.responses={};n.practical.copied=true;n.practical.result=null;changed();practicalRender(true);}return n;};
root.openLesson=async lesson=>{
 const l=practicalBy(lesson?.id);if(!l)return oldOpenLesson(lesson);
 if(window.MADAR_ALLOWED_PRACTICAL&&!window.MADAR_ALLOWED_PRACTICAL.includes(l.id))throw Error('هذا الدرس غير متاح حاليًا.');
 if(root.dataset.ready!=='true'||restoreFailure)throw Error('انتظر استعادة المختبرات.');
 const c='practical-'+l.id,id='original-'+c;courseNames[c]=l.title;
 let n=lab(id);if(!n){if(state.labs.length>=100)throw Error('وصلت للحد الأقصى للمختبرات. احفظ نسخة احتياطية قبل حذف ما لا تحتاجه.');capture();const prior=clone(active().data);let data;loading=true;try{data=B.practical.fresh(l);}finally{B.restore(prior);loading=false;}n=makeLab(id,l.title,'original',data,c);n.aliases=clone(l.aliases);n.practical={catalogVersion:3,lesson:l.id,index:0,checks:{},observations:[],help:[],result:null};state.labs.push(n);}
 for(const saved of state.labs.filter(x=>x.practical?.lesson===l.id)){const p=saved.practical;if(p.catalogVersion!==3){const oldId=p.catalogVersion===2?l.previousStageIds[p.index]:l.id+'-s'+String(p.index+1).padStart(2,'0');p.index=Math.max(0,l.stages.findIndex(s=>s.id===oldId));p.catalogVersion=3;p.finalVerified=null;const revised=l.id.endsWith('01')?['s10']:l.id.endsWith('07')?['s14','s19','s24','s31','s32']:l.id.endsWith('08')?['s04','s07']:[];for(const suffix of revised){const key=l.id+'-'+suffix;if(p.checks[key]){p.history??=[];p.history.push({at:new Date().toISOString(),recheckAfterSourceAudit:key,priorCheck:clone(p.checks[key])});delete p.checks[key];}}}}lessonContext=null;state.openLessonId=l.id;activate(active()?.practical?.lesson===l.id?active().id:id);practicalRender(true);await root.flushSave?.();
};
root.lessonProgress=()=>{const p=practicalState();if(!p)return oldLessonProgress();if(dirty||saving)return null;const l=practicalBy(p.lesson);return {lesson:l.id,step:p.index,stepTitle:l.stages[p.index].title,stepTotal:l.stages.length,labStep:l.stages[p.index].id,completed:Object.keys(p.checks).length===l.stages.length&&window.MadarPractical.reviewsReady(l,p)&&p.finalVerified===active().revision};};
