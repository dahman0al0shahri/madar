learningRender=function(){oldLearningRender();practicalRender();};
engine.addEventListener('labs:practical-command',e=>{const p=practicalState();if(!p||loading)return;const owner=active(),record={...e.detail,step:practicalBy(p.lesson).stages[p.index].id};p.observations.push(record);p.observations=p.observations.slice(-2000);queueMicrotask(()=>{record.revision=owner.revision;if(active()===owner)changed('metadata');});});
for(const l of practicalCatalog)courseNames['practical-'+l.id]=l.title;
root.practicalProgress=()=>practicalState()?clone(practicalState()):null;

const practicalOldRestart=$('#ml-restart').onclick,practicalOldHistory=$('#ml-history').onclick;
$('#ml-restart').onclick=()=>{const a=active(),p=a.practical;if(!p)return practicalOldRestart();if(B.busy())return toast('أكمل توصيل الكابل أولًا.');modal('إعادة هذا المختبر من البداية؟','<p>ستُزال إعدادات هذه المحاولة وكابلاتها. يبقى سجل المساعدات وملخص الفحوص السابقة محفوظًا، ولا تتغير بقية مختبراتك. لا يمكن التراجع عن الإعادة.</p><button id="mp-restart-cancel">احتفظ بمحاولتي</button><button id="mp-restart-confirm">أعد هذا المختبر</button>');$('#mp-restart-cancel').onclick=close;$('#mp-restart-confirm').onclick=()=>{if(active().id!==a.id||B.busy())return;const l=practicalBy(p.lesson);p.history??=[];p.history.push({at:new Date().toISOString(),checks:clone(p.checks),help:clone(p.help),responses:clone(p.responses||{}),copied:!!p.copied});loading=true;try{a.data=B.practical.fresh(l);}finally{loading=false;}Object.assign(p,{index:0,checks:{},observations:[],help:[],responses:{},result:null,finalVerified:null,copied:false});a.aliases=clone(l.aliases);a.revision++;a.undo=null;a.configUndo=null;a.logs=[];a.results=[];a.copied=false;clearTimeout(pendingPings.get(a.id));pendingPings.delete(a.id);close();changed();render();practicalRender(true);};};
$('#ml-history').onclick=()=>{const p=practicalState();if(!p)return practicalOldHistory();const rows=[...(p.history||[]).flatMap(x=>x.help||[]),...p.help];modal('سجل مساعدات التطبيق العملي','<p>كل كشف مختلف محفوظ بدرجته ونصه. إعادة القراءة لا تزيد عدد المساعدات. هذا السجل لا يثبت إتقانًا أو ضعفًا.</p>'+ (rows.length?rows.map(r=>'<details><summary>'+esc(r.step)+' · كشف كامل 4 · '+esc(new Date(r.at).toLocaleString('ar-SA'))+'</summary><pre style="white-space:pre-wrap">'+esc(r.body||'نص غير محفوظ في هذه النسخة السابقة')+'</pre></details>').join(''):'<p>لم تُسجّل مساعدة في هذا المختبر.</p>'));};
