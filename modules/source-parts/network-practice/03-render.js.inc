function practicalRender(force=false){
 const p=practicalState(),l=p&&practicalBy(p.lesson);root.classList.toggle('mp-active',!!l);practicalTop.hidden=!l;wire.hidden=!l;deviceBar.hidden=!l;
 referenceHost.hidden=!l;if(practicalScope)practicalScope.textContent=l?.limits||priorScope;if(!l){practicalRenderKey='';return;}const s=l.stages[p.index]||l.stages[0],key=active().id+'|'+s.id;const picker=$('#mp-lab');if(picker.dataset.lesson!==l.id){picker.value=l.id;picker.dataset.lesson=l.id;}lessonGuide.hidden=true;
 if(force||key!==practicalRenderKey){practicalRenderKey=key;
  practicalTop.innerHTML='<div class="mp-heading"><div><span class="ml-kicker">تطبيق عملي · '+esc(l.source.match(/\d+(?:\.\d+)+/)?.[0]||'الإعداد الأساسي')+'</span><h2>'+esc(l.title)+'</h2></div><span id="mp-progress"></span></div><div class="mp-taskbar"><label>المهمة الحالية<select id="mp-step">'+l.stages.map((x,i)=>'<option value="'+i+'" '+(i===p.index?'selected':'')+'>'+String(i+1).padStart(2,'0')+' · '+esc(x.title)+'</option>').join('')+'</select></label><button id="mp-prev" '+(!p.index?'disabled':'')+'>السابق</button><button id="mp-next" '+(p.index===l.stages.length-1?'disabled':'')+'>التالي</button></div><div class="mp-current"><div><h3>'+esc(s.title)+'</h3><p>'+esc(s.detail)+'</p><ul>'+practicalRequirements(s).map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul></div><aside><button id="mp-focus" '+(!s.device?'hidden':'')+'>افتح '+esc(l.aliases[s.device]||s.device||'الجهاز')+'</button><button id="mp-check" class="mp-primary">تحقّق من التطبيق</button><button id="mp-help" '+(['wire','pc'].includes(s.kind)?'hidden':'')+'>كشف الخطوة كاملة · مساعدة 4</button><small '+(['wire','pc'].includes(s.kind)?'hidden':'')+'>الكشف يعرض الأوامر ولا ينفّذها. يُسجّل كمساعدة كاملة.</small></aside></div><div id="mp-result" role="status"></div><div id="mp-help-body" hidden></div><section class="mp-reference"><div class="mp-table"><h3>العناوين المطلوبة</h3><table>'+l.addresses.map((row,i)=>'<tr>'+row.map(v=>'<'+(i?'td':'th')+'>'+esc(v)+'</'+(i?'td':'th')+'>').join('')+'</tr>').join('')+'</table></div><div><h3>التوصيلات المطلوبة</h3><ul class="mp-links" dir="ltr">'+l.links.map(pair=>'<li>'+pair.map(esc).join(' ↔ ')+'</li>').join('')+'</ul><p>أسماء PC1 وPC2 وPC3 تقابل PC-A وPC-B وPC-C. منفذ G0/0/1 في المصادر يقابل G0/1 في هذا الطراز، ويقبل المحاكي الاسمين.</p></div></section><details class="mp-source"><summary>شرح الجزء والمصدر وحدود المحاكاة</summary>'+l.topics.filter(t=>t.title===s.topic).map(t=>t.paragraphs.map(x=>'<p>'+esc(x)+'</p>').join('')+(t.note?'<p>'+esc(t.note)+'</p>':'')).join('')+(l.notices?.length?'<h4>تدقيق المصدر وتكييفه للمحاكي</h4>'+l.notices.map(x=>'<p>'+esc(x)+'</p>').join(''):'')+'<p>'+esc(l.limits)+'</p><a href="'+l.sourceFile+'" target="_blank" rel="noopener">افتح المصدر الكامل</a></details>';
  referenceHost.replaceChildren(practicalTop.querySelector('.mp-reference'),practicalTop.querySelector('.mp-source'));renderSourceReview(l,s,p);
