  $('#mp-step').onchange=e=>go(+e.target.value);$('#mp-prev').onclick=()=>go(p.index-1);$('#mp-next').onclick=()=>go(p.index+1);$('#mp-focus').onclick=()=>{B.select(s.device);$('#nf-cli').open=true;$('#nf-command')?.focus({preventScroll:true});};
  $('#mp-check').onclick=()=>{capture();let r;try{r=B.practical.check(l,p.index,['console','initialize'].includes(s.kind)?p.observations:p.observations.filter(o=>o.revision===active().revision));}catch(err){r={ok:false,issues:['تعذر الفحص: '+err.message]};}if(r.ok&&!window.MadarPractical.reviewsReady(l,p,s))r={ok:false,issues:['طابق الإعداد المطلوب؛ بقي حفظ ملاحظتك ومراجعتها ذاتيًا في أسئلة المصدر أدناه.']};p.result=r;if(r.ok)p.checks[s.id]={at:new Date().toISOString(),help:p.help.filter(h=>h.step===s.id).length,revision:active().revision};else delete p.checks[s.id];if(r.ok&&Object.keys(p.checks).length===l.stages.length&&window.MadarPractical.reviewsReady(l,p)){const final=B.practical.check(l,l.stages.length-1,['console','initialize'].includes(s.kind)?p.observations:p.observations.filter(o=>o.revision===active().revision));p.finalVerified=final.ok?active().revision:null;if(!final.ok)p.result={ok:false,issues:['فُحصت المهام، لكن الإعداد النهائي تغيّر. راجع آخر مهمة والحفظ النهائي.',...final.issues]};}changed();root.dispatchEvent(new CustomEvent('labs:configuration-check',{detail:{lesson:l.id,step:s.id,ok:r.ok}}));practicalRender();};
  $('#mp-help').onclick=()=>{const found=p.help.some(h=>h.step===s.id);if(!found){const record={step:s.id,degree:4,full:true,at:new Date().toISOString()};p.help.push(record);root.dispatchEvent(new CustomEvent('labs:help-exposure',{detail:{level:4,step:s.id,lesson:l.id,full:true}}));changed();}const target=$('#mp-help-body');target.hidden=false;let commands=s.commands?.filter(c=>c!=='enable')||[s.command||''];if(s.kind==='cli'&&!/^(configure terminal|show |copy )/.test(commands[0]))commands=['configure terminal',...commands];if(s.kind==='initialize')commands=['erase startup-config','[Enter]',...(l.devices[s.device]==='S'?['delete vlan.dat','[Enter]','[Enter]']:[]),'reload','no','[Enter]'];if(s.kind==='console')commands=['PC RS232 → '+s.device+' Console','Terminal: 9600 / 8 / None / 1 / None','Open Terminal'];if(s.kind==='save')commands=['copy running-config startup-config','[Enter لتأكيد اسم الملف]','show startup-config'];if(s.kind==='channel')commands=['show etherchannel summary','show spanning-tree'];if(s.kind==='clock')commands=['clock set HH:MM:SS DAY MONTH YEAR','show clock'];const intro=s.kind==='console'?'هذه الخطوة من أدوات Terminal؛ لا تبدأ بأوامر IOS قبل فتح الاتصال.':'ابدأ من Privileged EXEC: استخدم enable إن كان الرمز &gt;، أو end إن كنت داخل Configuration. أدخل كلمة المرور المختبرية إن طُلبت. نفّذ على الجهاز '+esc(s.device||'المطلوب')+'.';target.innerHTML='<strong>كشف الخطوة كاملة — مساعدة مسجّلة</strong><p>'+intro+'</p><pre dir="ltr">'+esc(commands.filter(Boolean).join('\n')||(s.kind==='wire'?l.links.map(x=>x.join(' ↔ ')).join('\n'):JSON.stringify(s.pc,null,2)))+'</pre><button id="mp-hide-help">إخفاء الحل</button>';const record=p.help.find(h=>h.step===s.id);if(record&&!record.body){record.body=target.innerText;changed();}$('#mp-hide-help').onclick=()=>target.hidden=true;};
  const options=Object.entries(l.devices).flatMap(([d,t])=>[...window.MadarPractical.ports(t),t==='PC'?'RS232':'Console'].filter(n=>t==='R'?l.id.endsWith('08')||!n.startsWith('S0/'):true).map(n=>'<option value="'+d+':'+n+'">'+esc((l.aliases[d]||d)+' / '+n)+'</option>')).join('');
  wire.innerHTML='<details '+(s.kind==='wire'?'open':'')+'><summary>توصيل كابل يدويًا</summary><p>اختر الطرفين بنفسك. يمكنك أيضًا توصيلهما بالسحب في المشهد.</p><ul class="mp-links" dir="ltr">'+l.links.map(pair=>'<li>'+pair.map(esc).join(' ↔ ')+'</li>').join('')+'</ul><div><label>الطرف الأول<select id="mp-end-a">'+options+'</select></label><label>الطرف الثاني<select id="mp-end-b">'+options+'</select></label><label>نوع الكابل<select id="mp-cable-kind"><option value="auto">تلقائي حسب المنفذين</option value="straight">Ethernet Straight-Through</option><option value="crossover">Ethernet Crossover</option><option value="console">Console</option><option value="serial">Serial</option></select></label><label>طرف DCE عند Serial<select id="mp-dce"><option value="b">الطرف الثاني</option><option value="a">الطرف الأول</option></select></label><button id="mp-connect">وصّل الطرفين</button><button id="mp-disconnect">افصل الطرف الأول</button></div><span id="mp-wire-result" role="status"></span></details>';
  $('#mp-connect').onclick=()=>{const r=B.practical.connect($('#mp-end-a').value,$('#mp-end-b').value,$('#mp-cable-kind').value,$('#mp-dce').value==='a'?$('#mp-end-a').value:$('#mp-end-b').value);$('#mp-wire-result').textContent=r.ok?'تم التوصيل. تحقّق من اختيار المنفذين الصحيحين.':r.message;};$('#mp-disconnect').onclick=()=>{$('#mp-wire-result').textContent=B.practical.disconnect($('#mp-end-a').value)?'فُصل الكابل؛ يمكنك التراجع من أدوات الشبكة.':'لا يوجد كابل على هذا المنفذ.';};
 }
 $('#mp-progress').textContent=Object.keys(p.checks).length+' / '+l.stages.length+' مهمة فُحصت'+(l.questionCount?' · '+Object.values(p.responses||{}).filter(x=>x.reviewed&&x.draft===x.text).length+' / '+l.questionCount+' ملاحظة روجعت ذاتيًا':'');const r=p.result;$('#mp-result').dataset.ok=r?.ok?'true':'false';$('#mp-result').textContent=r?(r.ok?'طابق تطبيقك متطلبات هذه المهمة. انتقل للتالية عندما تنتهي من فحص الناتج.':r.issues.slice(0,5).join('\n')+(r.issues.length>5?'\nوبقية المتطلبات غير المكتملة راجعها أعلاه.':'')):'';
