$('.ml-top').after(practicalPicker);const practicalOpen=document.createElement('button');practicalOpen.id='mp-open-lab';practicalOpen.type='button';practicalOpen.textContent='افتح المختبر';practicalPicker.append(practicalOpen);practicalOpen.onclick=async()=>{const id=$('#mp-lab').value;if(!id)return;practicalOpen.disabled=true;try{await root.flushSave?.();if(parent!==window)parent.postMessage({type:'madar-network-navigate',lesson:id},location.origin);else location.assign('/network-lab?lesson='+encodeURIComponent(id));}catch(err){toast('تعذر حفظ المختبر قبل الانتقال: '+err.message);}finally{practicalOpen.disabled=false;}};
$('.ml-top h2').textContent='افهمها بيدك. خطوة، ثم نتيجة.';
