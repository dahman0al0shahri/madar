const practicalCatalog=window.MadarPracticalCatalog,practicalBy=id=>practicalCatalog.find(l=>l.id===id),practicalState=()=>active()?.practical;
const practicalScope=engine.querySelector('footer'),priorScope=practicalScope?.textContent;
const practicalTop=document.createElement('section');practicalTop.id='mp-practice';$('.ml-tabs').before(practicalTop);
