function practicalRequirements(s){
 if(s.kind==='console')return ['افتح أدوات Console وTerminal أسفل المهمة، ثم وصّل وافتح جلسة الجهاز المطلوب.'];if(s.kind==='initialize')return ['تهيئة هذا الجهاز فقط: امسح startup-config، واحذف vlan.dat في Switch، ثم reload دون حفظ الإعداد القديم.','هذه الخطوة تمسح إعداد الجهاز المختبري عند تنفيذها. لا تعِدها بعد إكمال إعدادات الدرس إلا إذا أردت البدء من الصفر.'];if(s.kind==='pc')return ['عنوان IPv4: '+s.pc.ip,'القناع: '+s.pc.mask,'البوابة: '+(s.pc.gateway||'اتركها فارغة')];
 const rules=[];for(const c of s.commands||[]){let m;
  if(m=c.match(/^hostname (.+)/))rules.push('اسم الجهاز: '+m[1]);else if(c==='no ip domain-lookup')rules.push('أوقف بحث DNS عن الأسماء.');else if(m=c.match(/^enable (?:secret|password) (.+)/))rules.push('كلمة مرور Privileged EXEC: '+m[1]);else if(m=c.match(/^line (.+)/))rules.push('الخط المطلوب: '+m[1]);else if(m=c.match(/^password (.+)/))rules.push('كلمة مرور الخط: '+m[1]);else if(c==='login')rules.push('فعّل طلب كلمة مرور الخط.');else if(c==='logging synchronous')rules.push('فعّل مزامنة رسائل Console مع سطر الكتابة.');else if(c==='service password-encryption')rules.push('أخفِ كلمات المرور النصية في عرض الإعداد.');else if(m=c.match(/^banner motd .(.*).$/))rules.push('رسالة الدخول: '+m[1]);else if(m=c.match(/^vlan (.+)/))rules.push('رقم VLAN: '+m[1]);else if(m=c.match(/^name (.+)/))rules.push('اسم VLAN: '+m[1]);else if(m=c.match(/^interface (.+)/))rules.push('الواجهة / المجموعة: '+m[1]);else if(m=c.match(/^description (.+)/))rules.push('وصف الواجهة: '+m[1]);else if(m=c.match(/^ip address (.+)/))rules.push('العنوان والقناع: '+m[1]);else if(m=c.match(/^ip default-gateway (.+)/))rules.push('بوابة إدارة Switch: '+m[1]);else if(c==='no shutdown')rules.push('فعّل الواجهة إداريًا.');else if(c==='shutdown')rules.push('أغلق الواجهات المحددة إداريًا.');else if(m=c.match(/^switchport mode (.+)/))rules.push('وضع المنفذ: '+m[1]);else if(m=c.match(/^switchport access vlan (.+)/))rules.push('Access VLAN: '+m[1]);else if(m=c.match(/^switchport trunk native vlan (.+)/))rules.push('Native VLAN: '+m[1]);else if(m=c.match(/^switchport trunk allowed vlan (.+)/))rules.push('VLAN المسموح بعبورها: '+m[1]);else if(m=c.match(/^encapsulation dot1Q (.+)/i))rules.push('وسم 802.1Q: '+m[1]);else if(m=c.match(/^channel-group (\d+) mode (.+)/))rules.push('مجموعة EtherChannel '+m[1]+'، وضع التفاوض '+m[2]);else if(m=c.match(/^clock rate (.+)/))rules.push('ساعة طرف DCE: '+m[1]);else if(m=c.match(/^(no )?ip route (.+)/))rules.push((m[1]?'احذف المسار: ':'أضف مسارًا إلى الشبكة / القناع / الوجهة التالية: ')+m[2]);else if(c.startsWith('show '))rules.push('افحص الناتج: '+c);else if(c.startsWith('copy '))rules.push('احفظ إعداد الجهاز في startup-config وأكّد اسم الملف.');
 }return [...new Set(rules)];
}
