<style>
#madar-review-assistance{--mr-bg:#101315;--mr-panel:#191e22;--mr-ink:#f4ede3;--mr-muted:#b4b5b8;--mr-copper:#d4a474;--mr-line:#343a3e;--mr-degree:#ffad56;--mr-count-color:#48b7f5;background:var(--mr-bg);color:var(--mr-ink);font-family:Tahoma,Arial,sans-serif;border-radius:22px;max-width:720px;margin:auto;padding:26px;box-sizing:border-box;color-scheme:dark}
#madar-review-assistance *{box-sizing:border-box}#madar-review-assistance .mr-header{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding-bottom:22px;border-bottom:1px solid var(--mr-line);font-size:12px}#madar-review-assistance .mr-brand{color:var(--mr-copper);font-size:17px}#madar-review-assistance .mr-brand span{font-size:12px;color:var(--mr-muted)}#madar-review-assistance .mr-demo{color:var(--mr-muted);align-self:center}
