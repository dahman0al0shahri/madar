#madar-review-assistance .mr-summary{display:grid;grid-template-columns:165px minmax(0,1fr);gap:26px;align-items:center;padding:24px}#madar-review-assistance .mr-pyramid-wrap{display:flex;align-items:center;flex-direction:column;gap:7px}#madar-review-assistance .mr-pyramid{width:144px;height:133px;overflow:visible}#madar-review-assistance .mr-shell{fill:#232319;stroke:#f3cf65;stroke-width:2;stroke-linejoin:round}#madar-review-assistance .mr-layers path{fill:#383a36;transition:fill .45s ease,filter .45s ease}#madar-review-assistance .mr-pyramid-label{font-size:12px;color:var(--mr-muted)}#madar-review-assistance #mr-need{font-size:16px;font-weight:500;color:var(--mr-ink)}#madar-review-assistance .mr-model{font-size:11px;color:var(--mr-muted)}
