function enterMode(){document.body.classList.toggle('exam-running',active());document.body.classList.toggle('exam-mode',!!state.exam);panel.querySelector('.mode-badge').textContent=active()?'English exam':state.exam?'نتيجة الاختبار':'وضع المذاكرة';for(const sel of ['.study-tools','.exam-setup','.study-help','#review-counts'])panel.querySelector(sel).hidden=!!state.exam;panel.querySelector('.exam-controls').hidden=!state.exam;document.querySelector('#submit-exam').hidden=!active();for(const el of [chapter,search,arabic,grade,document.querySelector('#hide')])el.disabled=active();grade.hidden=!!state.exam;document.querySelector('#import-progress').disabled=active();for(const q of qs){if(state.exam?.ids.includes(q.dataset.qid))examHost.append(q);else anchors.get(q.dataset.qid).after(q);render(q);}if(state.exam)for(const id of state.exam.ids)examHost.append(byId.get(id));syncTranslation();tally();applyFilters();}
 document.querySelector('#start-exam').onclick=()=>{const ids=qs.filter(q=>chapter.value==='all'||q.dataset.chapter===chapter.value).map(q=>q.dataset.qid);for(let i=ids.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ids[i],ids[j]]=[ids[j],ids[i]];}const n=document.querySelector('#exam-count').value;state.exam={id:'exam-'+Date.now(),startedAt:new Date().toISOString(),ids:ids.slice(0,n==='all'?ids.length:+n),responses:{},submitted:false};search.value='';enterMode();save();panel.scrollIntoView({behavior:'smooth'});};
 document.querySelector('#submit-exam').onclick=()=>{if(!active())return;const e=state.exam,partial=e.ids.find(id=>{const r=e.responses[id];return r?.choices.length&&r.choices.length!==expected(byId.get(id)).length;});if(partial){const q=byId.get(partial),r=q.querySelector('.response-result');r.hidden=false;r.textContent='Choose exactly two answers before submitting.';q.scrollIntoView({block:'center'});return;}const blank=e.ids.filter(id=>!e.responses[id]?.choices.length).length;if(blank&&!confirm(`بقي ${blank} سؤالًا دون إجابة. تسليم الدفعة الآن؟`))return;for(const id of e.ids){const r=e.responses[id];if(r?.choices.length)r.graded=true;}e.submitted=true;state.history.push({event:'exam',examId:e.id,submittedAt:new Date().toISOString(),answers:e.ids.map(id=>historyAnswer(byId.get(id),e.responses[id]||fresh()))});for(const id of e.ids){const r=e.responses[id];if(r?.choices.length)state.study[id]={...r,choices:[...r.choices]};}enterMode();for(const id of e.ids)revealDetails(byId.get(id));save();panel.scrollIntoView({behavior:'smooth'});};
 document.querySelector('#leave-exam').onclick=()=>{if(active()&&!confirm('العودة للمذاكرة دون تصحيح الاختبار الحالي؟'))return;if(active())state.history.push({event:'exam_abandoned',at:new Date().toISOString(),exam:state.exam});state.exam=null;enterMode();save();};
 document.querySelector('#export-progress').onclick=()=>{const blob=new Blob([JSON.stringify({...state,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='SRWE-progress-'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),2000);msg.textContent='بدأ تنزيل نسخة التقدم بصيغة JSON. احتفظ بها لاستعادتها من الزر المجاور.';};
 document.querySelector('#import-progress').onclick=()=>document.querySelector('#progress-file').click();document.querySelector('#progress-file').onchange=async e=>{const file=e.target.files[0];e.target.value='';if(!file)return;try{if(file.size>5*1024*1024)throw Error('ملف التقدم أكبر من الحد المسموح: 5 MB.');const clean=validate(JSON.parse(await file.text()));if(!confirm(`استعادة نسخة فيها ${Object.keys(clean.study).length} سؤالًا محفوظًا؟ ستستبدل الحالة الحالية؛ يمكنك إلغاء العملية وحفظ نسخة منها أولًا.`))return;state=clean;translated.clear();qs.forEach(q=>{q.classList.remove('show-translation');q.querySelector('details').open=false;});enterMode();save();msg.textContent='تمت استعادة التقدم. الدرجات محسوبة من الإجابات وفق مفتاح البنك الحالي.';}catch(err){msg.textContent='لم تُستعد النسخة ولم يتغير تقدمك: '+(err instanceof SyntaxError?'الملف ليس JSON صالحًا.':err.message);}};
 enterMode();
})();
