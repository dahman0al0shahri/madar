function validRecords(data){if(!data||typeof data!=='object'||Array.isArray(data))throw Error('صيغة الإجابات غير صحيحة.');const out={};for(const [id,r] of Object.entries(data)){if(!byId.has(id)||!r||!Array.isArray(r.choices)||r.choices.length>4||r.choices.some(x=>!Number.isInteger(x)||x<0||x>3)||new Set(r.choices).size!==r.choices.length)throw Error('ملف التقدم يحتوي سؤالًا أو اختيارًا غير صالح.');const choices=[...r.choices].sort();if(r.graded&&choices.length!==expected(byId.get(id)).length)throw Error('إجابة مصححة غير مكتملة في الملف.');out[id]={choices,graded:r.graded===true,revealed:r.revealed===true,translationUsed:r.translationUsed===true,previouslyExposed:r.previouslyExposed===true};}return out;}
 function validate(data){if(data?.version!==2||data.bank!==BANK)throw Error('هذا الملف ليس نسخة تقدم متوافقة مع بنك الشابترات 4 و5 و6.');const clean={version:2,bank:BANK,study:validRecords(data.study),history:[],exam:null};if(!Array.isArray(data.history)||data.history.length>10000)throw Error('سجل النسخة غير صالح أو كبير جدًا.');clean.history=JSON.parse(JSON.stringify(data.history));
 if(data.exam!==null&&data.exam!==undefined){const e=data.exam;if(!Array.isArray(e.ids)||!e.ids.length||e.ids.length>84||new Set(e.ids).size!==e.ids.length||e.ids.some(id=>!byId.has(id)))throw Error('دفعة الاختبار غير صالحة.');const er=validRecords(e.responses);if(Object.keys(er).some(id=>!e.ids.includes(id)))throw Error('إجابة خارج دفعة الاختبار.');clean.exam={id:typeof e.id==='string'?e.id.slice(0,80):'restored',ids:[...e.ids],responses:er,submitted:e.submitted===true,startedAt:typeof e.startedAt==='string'?e.startedAt:null};if(!clean.exam.submitted&&Object.values(er).some(r=>r.graded||r.revealed))throw Error('اختبار غير مسلّم يحتوي حلولًا مكشوفة.');}return clean;}
 try{const raw=localStorage.getItem(KEY);if(raw)state=validate(JSON.parse(raw));else{const old=JSON.parse(localStorage.getItem(OLD)||'null');if(old?.version===1){state.study=validRecords(old.responses||{});state.history=Array.isArray(old.history)?old.history:[];}}}catch{msg.textContent='تعذر قراءة الحفظ السابق؛ لم يُحذف. يمكنك استعادة نسخة تقدم صالحة.';}
 