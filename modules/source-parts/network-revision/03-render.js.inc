function render(q){const r=rec(q),ans=expected(q),done=r.graded||!!state.exam?.submitted,openable=done||r.revealed;
 q.querySelectorAll('.choice-input').forEach((input,i)=>{input.checked=r.choices.includes(i);input.disabled=done;const row=input.closest('li');row.classList.toggle('selected',input.checked);row.classList.toggle('correct-choice',done&&ans.includes(i));row.classList.toggle('wrong-choice',done&&input.checked&&!ans.includes(i));row.querySelector('.choice-result')?.remove();if(done&&(ans.includes(i)||input.checked)){const tag=document.createElement('span');tag.className='choice-result';tag.textContent=ans.includes(i)?'Correct · الإجابة الصحيحة':'Your answer · اختيارك غير الصحيح';row.append(tag);}});
 const result=q.querySelector('.response-result');result.hidden=!done;const correct=equal(r.choices,ans);result.classList.toggle('incorrect',done&&!correct);result.textContent=done?(!r.choices.length?'Unanswered — لم تجب عن هذا السؤال.':correct?'Correct — إجابتك صحيحة.':'Incorrect — إجابتك غير صحيحة. راجع الشرح أدناه.')+(r.revealed?' تدريب بعد كشف الحل؛ خارج النتيجة.':''):'';
 const solution=q.querySelector('.solution');solution.hidden=!openable||active();if(solution.hidden)solution.open=false;q.querySelector('.confirm-answer').disabled=r.graded;q.querySelector('.question-actions').hidden=!!state.exam;q.querySelector('.source').hidden=active();q.querySelector('.translate-question').hidden=active();q.querySelector('.qhead span:last-child').textContent=active()?(ans.length===2?'Choose two':'Choose one'):q.originalQuestionType;if(active())q.classList.remove('show-translation');updateTranslation(q);}
 