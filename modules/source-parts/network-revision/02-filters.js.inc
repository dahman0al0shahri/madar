function rowStatus(q){const r=state.study[q.dataset.qid];return {wrong:!!r?.graded&&!r.revealed&&!equal(r.choices,expected(q)),revealed:!!r?.revealed,unanswered:!r?.choices.length};}
 function applyFilters(){let count=0;const query=search.value.trim().toLowerCase();for(const q of qs){const flags=rowStatus(q),visible=state.exam?state.exam.ids.includes(q.dataset.qid):((chapter.value==='all'||q.dataset.chapter===chapter.value)&&(review==='all'||(review==='retry'?retryIds.has(q.dataset.qid):flags[review]))&&(!query||q.textContent.toLowerCase().includes(query)||q.dataset.qid.includes(query)));q.hidden=!visible;if(visible)count++;}for(const el of document.querySelectorAll('main .cover,main .concept,main .chapter-title,main .reference'))el.hidden=!!state.exam||review!=='all'||!!query|| (!!el.dataset.chapter&&el.dataset.chapter!=='all'&&chapter.value!=='all'&&el.dataset.chapter!==chapter.value);document.querySelector('#empty').hidden=count!==0;status.textContent=`${count} سؤالًا ظاهرًا من 84`;}
 filter=applyFilters;chapter.addEventListener('change',applyFilters);search.addEventListener('input',applyFilters);
 function tally(){if(state.exam){const e=state.exam,answered=e.ids.filter(id=>e.responses[id]?.choices.length).length;document.querySelector('#exam-progress').textContent=`Answered ${answered} / ${e.ids.length}`;if(e.submitted){let correct=0,wrong=0,blank=0;for(const id of e.ids){const r=e.responses[id];if(!r?.choices.length)blank++;else if(equal(r.choices,expected(byId.get(id))))correct++;else wrong++;}score.textContent=`نتيجة الاختبار: ${correct} من ${e.ids.length} صحيحة (${Math.round(correct/e.ids.length*100)}%). غير صحيحة: ${wrong}؛ دون إجابة: ${blank}.`;}else score.textContent='الترجمة والشروح ومراجع الشرائح مخفية حتى تسليم الدفعة. يمكنك تعديل إجاباتك قبل التسليم.';
 }else{const answered=qs.filter(q=>rec(q).choices.length).length,checked=qs.filter(q=>rec(q).graded&&!rec(q).revealed),good=checked.filter(q=>equal(rec(q).choices,expected(q))).length,assisted=qs.filter(q=>rec(q).graded&&rec(q).revealed).length;score.textContent=`أجبت عن ${answered} من 84 سؤالًا. ${checked.length?`نتيجة الأسئلة المصححة: ${good} من ${checked.length} صحيحة، و${checked.length-good} غير صحيحة.`:'لم تُصحح إجابات بعد.'}${assisted?` تدريب بعد كشف الحل: ${assisted} سؤالًا خارج النتيجة.`:''}`;}
 const wrong=qs.filter(q=>rowStatus(q).wrong).length,revealed=qs.filter(q=>rowStatus(q).revealed).length;document.querySelector('#review-counts').textContent=`المراجعة الحالية: ${wrong} إجابة خاطئة · ${revealed} سؤالًا كُشف حله. إعادة التدريب لا تمحو سجل المحاولات السابق.`;}
 function updateTranslation(q){const btn=q.querySelector('.translate-question'),on=q.classList.contains('show-translation');btn.querySelector('span').textContent=on?'إخفاء الترجمة':'ترجمة السؤال';btn.setAttribute('aria-pressed',String(on));}
 function syncTranslation(){const n=qs.filter(q=>q.classList.contains('show-translation')).length;arabic.checked=n===84;arabic.indeterminate=n>0&&n<84;}
 