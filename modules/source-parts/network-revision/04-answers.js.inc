function revealDetails(q){q.querySelector('.solution').hidden=false;q.querySelector('.solution').open=true;window.SRWEVisuals?.mount(q);}
 function historyAnswer(q,r){return {questionId:q.dataset.qid,selected:r.choices.map(i=>'ABCD'[i]),correct:expected(q).map(i=>'ABCD'[i]),isCorrect:equal(r.choices,expected(q)),translationUsed:r.translationUsed,solutionPreviouslyRevealed:r.revealed,previouslyExposed:r.previouslyExposed};}
 function submit(list){const batch={event:'practice',submittedAt:new Date().toISOString(),answers:[]};for(const q of list){const r=rec(q);batch.answers.push(historyAnswer(q,r));r.graded=true;state.study[q.dataset.qid]=r;render(q);revealDetails(q);}state.history.push(batch);save();tally();}
 for(const q of qs){const id=q.dataset.qid,required=expected(q).length,anchor=document.createComment('question '+id);q.before(anchor);anchors.set(id,anchor);q.originalQuestionType=q.querySelector('.qhead span:last-child').textContent;
 const translate=document.createElement('button');translate.type='button';translate.className='translate-question';translate.setAttribute('aria-label',`ترجمة السؤال Q${id} وخياراته`);translate.innerHTML='<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 5h12M9 2v3M6 5c0 5 3 8 7 10M13 5c-1 5-4 9-9 11M14 21l4-11 4 11M15.5 17h5"/></svg><span>ترجمة السؤال</span>';q.querySelector('.stem').before(translate);
 translate.onclick=()=>{if(active())return;q.classList.toggle('show-translation');if(q.classList.contains('show-translation')){translated.add(id);const r=responses()[id];if(r&&!r.graded)r.translationUsed=true;}updateTranslation(q);syncTranslation();save();};
 q.querySelectorAll('.options li').forEach((li,i)=>{const label=document.createElement('label');label.className='choice-label';const input=document.createElement('input');input.type=required===1?'radio':'checkbox';input.name='answer-'+id;input.className='choice-input';input.value=i;input.setAttribute('aria-label',`${'ABCD'[i]}: ${li.querySelector('[lang="en"]').textContent}`);while(li.firstChild)label.append(li.firstChild);label.prepend(input);li.append(label);input.onchange=()=>{const r=rec(q);r.choices=[...q.querySelectorAll('.choice-input:checked')].map(x=>+x.value).sort();r.translationUsed=r.translationUsed||translated.has(id)||q.classList.contains('show-translation');responses()[id]=r;render(q);tally();save();};});
 const actions=document.createElement('div');actions.className='question-actions';actions.innerHTML='<button type="button" class="confirm-answer">تأكيد الإجابة</button><button type="button" class="reveal-answer">عرض الحل والشرح</button>';const result=document.createElement('p');result.className='response-result';result.setAttribute('role','status');q.querySelector('.solution').before(actions,result);
 actions.querySelector('.confirm-answer').onclick=()=>{if(state.exam)return;const r=rec(q);if(r.choices.length!==required){result.hidden=false;result.classList.add('incorrect');result.textContent=required===1?'اختر إجابة واحدة أولًا، ثم أكدها.':'اختر إجابتين بالضبط (Choose two)، ثم أكد إجابتك.';return;}if(!r.graded)submit([q]);};
 actions.querySelector('.reveal-answer').onclick=()=>{if(state.exam)return;const r=rec(q);if(!r.graded){r.revealed=true;state.history.push({event:'solution_revealed',questionId:id,revealedAt:new Date().toISOString()});}state.study[id]=r;render(q);revealDetails(q);save();tally();};q.querySelector('.solution').addEventListener('toggle',()=>{if(q.querySelector('.solution').open&&!active())window.SRWEVisuals?.mount(q);});}
 arabic.addEventListener('change',()=>{if(active()){arabic.checked=false;qs.forEach(q=>q.classList.remove('show-translation'));return;}for(const q of qs){if(arabic.checked){translated.add(q.dataset.qid);const r=responses()[q.dataset.qid];if(r&&!r.graded)r.translationUsed=true;}updateTranslation(q);}arabic.indeterminate=false;save();});
 grade.onclick=()=>{if(state.exam)return;const pending=qs.filter(q=>rec(q).choices.length&&!rec(q).graded),invalid=pending.find(q=>rec(q).choices.length!==expected(q).length);if(invalid){review='all';document.querySelector('#review-filter').value='all';chapter.value='all';search.value='';applyFilters();invalid.querySelector('.confirm-answer').click();invalid.scrollIntoView({behavior:'smooth',block:'center'});return;}if(!pending.length){score.textContent='اختر إجابة جديدة لتصحيحها، أو أعد التدريب على قائمة المراجعة.';return;}submit(pending);score.scrollIntoView({behavior:'smooth',block:'center'});};
 document.querySelector('#review-filter').onchange=e=>{review=e.target.value;applyFilters();};
 function retry(all){if(state.exam)return;const list=all?qs:qs.filter(q=>!q.hidden);if(!list.length){msg.textContent='لا توجد أسئلة في القائمة الحالية.';return;}if(!confirm(`بدء تدريب جديد على ${list.length} سؤالًا؟ تبقى المحاولات السابقة في سجل النسخة.`))return;state.history.push({event:'retry',at:new Date().toISOString(),questionIds:list.map(q=>q.dataset.qid)});for(const q of list){const old=rec(q);state.study[q.dataset.qid]={...fresh(),previouslyExposed:old.graded||old.revealed||old.previouslyExposed};q.querySelector('details').open=false;translated.delete(q.dataset.qid);render(q);}retryIds=new Set(list.map(q=>q.dataset.qid));review=all?'all':'retry';document.querySelector('#review-filter').value=review;save();tally();applyFilters();msg.textContent=`أُعيد تجهيز ${list.length} سؤالًا. لم يُحذف سجل المحاولات السابق.`;}
 document.querySelector('#retry-list').onclick=()=>retry(false);document.querySelector('#new-round').onclick=()=>retry(true);
 