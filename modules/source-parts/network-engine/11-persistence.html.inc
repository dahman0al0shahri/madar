function announce(text){q('#nf-notice').textContent=text;}
function save(){if(!window.openai?.setWidgetState)return;const snap=snapshot();const payload={modelContent:{preview:'معاينة تفاعل مادي؛ ليست أداء متعلم',devices:Object.keys(devices).length,cables:cables.length},privateContent:snap};if(new TextEncoder().encode(JSON.stringify(payload)).length>16000){snap.cli={};if(new TextEncoder().encode(JSON.stringify(payload)).length>16000){q('#nf-save').textContent='تجاوزت الشبكة سعة حفظ المعاينة';return;}}const seq=++savedSeq;q('#nf-save').textContent='جارٍ الحفظ…';Promise.resolve(window.openai.setWidgetState(payload)).then(()=>{if(seq===savedSeq)q('#nf-save').textContent='حُفظت المعاينة';}).catch(()=>{if(seq===savedSeq)q('#nf-save').textContent='تعذّر الحفظ';});}
