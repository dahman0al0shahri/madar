function lessonStep(){if(!lesson)return null;const p=ports[lesson.key];if(!p)return['missing','المنفذ لم يعد موجودًا','اختر منفذًا آخر وابدأ تدريبًا جديدًا.',''];if(cliDevice!==p.id)return['device','ارجع إلى '+p.id,'هذا التدريب مرتبط بهذا الجهاز.','اختر '+p.id+' من المساحة.'];const s=ios.session(p.id);if(lesson.done)return['done','تمت إعادة الاتصال والتحقق منه','قرأت حالة الوصلة بأمر عرض؛ هذا لا يثبت صحة IP أو VLAN.',''];if(!admin[lesson.key]){if(s.mode==='user')return['enable','ادخل وضع Privileged EXEC','لتتمكن من الدخول إلى الإعداد.','ما الأمر الذي ينقلك من > إلى #؟','اكتب enable ثم Enter.'];if(s.mode==='priv')return['config','ادخل Global Configuration','ثم تختار المنفذ المطلوب.','ابحث عن configure.','اكتب configure terminal.'];if(s.mode!=='interface'||s.port!==p.name)return['interface','اختر المنفذ '+p.name,'التعديل يجب أن يكون على المنفذ المطلوب.','استخدم interface مع اسم المنفذ.','اكتب interface '+p.name.toLowerCase()];return['activate','فعّل المنفذ '+p.name,'المنفذ مغلق إداريًا.','no تلغي إعداد الإغلاق.','اكتب no shutdown.'];}return['verify','تحقق بأمر عرض','ابحث عن up في سطر '+fullName(lesson.key)+'؛ هذا فحص للوصلة.','استخدم show ip interface brief، ويسبقه do داخل الإعداد.','اكتب '+(!['user','priv'].includes(s.mode)?'do ':'')+'show ip interface brief'];}
function renderLesson(){const step=lessonStep();q('#nf-step').hidden=!step;q('#nf-learn-start').textContent=lesson?'ابدأ تدريبًا جديدًا للمنفذ المحدد':'ابدأ تدريب هذا المنفذ';q('#nf-learn-start').disabled=busy||!ports[selected]||!cableFor(selected)||!power[cliDevice];if(!step)return;if(step[0]!==lastLessonStep){lastLessonStep=step[0];hintLevel=0;}q('#nf-task').textContent='المطلوب: فعّل '+lesson.key.replace(':',' / ')+' ثم افحص الوصلة.';q('#nf-step-title').textContent=step[1];q('#nf-step-why').textContent=step[2];renderAssistance('port');if(['verify','done'].includes(step[0])){const lines=cliLog.textContent.split('\n');cliLog.replaceChildren();lines.forEach(line=>{const el=document.createElement(line.startsWith(fullName(lesson.key))?'mark':'span');el.textContent=line+'\n';cliLog.append(el);});}}
q('#nf-step-hint').onclick=()=>{hintLevel=Math.min(2,hintLevel+1);renderLesson();};q('#nf-learn-start').onclick=()=>{if(!ports[selected]||!cableFor(selected)||busy)return;assist.newAttempt('port-'+Date.now().toString(36));lesson={key:selected,done:false};lastLessonStep='';admin[selected]=false;const s=ios.session(cliDevice);s.mode='user';s.port=null;trafficUntil=0;invalidatePing();updateUI();save();wake();};
function refreshPingSources(){const el=q('#nf-ping-source'),previous=el.value,ids=Object.keys(devices);if([...el.options].map(o=>o.value).join('|')!==ids.join('|')){el.replaceChildren();for(const id of ids){const o=document.createElement('option');o.value=o.textContent=id;el.append(o);}el.value=ids.includes(previous)?previous:ids.find(id=>devices[id].type==='PC')||ids[0]||'';}}
function invalidatePing(){network.lastPing=null;q('#nf-ping-result').textContent='تغيّر الإعداد؛ أعد اختبار الاتصال.';q('#nf-ping-result').removeAttribute('data-ok');q('#nf-ping-trace').textContent='';trafficUntil=0;}
function displayPing(result){q('#nf-ping-result').dataset.ok=String(result.ok);q('#nf-ping-result').textContent=(result.ok?'نجح الاتصال':'تعذر الاتصال')+' · '+result.source+' → '+result.target+' — '+result.reason;q('#nf-ping-trace').textContent=result.trace.length?result.trace.join('\n'):result.reason;if(result.ok){trafficCables=new Set(result.path);trafficUntil=performance.now()+3200;wake();}renderVlanGuide();}
q('#nf-ping-run').onclick=()=>{const id=q('#nf-ping-source').value;if(!id)return;displayPing(network.ping(id,q('#nf-ping-target').value.trim()));save();};
q('#nf-pc-save').onclick=()=>{if(!pcSelected)return;const ip=q('#nf-pc-ip').value.trim(),mask=q('#nf-pc-mask').value.trim(),gateway=q('#nf-pc-gateway').value.trim();if(!N.hostAddress(ip,mask)||(gateway&&N.ipNumber(gateway)===null)){q('#nf-pc-message').textContent='راجع عنوان الجهاز والقناع والبوابة؛ لم يتغير الإعداد.';return;}network.ensure(pcSelected).pc={ip,mask,gateway};q('#nf-pc-message').textContent='طُبّق إعداد '+pcSelected+(gateway&&!N.sameNet(ip,gateway,mask)?'؛ انتبه: البوابة خارج الشبكة المحلية.':'.');invalidatePing();save();};
function pcCommand(){const input=q('#nf-pc-command'),raw=input.value.trim();input.value='';if(!pcSelected||!raw)return;const pc=network.ensure(pcSelected).pc;let out=[];if(!power[pcSelected])out=['الجهاز مطفأ.'];else if(/^ipconfig(?: \/all)?$/i.test(raw))out=['IP Address........: '+(pc.ip||'0.0.0.0'),'Subnet Mask.......: '+(pc.mask||'0.0.0.0'),'Default Gateway...: '+(pc.gateway||'0.0.0.0')];else if(/^ping\s+\S+$/i.test(raw)){const r=network.ping(pcSelected,raw.split(/\s+/)[1]);displayPing(r);out=[r.ok?'Reply received from '+r.target:'Request timed out.','Packets: Sent = 4, Received = '+(r.ok?4:0)+', Lost = '+(r.ok?0:4),'النتيجة من نموذج الاتصال؛ لا قياس لزمن شبكة حقيقية.'];}else if(/^cls$/i.test(raw)){q('#nf-pc-log').textContent='';save();return;}else out=['الأوامر المتاحة: ipconfig، ipconfig /all، ping <IP>، cls'];q('#nf-pc-log').textContent+=('C:\\> '+raw+'\n'+out.join('\n')+'\n');save();}
q('#nf-pc-send').onclick=pcCommand;q('#nf-pc-command').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();pcCommand();}};
