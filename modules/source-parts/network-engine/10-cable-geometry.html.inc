function connector(color,wiring){const g=RJ.plug(color,{size:1.35,offset:.04,wiring});scene.add(g);return g;}
function recolorCable(c,type){const spec=cableTypes[type];c.type=type;c.color=spec.color;c.mesh.material.color.setHex(spec.color);c.plugs.forEach(p=>RJ.release(p));c.plugs=[connector(c.color),connector(c.color,spec.pins)];c.pathState=null;dirtyCable=true;}
function resolveCableChoice(c){if(c.autoPending&&c.a&&c.b){recolorCable(c,recommendedCable(c.a,c.b));c.autoPending=false;}}
function createChosenCable(id,a,loose){const type=cableChoice==='auto'?'straight':cableChoice;return makeCable(id,a,null,cableTypes[type].color,loose,{type,autoPending:cableChoice==='auto'});}
function makeCable(id,a,b,color,loose=null,options={}){const type=cableTypes[options.type]?options.type:recommendedCable(a,b);const mat=RJ.cableMaterial(color),mesh=new T.Mesh(new T.BufferGeometry(),mat);mesh.castShadow=true;mesh.receiveShadow=true;scene.add(mesh);const c={id,a,b,color,type,autoPending:options.autoPending===true,looseA:null,looseB:loose,homeA:a,homeB:b,readyAt:0,mesh,plugs:[connector(color),connector(color,cableTypes[type].pins)]};cables.push(c);return c;}
makeCable('uplink','S1:G0/1','R1:G0/1',0x49789b);makeCable('client','S1:F0/6','PC1:F0',0xa57b4d);
function endpoint(c,side,t){const name=side===0?'a':'b',key=c[name];if(animation?.c===c&&animation.side===side){const u=Math.min(1,Math.max(0,(t-animation.start)/animation.duration)),e=u*u*(3-2*u),from=animation.from,to=animation.to;let p;if(animation.connect){const approach=to.p.clone().addScaledVector(to.n,.70);if(e<.75)p=from.p.clone().lerp(approach,e/.75).add(V(0,Math.sin(Math.PI*e/.75)*.25,0));else p=approach.lerp(to.p,(e-.75)/.25);}else{if(e<.32)p=from.p.clone().addScaledVector(from.n,.55*(e/.32));else p=from.p.clone().addScaledVector(from.n,.55).lerp(to.p,(e-.32)/.68).add(V(0,Math.sin(Math.PI*(e-.32)/.68)*.10,0));}return{p,n:from.n.clone().lerp(to.n,e).normalize()};}if(key)return at(key);const v=c[side===0?'looseA':'looseB'];return{p:V(...v.p),n:V(...v.n)};}
function drawCables(t){for(const c of cables){const a=endpoint(c,0,t),b=endpoint(c,1,t);for(const [i,v]of[[0,a],[1,b]]){c.plugs[i].position.copy(v.p);c.plugs[i].quaternion.setFromUnitVectors(V(0,0,1),v.n);RJ.pressLatch(c.plugs[i],animation?.c===c&&animation.side===i?Math.sin(Math.min(1,(t-animation.start)/animation.duration)*Math.PI):0);}
 // Unchanged cables keep their geometry and GPU buffers during another cable's motion.
 const pathState=[...a.p.toArray(),...a.n.toArray(),...b.p.toArray(),...b.n.toArray()];if(c.pathState?.every((v,i)=>v===pathState[i]))continue;c.pathState=pathState;
 const ac=a.p.clone().addScaledVector(a.n,c.plugs[0].userData.cableExit),bc=b.p.clone().addScaledVector(b.n,c.plugs[1].userData.cableExit),aOut=ac.clone().addScaledVector(a.n,.65),bOut=bc.clone().addScaledVector(b.n,.65);aOut.y=bOut.y=.065;
 const along=bOut.clone().sub(aOut);along.y=0;if(along.lengthSq()<.001)along.set(1,0,0);along.normalize();const side=V(-along.z,0,along.x).multiplyScalar(.38);aOut.add(side);bOut.add(side);
 const curve=new T.CurvePath();curve.add(new T.CubicBezierCurve3(ac,ac.clone().addScaledVector(a.n,.4),aOut.clone().addScaledVector(along,-.35),aOut));curve.add(new T.CubicBezierCurve3(aOut,aOut.clone().addScaledVector(along,.35),bOut.clone().addScaledVector(along,-.35),bOut));curve.add(new T.CubicBezierCurve3(bOut,bOut.clone().addScaledVector(along,.35),bc.clone().addScaledVector(b.n,.4),bc));
 const curvePoint=curve.getPoint.bind(curve);curve.getPoint=(t,target)=>{const p=curvePoint(t,target);p.y=Math.max(.05,p.y);return p;};const geo=new T.TubeGeometry(curve,112,.031*1.35,16,false);c.mesh.geometry.dispose();c.mesh.geometry=geo;}}

