function cableAction(){if(busy)return;if(linking){if(linking.c){connectTo(linking.c,linking.side,selected);return;}if(!linking.origin){linking.origin=selected;announce('اختر الجهاز والمنفذ للطرف الثاني.');updateUI();return;}if(ports[linking.origin].id===ports[selected].id){announce('اختر منفذًا في جهاز آخر للطرف الثاني.');return;}const from=at(linking.origin),free=from.p.clone().addScaledVector(from.n,.7);free.y=.1;const c=createChosenCable('c'+Date.now(),linking.origin,{p:free.toArray(),n:from.n.toArray()});connectTo(c,1,selected);return;}const c=cableFor(selected),loose=looseForHome(selected);if(c)detach();else if(loose)connectTo(loose.c,loose.side,selected);else startCable();}
function sendData(){if(busy)return;trafficCables=new Set(cables.filter(c=>cableUp(c)).map(c=>c.id));trafficUntil=performance.now()+3200;announce(trafficCables.size?'نشاط بيانات تجريبي على الوصلات القائمة؛ ضوء النشاط يطفئ ويضيء أثناء الإرسال.':'لا توجد وصلة قائمة لعرض نشاط البيانات.');updateUI();wake();}
function lights(t){for(const[id,d]of Object.entries(devices)){const starting=boot[id]>t;light(d.sys,d.type==='PC'?(power[id]?1:0):LED.system(power[id],starting,t/1000,reduced.matches));if(d.screen)d.screen.emissiveIntensity=power[id]&&!starting?.28:0;if(d.screen)d.screen.color.setHex(power[id]&&!starting?0xffffff:0x050505);}
const glowing=[];for(const p of Object.values(ports)){const [st]=portState(p.key,t),on=LED.level(st==='up'||st==='activity',st==='activity',t/1000,reduced.matches);light(p.led,on);if(on)glowing.push(p);if(p.key===selected)q('#nf-status-led').dataset.lit=String(!!on);}
 glowing.sort((a,b)=>Number(b.key===selected)-Number(a.key===selected));ledSpills.forEach((lamp,i)=>{const p=glowing[i];lamp.visible=!!p;lamp.intensity=p?.035:0;if(p){const pose=at(p.key);lamp.position.copy(pose.p).addScaledVector(pose.n,.045).add(V(0,.085,0));lamp.userData.device=p.id;}});}

