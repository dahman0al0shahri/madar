class NetworkModel{
 constructor(env){this.env=env;this.config={};this.lastPing=null;}
 type(id){return this.env.types()[id];}
 keys(id){return this.env.ports().filter(k=>k.startsWith(id+':')).map(k=>k.split(':')[1]);}
 ensure(id){if(!this.type(id))return null;if(!this.config[id])this.config[id]={hostname:id,vlans:{1:'default',1002:'fddi-default',1003:'token-ring-default',1004:'fddinet-default',1005:'trnet-default'},interfaces:{},gateway:null,pc:{ip:'',mask:'',gateway:''},startup:null};const c=this.config[id];for(const name of this.keys(id))if(!c.interfaces[name]?.kind)c.interfaces[name]={kind:'physical',mode:'dynamic auto',access:1,native:1,allowed:'all',negotiate:true,ip:null,mask:null,description:'',shutdown:false,...(c.interfaces[name]||{})};return c;}
 iface(id,name){return this.ensure(id)?.interfaces[name];}
 admin(id,name){const x=this.iface(id,name);return x&&!(x.kind==='physical'?this.env.admin(id+':'+name)===false:x.shutdown);}
 status(id,name){const x=this.iface(id,name);if(!x)return ['down','down'];if(!this.admin(id,name))return ['administratively down','down'];if(!this.env.power(id))return ['down','down'];if(x.kind==='physical')return this.env.up(id+':'+name)?['up','up']:['down','down'];if(x.kind==='sub'){const parent=this.status(id,x.parent);return parent[0]==='up'?['up','up']:parent;}
 const c=this.ensure(id),v=Number(name.slice(4));return c.vlans[v]&&this.keys(id).some(n=>this.env.up(id+':'+n)&&this.carries(id,n,v))?['up','up']:['up','down'];}
 operationalTrunk(id,name){const x=this.iface(id,name);if(!x||this.type(id)!=='S')return false;if(x.mode==='trunk')return true;if(x.mode==='access')return false;const peer=this.env.peer(id+':'+name);if(!peer)return false;const [did,dname]=peer.split(':');if(this.type(did)!=='S')return false;const y=this.iface(did,dname);if(!x.negotiate||!y.negotiate)return false;return x.mode==='dynamic desirable'?y.mode!=='access':['trunk','dynamic desirable'].includes(y.mode);}
 allowed(x,v){return x.allowed==='all'||x.allowed.includes(v);}
 carries(id,name,v){const x=this.iface(id,name),c=this.ensure(id);return !!c.vlans[v]&&(this.operationalTrunk(id,name)?this.allowed(x,v):x.access===v);}
 export(){const defaults={kind:'physical',mode:'dynamic auto',access:1,native:1,allowed:'all',negotiate:true,ip:null,mask:null,description:'',shutdown:false};const compact=c=>{const out=clone(c);for(const [n,x]of Object.entries(out.interfaces)){if(Array.isArray(x.allowed))x.allowed=compress(x.allowed);if(x.kind==='physical'){for(const k of Object.keys(x))if(x[k]===defaults[k])delete x[k];if(!Object.keys(x).length)delete out.interfaces[n];}}if(out.startup?.config)out.startup.config=compact(out.startup.config);return out;};const out={};for(const id of Object.keys(this.env.types()))out[id]=compact(this.ensure(id));return out;}
 import(data){this.config={};const expand=c=>{for(const x of Object.values(c.interfaces))if(typeof x.allowed==='string'&&x.allowed!=='all')x.allowed=x.allowed==='none'?[]:vlanList(x.allowed)||[];if(c.startup?.config)expand(c.startup.config);return c;};if(data&&typeof data==='object')for(const id of Object.keys(this.env.types()))if(data[id]&&typeof data[id]==='object'&&data[id].interfaces&&data[id].vlans){this.config[id]=expand(clone(data[id]));const old=this.config[id].interfaces;this.config[id].interfaces={};this.ensure(id);for(const [n,x]of Object.entries(old))this.config[id].interfaces[n]={...(this.config[id].interfaces[n]||{}),...x};}Object.keys(this.env.types()).forEach(id=>this.ensure(id));this.lastPing=null;}
 forget(id){delete this.config[id];this.lastPing=null;}
 hasSwitchCycle(){const parent={},seen=new Set(),find=x=>{parent[x]??=x;return parent[x]===x?x:parent[x]=find(parent[x]);};for(const key of this.env.ports()){const id=key.split(':')[0],peer=this.env.peer(key);if(this.type(id)!=='S'||!peer||!this.env.up(key))continue;const did=peer.split(':')[0];if(this.type(did)!=='S')continue;const edge=[key,peer].sort().join('|');if(seen.has(edge))continue;seen.add(edge);const a=find(id),b=find(did);if(a===b)return true;parent[a]=b;}return false;}
 endpoints(){const out=[];for(const [id,type]of Object.entries(this.env.types())){const c=this.ensure(id);if(type==='PC'){if(c.pc.ip&&hostAddress(c.pc.ip,c.pc.mask))out.push({id,name:'F0',physical:'F0',tag:null,...c.pc,type:'host'});continue;}for(const [name,x]of Object.entries(c.interfaces)){if(!x.ip||this.status(id,name)[1]!=='up')continue;out.push({id,name,physical:x.kind==='svi'?null:x.parent||name,tag:x.kind==='sub'&&!x.nativeTag?x.tag:null,ip:x.ip,mask:x.mask,gateway:c.gateway,type:type==='R'?'router':'host',vlan:x.kind==='svi'?Number(name.slice(4)):null});}}return out;}
 // Traverse frames by wire tag. Native VLAN translation is local to each ingress.
 layer2(source,dest){if(source.id===dest.id&&source.name===dest.name)return{ok:true,path:[],trace:[]};const queue=[],seen=new Set(),notes=new Set();const push=(port,tag,path,trace)=>{const key=port+'|'+tag;if(!seen.has(key)){seen.add(key);queue.push({port,tag,path,trace});}};
 const sendSwitch=(id,v,from,path,trace)=>{if(!this.ensure(id).vlans[v]){notes.add(id+': VLAN '+v+' غير موجودة');return;}if(dest.id===id&&dest.vlan===v){queue.push({reached:true,path,trace});return;}for(const n of this.keys(id)){const k=id+':'+n;if(k===from||!this.env.up(k))continue;const x=this.iface(id,n);if(!this.carries(id,n,v))continue;push(k,this.operationalTrunk(id,n)?(v===x.native?null:v):null,path,trace);}};
 if(source.physical)push(source.id+':'+source.physical,source.tag,[],[]);else sendSwitch(source.id,source.vlan,null,[],[]);
 while(queue.length){const hop=queue.shift();if(hop.reached)return{ok:true,path:hop.path,trace:hop.trace};const {port,tag,path,trace}=hop;if(!this.env.up(port)){notes.add(port+' غير متصل أو مغلق');continue;}const peer=this.env.peer(port);if(!peer)continue;const [id,name]=peer.split(':'),cid=this.env.cable(port),nextPath=[...path,cid],nextTrace=[...trace,port+' → '+peer+' · '+(tag===null?'untagged':'VLAN '+tag)];if(id===dest.id&&name===dest.physical&&tag===dest.tag)return{ok:true,path:nextPath,trace:nextTrace};if(this.type(id)!=='S'){notes.add(peer+': لا واجهة تستقبل '+(tag===null?'إطارًا بلا وسم':'VLAN '+tag));continue;}const x=this.iface(id,name),trunk=this.operationalTrunk(id,name);if(!trunk&&tag!==null&&tag!==x.access){notes.add(peer+': منفذ access لا يستقبل هذا الوسم');continue;}const v=trunk?(tag===null?x.native:tag):x.access;if(!this.ensure(id).vlans[v]){notes.add(id+': VLAN '+v+' غير موجودة');continue;}if(trunk&&!this.allowed(x,v)){notes.add(peer+': VLAN '+v+' غير مسموحة على trunk');continue;}sendSwitch(id,v,peer,nextPath,nextTrace);}
 return{ok:false,path:[],trace:[...notes],reason:'لم يجد الإطار مسارًا مطابقًا لإعدادات VLAN والوسم والمنافذ.'};}
 route(source,dest,all){if(source.id===dest.id&&source.ip===dest.ip)return{ok:true,path:[],trace:[]};let next=source,path=[],trace=[],visited=new Set();for(let ttl=0;ttl<16;ttl++){if(visited.has(next.id+'|'+next.ip))return{ok:false,path,trace,reason:'حلقة في مسار التوجيه.'};visited.add(next.id+'|'+next.ip);
 if(sameNet(next.ip,dest.ip,next.mask)){const leg=this.layer2(next,dest);return{...leg,path:[...path,...leg.path],trace:[...trace,...leg.trace]};}
 if(next.type==='router'){const routes=all.filter(e=>e.id===next.id&&e.type==='router'&&sameNet(e.ip,dest.ip,e.mask)).sort((a,b)=>maskBits(b.mask)-maskBits(a.mask));if(!routes.length)return{ok:false,path,trace,reason:next.id+': لا مسار متصل إلى شبكة الوجهة.'};const leg=this.layer2(routes[0],dest);return{...leg,path:[...path,...leg.path],trace:[...trace,'توجيه داخل '+next.id+': '+next.name+' → '+routes[0].name,...leg.trace]};}
 if(!next.gateway||!sameNet(next.ip,next.gateway,next.mask))return{ok:false,path,trace,reason:next.id+': البوابة الافتراضية مفقودة أو خارج الشبكة المحلية.'};const gateways=all.filter(e=>e.type==='router'&&e.ip===next.gateway);let found=null;for(const g of gateways){const leg=this.layer2(next,g);if(leg.ok){found={g,leg};break;}}if(!found)return{ok:false,path,trace,reason:next.id+': تعذر الوصول إلى البوابة '+next.gateway};path.push(...found.leg.path);trace.push(...found.leg.trace);next=found.g;}
 return{ok:false,path,trace,reason:'تجاوز حد التوجيه في المعاينة.'};}
 ping(id,target){const fail=(reason,trace=[])=>this.lastPing={ok:false,source:id,target,reason,path:[],trace};if(this.hasSwitchCycle())return fail('الفحص غير مدعوم لهذه البنية: توجد حلقة بين Switches تحتاج محاكاة STP.');if(ipNumber(target)===null)return fail('عنوان IPv4 غير صحيح.');if(!this.env.power(id))return fail('الجهاز مطفأ.');const all=this.endpoints(),targets=all.filter(e=>e.ip===target);let sources=all.filter(e=>e.id===id);if(!sources.length)return fail('لا يوجد عنوان IP صالح على واجهة عاملة في جهاز المصدر.');if(!targets.length)return fail('لا جهاز ذو عنوان الوجهة وواجهة عاملة في هذه الشبكة.');sources.sort((a,b)=>Number(sameNet(b.ip,target,b.mask))-Number(sameNet(a.ip,target,a.mask)));let issue=null;for(const src of sources){for(const dst of targets){const forward=this.route(src,dst,all);if(!forward.ok){issue=forward;continue;}const back=this.route(dst,src,all);if(!back.ok){issue={...back,reason:'مسار الرد: '+back.reason};continue;}return this.lastPing={ok:true,source:id,target,reason:'وصل الطلب والرد بحسب الإعدادات الحالية.',path:[...new Set([...forward.path,...back.path])],trace:[...forward.trace,'عودة الرد',...back.trace]};}}return fail(issue?.reason||'تعذر الاتصال.',issue?.trace||[]);}
 running(id,override=null,savedAdmin=null){const c=override||this.ensure(id);if(override){for(const n of this.keys(id))c.interfaces[n]={kind:'physical',mode:'dynamic auto',access:1,native:1,allowed:'all',negotiate:true,ip:null,mask:null,description:'',shutdown:false,...(c.interfaces[n]||{})};}const out=['hostname '+c.hostname];if(this.type(id)==='S')for(const [v,n]of Object.entries(c.vlans))if(Number(v)<1002||Number(v)>1005)out.push('vlan '+v,' name '+n,'!');if(c.gateway)out.push('ip default-gateway '+c.gateway);for(const [name,x]of Object.entries(c.interfaces)){out.push('interface '+full(name));if(x.description)out.push(' description '+x.description);if(x.kind==='sub'&&x.tag)out.push(' encapsulation dot1Q '+x.tag+(x.nativeTag?' native':''));if(this.type(id)==='S'&&x.kind==='physical'){out.push(' switchport mode '+x.mode,' switchport access vlan '+x.access,' switchport trunk native vlan '+x.native,' switchport trunk allowed vlan '+(x.allowed==='all'?'all':compress(x.allowed)));if(!x.negotiate)out.push(' switchport nonegotiate');}if(x.ip)out.push(' ip address '+x.ip+' '+x.mask);out.push((savedAdmin?(x.kind==='physical'?savedAdmin[name]!==false:!x.shutdown):this.admin(id,name))?' no shutdown':' shutdown','!');}return out;}
 show(id,what,arg){const c=this.ensure(id),names=Object.keys(c.interfaces),out=[];if(what==='run')return['Building configuration...','! Model-supported configuration',...this.running(id)];if(what==='start')return c.startup?this.running(id,clone(c.startup.config),c.startup.admin):['startup-config is not present'];if(what==='brief'){out.push('Interface                 IP-Address      OK? Method Status                Protocol');for(const name of names){const x=c.interfaces[name],[st,pr]=this.status(id,name);out.push(full(name).padEnd(26)+(x.ip||'unassigned').padEnd(16)+'YES '+(x.ip?'manual':'unset ').padEnd(7)+st.padEnd(22)+pr);}return out;}
 if(what==='vlan'){out.push('VLAN Name                             Status    Ports');for(const [v,n]of Object.entries(c.vlans).filter(([v])=>!arg||Number(v)===arg)){const members=this.keys(id).filter(name=>!this.operationalTrunk(id,name)&&this.iface(id,name).access===Number(v));out.push(v.padEnd(5)+n.padEnd(33)+(Number(v)>=1002&&Number(v)<=1005?'act/unsup':'active').padEnd(10)+members.join(', '));}return out;}
 if(what==='trunk'){const trunks=this.keys(id).filter(n=>this.env.up(id+':'+n)&&this.operationalTrunk(id,n)&&(!arg||n===arg));out.push('Port     Mode       Encapsulation Status    Native vlan');for(const n of trunks)out.push(n.padEnd(9)+this.iface(id,n).mode.padEnd(11)+'802.1q        trunking  '+this.iface(id,n).native);out.push('','Port     Vlans allowed on trunk');for(const n of trunks)out.push(n.padEnd(9)+compress(this.iface(id,n).allowed));out.push('','Port     Vlans allowed and active in management domain');for(const n of trunks)out.push(n.padEnd(9)+compress(Object.keys(c.vlans).map(Number).filter(v=>v<1002||v>1005).filter(v=>this.allowed(this.iface(id,n),v))));return out;}
 if(what==='switchport'){for(const n of arg?[arg]:this.keys(id)){const x=this.iface(id,n);out.push('Name: '+full(n),'Switchport: Enabled','Administrative Mode: '+x.mode,'Operational Mode: '+(this.env.up(id+':'+n)?this.operationalTrunk(id,n)?'trunk':'static access':'down'),'Access Mode VLAN: '+x.access+' ('+(c.vlans[x.access]||'inactive')+')','Trunking Native Mode VLAN: '+x.native,'Trunking VLANs Enabled: '+compress(x.allowed),'Negotiation of Trunking: '+(x.negotiate?'On':'Off'),'');}return out;}
 if(what==='status'){out.push('Port      Status        Vlan');for(const n of this.keys(id)){const x=this.iface(id,n);out.push(n.padEnd(10)+(!this.admin(id,n)?'disabled':this.env.up(id+':'+n)?'connected':'notconnect').padEnd(14)+(this.operationalTrunk(id,n)?'trunk':x.access));}return out;}
 if(what==='route'){out.push('Codes: C - connected, L - local','Gateway of last resort is not set');for(const e of this.endpoints().filter(e=>e.id===id)){out.push('C    '+ipString((ipNumber(e.ip)&ipNumber(e.mask))>>>0)+'/'+maskBits(e.mask)+' is directly connected, '+full(e.name),'L    '+e.ip+'/32 is directly connected, '+full(e.name));}return out;}
 if(what==='interfaces'){for(const n of arg?[arg]:names){const x=c.interfaces[n],[st,pr]=this.status(id,n);out.push(full(n)+' is '+st+', line protocol is '+pr);if(x.description)out.push('  Description: '+x.description);if(x.ip)out.push('  Internet address is '+x.ip+'/'+maskBits(x.mask));if(x.kind==='sub'&&x.tag)out.push('  Encapsulation 802.1Q, Vlan ID '+x.tag+(x.nativeTag?', native':''));}return out;}return ['% Unsupported show command'];}
}

