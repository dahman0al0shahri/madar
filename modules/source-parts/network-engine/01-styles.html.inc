#madar-free .nf-assist-panel{position:relative;isolation:isolate;margin:14px 0;border:1px solid rgba(var(--help-rgb),.42);border-top:3px solid var(--help-color);border-radius:16px;background:linear-gradient(125deg,rgba(var(--help-rgb),.12),transparent 62%),#141d23;box-shadow:0 8px 24px #0003;overflow:hidden}
