function cliPrompt(){return ios.prompt(cliDevice);}
function fullName(key){return N.full(key.split(':')[1]);}
function refreshCli(){refreshPingSources();renderVlanGuide();if(!ports[selected]){q('#nf-pc').hidden=true;return;}const id=ports[selected].id;network.ensure(id);const isPC=devices[id].type==='PC';q('#nf-console').hidden=isPC;cliDetails.hidden=isPC;q('#nf-pc').hidden=!isPC;if(isPC){const pc=network.ensure(id).pc;q('#nf-pc-title').textContent=id+' · إعدادات الحاسب';if(pcSelected!==id){q('#nf-pc-ip').value=pc.ip||'';q('#nf-pc-mask').value=pc.mask||'';q('#nf-pc-gateway').value=pc.gateway||'';q('#nf-pc-log').textContent='';q('#nf-pc-message').textContent='';pcSelected=id;}return;}pcSelected='';cliDevice=id;const s=ios.session(id),info=modeInfo[s.mode];q('#nf-cli-title').textContent=network.ensure(id).hostname+' · سطر الأوامر CLI';q('#nf-prompt').textContent=cliPrompt();q('#nf-mode-prompt').textContent=cliPrompt();q('#nf-mode-title').textContent=info[0];q('#nf-mode-explain').textContent=info[1];q('#nf-cli-context').textContent=s.mode==='range'?'المنافذ: '+s.range.join('، '):['interface','sub','svi'].includes(s.mode)?'الواجهة: '+id+' / '+s.port:s.mode==='vlan'?'VLAN '+s.vlan:'conf t اختصار للأمر configure terminal، وليس اسم المرحلة.';cliLog.textContent=s.lines.join('\n');cliLog.scrollTop=cliLog.scrollHeight;cliInput.disabled=!power[id]||busy;q('#nf-command-list').textContent=ios.specs(id).map(r=>r.pattern+' — '+r.desc).join('\n');renderLesson();}
function showHelp(){const raw=cliInput.value,s=ios.session(cliDevice);s.lines.push(ios.prompt(cliDevice)+raw+'?',...ios.help(cliDevice,raw));s.lines=s.lines.slice(-110);refreshCli();save();}
function runCli(){if(busy||!power[cliDevice])return;const raw=cliInput.value;cliInput.value='';const oldPing=network.lastPing,result=ios.run(cliDevice,raw),s=ios.session(cliDevice);if(result.ok&&result.command?.includes('show ')&&lesson?.key.startsWith(cliDevice+':')&&ports[lesson.key]){const name=lesson.key.split(':')[1],covers=result.command==='show ip interface brief'||result.command==='do show ip interface brief'||result.command==='show interfaces'||result.command==='do show interfaces'||result.args?.includes(name);if(covers&&admin[lesson.key]&&network.status(cliDevice,name)[1]==='up')lesson.done=true;}
 if(result.ok&&!result.help&&result.command&&!/^(do )?(show|ping|help)/.test(result.command))invalidatePing();if(network.lastPing&&network.lastPing!==oldPing)displayPing(network.lastPing);updateUI();if(result.command==='help'){const walker=document.createTreeWalker(cliLog,NodeFilter.SHOW_TEXT);let node;while(node=walker.nextNode()){const at=node.textContent.lastIndexOf('دليل مدار للأوامر');if(at<0)continue;const range=document.createRange();range.setStart(node,at);range.setEnd(node,at+1);cliLog.scrollTop+=range.getBoundingClientRect().top-cliLog.getBoundingClientRect().top-12;}}save();wake();}
q('#nf-console').onclick=()=>{cliDetails.open=true;refreshCli();cliInput.focus({preventScroll:true});};q('#nf-command-send').onclick=runCli;q('#nf-cli-help').onclick=showHelp;
cliInput.addEventListener('keydown',e=>{const s=ios.session(cliDevice);if(e.key==='Enter'){e.preventDefault();runCli();}else if(e.key==='?'){e.preventDefault();showHelp();}else if(e.key==='Tab'){e.preventDefault();const next=ios.complete(cliDevice,cliInput.value);if(next===cliInput.value)showHelp();else cliInput.value=next;}else if(e.key==='ArrowUp'||e.key==='ArrowDown'){e.preventDefault();s.historyIndex=Math.max(0,Math.min(s.history.length,s.historyIndex+(e.key==='ArrowUp'?-1:1)));cliInput.value=s.history[s.historyIndex]||'';}else if(e.ctrlKey&&e.key.toLowerCase()==='z'){e.preventDefault();if(!['user','priv'].includes(s.mode))s.mode='priv';cliInput.value='';refreshCli();save();}else if(e.ctrlKey&&e.key.toLowerCase()==='c'){e.preventDefault();cliInput.value='';s.pending=null;}});
cliInput.addEventListener('input',()=>{if(cliInput.value.includes('?')){cliInput.value=cliInput.value.split('?')[0];showHelp();}});
const learnEntry=document.createElement('button');learnEntry.type='button';learnEntry.id='nf-open-learning';learnEntry.textContent='تدريب خطوة بخطوة';q('.nf-tools>div').prepend(learnEntry);learnEntry.onclick=()=>{if(!ports[selected]||devices[ports[selected].id].type==='PC'){const k=Object.keys(ports).find(k=>devices[ports[k].id].type!=='PC');if(!k){announce('أضف Router أو Switch أولًا.');return;}selectPort(k,false);}cliDetails.open=true;refreshCli();cliDetails.scrollIntoView({behavior:reduced.matches?'instant':'smooth',block:'start'});};
