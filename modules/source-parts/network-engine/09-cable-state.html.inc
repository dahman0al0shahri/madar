function portState(key,t=performance.now()){const p=ports[key],c=cableFor(key);if(!power[p.id])return['off','الجهاز مطفأ'];if(boot[p.id]>t)return['boot','الجهاز يبدأ التشغيل'];if(!admin[key])return['off','المنفذ مغلق بالإعداد'];if(!c||!c.a||!c.b)return['off','الكابل مفصول'];if(!cableCompatible(c))return['off','نوع الكابل غير مناسب؛ هذا الاتصال يحتاج Crossover'];const other=peer(c,key);if(!isAlive(other,t))return['off','الطرف المقابل مطفأ أو منفذه مغلق'];if(t<c.readyAt||animation?.c===c)return['waiting','جارٍ تأسيس الاتصال'];if(t<trafficUntil&&trafficCables.has(c.id))return['activity','يمرّ إرسال واستقبال بيانات'];return['up','الاتصال قائم'];}
const cableTypes={straight:{label:'Straight-Through',color:0x49789b,pins:[1,2,3,4,5,6,7,8]},crossover:{label:'Crossover',color:0xc78050,pins:[3,6,1,7,8,2,4,5]}};
let cableChoice='auto';
function recommendedCable(a,b){const type=k=>devices[k?.split(':')[0]]?.type;if(!type(a)||!type(b))return 'straight';return (type(a)==='S')===(type(b)==='S')?'crossover':'straight';}
