function selectDevice(id){selectPort(Object.keys(ports).find(k=>k.startsWith(id+':')&&(devices[id].type!=='S'||k.endsWith('G0/1'))));}
function selectPort(key,write=true){if(!ports[key])return;selected=key;q('#nf-device').value=ports[key].id;q('#nf-port').replaceChildren();for(const p of Object.values(ports).filter(p=>p.id===ports[key].id)){const op=document.createElement('option');op.value=p.key;op.textContent=p.name+(cableFor(p.key)?' · موصول':'');q('#nf-port').append(op);}q('#nf-port').value=key;updateUI();wake();if(write)save();}
function looseForHome(key){for(const c of cables){if(!c.a&&c.homeA===key)return{c,side:0};if(!c.b&&c.homeB===key)return{c,side:1};}return null;}
function updateUI(){refreshConnectionEvidence();const empty=!ports[selected];q('.nf-inspector').hidden=empty;ring.visible=!empty;q('#nf-delete-device').disabled=empty||busy;q('#nf-delete-cable').disabled=empty||busy||!(cableFor(selected)||looseForHome(selected));q('#nf-send').disabled=empty||busy;q('#nf-new').disabled=empty||busy;if(empty){q('#nf-pc').hidden=true;refreshPingSources();renderVlanGuide();q('#nf-cli').hidden=true;root.dataset.selected='';return;}refreshCli();const p=ports[selected],[status,text]=portState(selected),c=cableFor(selected),other=c?peer(c,selected):null,loose=looseForHome(selected);root.dataset.link=status;root.dataset.selected=selected;root.dataset.busy=String(busy);q('#nf-status-led').dataset.link=status;q('#nf-status-text').textContent=text;q('#nf-peer').textContent=other?'الطرف المقابل: '+other.replace(':',' / '):loose?'رأس الكابل خارج المنفذ.':c?'الطرف الآخر من الكابل مفصول.':'لا كابل في هذا المنفذ.';q('#nf-lens-name').textContent=p.id+' / '+p.name+' · عرض مباشر للرأس والمنفذ';q('#nf-cable').textContent=linking?(linking.origin||linking.c?'شبّك هنا':'ابدأ من هنا'):c?'افصل الكابل':loose?'أعد شبك الكابل':'ابدأ كابلًا من هنا';q('#nf-cable').disabled=busy||(!!linking&&!!c);q('#nf-power').textContent=power[p.id]?'أطفئ الجهاز':'شغّل الجهاز';q('#nf-move-end').hidden=!loose||!!linking;q('#nf-cancel').hidden=!linking;q('#nf-power').disabled=busy;q('#nf-new').disabled=busy;q('#nf-send').disabled=busy||performance.now()<trafficUntil;for(const[id,b]of Object.entries(labels))b.setAttribute('aria-pressed',String(id===p.id));ring.position.set(devices[p.id].g.position.x,.012,devices[p.id].g.position.z);ring.scale.set(devices[p.id].type==='S'?2.8:2.2,devices[p.id].type==='S'?1.7:1.6,1);}
function detach(){const c=cableFor(selected);if(!c||busy)return;const side=c.a===selected?0:1,from=at(selected),to={p:from.p.clone().addScaledVector(from.n,1.0).add(V(.33,0,0)),n:from.n.clone().applyAxisAngle(V(0,1,0),.35)};to.p.y=.105;c[side===0?'homeA':'homeB']=selected;c[side===0?'a':'b']=null;c[side===0?'looseA':'looseB']={p:to.p.toArray(),n:to.n.toArray()};trafficUntil=0;animate(c,side,from,to,false);announce('تحرير المشبك وسحب الرأس؛ انقطع الاتصال عند الطرفين.');}
function connectTo(c,side,key){if(cableFor(key)){announce('هذا المنفذ مستخدم. اختر منفذًا فارغًا.');return;}const other=side===0?c.b:c.a;if(other&&ports[other].id===ports[key].id){announce('اختر جهازًا آخر لطرف الكابل الثاني.');return;}const from=endpoint(c,side,performance.now()),to=at(key);c[side===0?'a':'b']=key;c[side===0?'homeA':'homeB']=key;resolveCableChoice(c);c.readyAt=performance.now()+1800;linking=null;animate(c,side,from,to,true);announce('محاذاة الرأس، ثم إدخاله وتثبيت المشبك.');}
function animate(c,side,from,to,connect){busy=true;animation={c,side,from,to,connect,start:performance.now(),duration:reduced.matches?1:1250};dirtyCable=true;updateUI();save();wake();}
function startCable(){if(busy)return;if(cableFor(selected)){linking={origin:null};announce('اختر جهازًا ومنفذًا فارغًا، ثم اضغط «ابدأ من هنا».');}else linking={origin:selected};updateUI();if(linking.origin){announce('الطرف الأول: '+selected+'؛ اختر جهازًا آخر ومنفذًا فارغًا ثم «شبّك هنا».');}q('#nf-cable').disabled=busy||(!!cableFor(selected));q('#nf-cable').textContent=linking.origin?'شبّك هنا':'ابدأ من هنا';wake();}
