function exerciseStep(){if(!vlanExercise)return null;if(!['S1','S2','R1','PC1','PC2'].every(id=>devices[id]))return[0,'أعد تجهيز المختبر','حُذف أحد أجهزة هذا التدريب.'];const a=network.ensure('S1'),b=network.ensure('S2'),r=network.ensure('R1');const names={10:'Management',20:'Sales',30:'Operations',999:'Parking_Lot',1000:'Native'};if(![a,b].every(c=>Object.entries(names).every(([v,n])=>c.vlans[v]===n)))return[1,'أنشئ الشبكات الافتراضية على S1 وS2','الرقم يحدد VLAN، والاسم يساعدك على تمييزها.','داخل Global Configuration (config)# استخدم vlan ثم name.','مثال: vlan 20 ثم name Sales. كرر للشبكات المطلوبة على Switches.'];const access=(id,n,v)=>network.iface(id,n).mode==='access'&&network.iface(id,n).access===v&&admin[id+':'+n];if(!access('S1','F0/6',20)||!access('S2','F0/18',30))return[2,'ضع كل حاسب في شبكته الافتراضية','PC1 في VLAN 20 وPC2 في VLAN 30.','اختر منفذ الحاسب، وحدد وضع access ورقم VLAN.','على S1: interface f0/6 ثم switchport mode access ثم switchport access vlan 20. طبّق النظير على S2 F0/18 في VLAN 30.'];const parked=['S1','S2'].every(id=>network.keys(id).filter(n=>!(id==='S1'?['F0/1','F0/5','F0/6']:['F0/1','F0/18']).includes(n)).every(n=>{const x=network.iface(id,n);return x.mode==='access'&&x.access===999&&!admin[id+':'+n];}));if(!parked)return[2.5,'أمّن المنافذ غير المستخدمة','اجمعها في VLAN 999 وأغلقها إداريًا؛ لا تضع منافذ الأجهزة والوصلات ضمن المجموعة.','استخدم interface range بحسب قائمة المنافذ في تفاصيل المطلوب.','على S1: interface range f0/2 - 4, f0/7 - 24, g0/1 - 2\nswitchport mode access\nswitchport access vlan 999\nshutdown\nعلى S2 المجموعة: f0/2 - 17, f0/19 - 24, g0/1 - 2'];const trunk=(id,n)=>{const x=network.iface(id,n);return x.mode==='trunk'&&x.native===1000&&[10,20,30,1000].every(v=>network.allowed(x,v));};if(!trunk('S1','F0/1')||!trunk('S2','F0/1')||!trunk('S1','F0/5'))return[3,'جهّز وصلات trunk','الشبكات 10 و20 و30 و1000 تعبر الوصلات، و1000 هي native.','راجع المنافذ في تفاصيل المطلوب؛ اضبط الوضع وnative والقائمة.','switchport mode trunk\nswitchport trunk native vlan 1000\nswitchport trunk allowed vlan 10,20,30,1000'];if(!admin['R1:G0/1'])return[4,'فعّل المنفذ الفعلي في Router','المنافذ الفرعية تعتمد على G0/1.','أزل الإغلاق الإداري في إعداد G0/1.','interface g0/1 ثم no shutdown'];if(![10,20,30,1000].every(v=>Object.values(r.interfaces).some(x=>x.kind==='sub'&&x.parent==='G0/1'&&x.tag===v&&!x.shutdown&&(v===1000?x.nativeTag&&!x.ip:!x.nativeTag&&x.ip==='192.168.'+v+'.1'&&x.mask==='255.255.255.0'))))return[5,'أنشئ المنافذ الفرعية وبوابات الشبكات','كل VLAN تحتاج وسمها وبوابتها؛ native 1000 بلا عنوان في هذا التدريب.','الوسم يكتب بعد encapsulation dot1q، وقد يختلف رقم المنفذ الفرعي عن رقم VLAN.','مثال: interface g0/1.20\nencapsulation dot1q 20\nip address 192.168.20.1 255.255.255.0\nوللشبكة الأصلية: encapsulation dot1q 1000 native'];if(![a,b].every((c,i)=>c.interfaces.Vlan10?.ip==='192.168.10.'+(11+i)&&c.interfaces.Vlan10.mask==='255.255.255.0'&&!c.interfaces.Vlan10.shutdown&&c.gateway==='192.168.10.1'))return[6,'أضف إدارة Switches','واجهة Vlan10 تتيح الوصول إلى Switch نفسه؛ لا تقوم بالتوجيه بين VLANs.','استخدم interface vlan 10 ثم العنوان والقناع، والبوابة في Global Configuration (config)#.','S1: interface vlan 10\nip address 192.168.10.11 255.255.255.0\nno shutdown\nexit\nip default-gateway 192.168.10.1\nعلى S2 استخدم 192.168.10.12.'];if(!network.lastPing?.ok||network.lastPing.source!=='PC1'||network.lastPing.target!=='192.168.30.3')return[7,'اختبر وصول PC1 إلى PC2','التحقق هنا وسيلة لمشاهدة أثر إعدادك، وليس إضافة إلى نطاق الاختبار.','اختر PC1 مصدرًا وأدخل عنوان PC2.','من PC1 اكتب ping 192.168.30.3 أو استخدم فحص الاتصال أسفل المساحة.'];return[8,'وصل الطلب والرد بين الشبكتين','جرّب إزالة VLAN 30 من قائمة trunk ثم أعد Ping؛ بعدها أعدها بالأمر add.'];}
function renderVlanGuide(){q('#nf-vlan-guide').hidden=!vlanExercise;const step=exerciseStep();if(!step)return;if(step[0]!==vlanStage){vlanStage=step[0];vlanHint=0;}q('#nf-vlan-current').textContent=step[1];q('#nf-vlan-why').textContent=step[2];renderAssistance('vlan');}
q('#nf-vlan-hint').onclick=()=>{vlanHint=Math.min(2,vlanHint+1);renderVlanGuide();};
function setupVlan(example){if(busy||wireDrag)return;rememberEdit();assist.newAttempt('vlan-'+Date.now().toString(36));Object.keys(devices).forEach(removeDevice);network.config={};for(const k of Object.keys(cliSessions))delete cliSessions[k];createDevice('R1','R',[-5,.52,-3],false);createDevice('S1','S',[1,.35,-3]);createDevice('S2','S',[5,.35,2]);createDevice('PC1','PC',[-5,.85,4]);createDevice('PC2','PC',[3,.85,8]);makeCable('vlan-router','R1:G0/1','S1:F0/5',0xe3bd7e);makeCable('vlan-trunk','S1:F0/1','S2:F0/1',0xe3bd7e);makeCable('vlan-pc1','PC1:F0','S1:F0/6',0x68bca5);makeCable('vlan-pc2','PC2:F0','S2:F0/18',0x68bca5);network.ensure('PC1').pc={ip:'192.168.20.3',mask:'255.255.255.0',gateway:'192.168.20.1'};network.ensure('PC2').pc={ip:'192.168.30.3',mask:'255.255.255.0',gateway:'192.168.30.1'};
 if(example){const run=(id,cmds)=>{for(const cmd of cmds){const result=ios.run(id,cmd);if(!result.ok)throw Error(id+' '+cmd+': '+result.out.join(' '));}};for(const id of ['S1','S2']){run(id,['enable','conf t',...Object.entries({10:'Management',20:'Sales',30:'Operations',999:'Parking_Lot',1000:'Native'}).flatMap(([v,n])=>['vlan '+v,'name '+n]),'interface '+(id==='S1'?'f0/6':'f0/18'),'switchport mode access','switchport access vlan '+(id==='S1'?20:30)]);for(const n of id==='S1'?['f0/1','f0/5']:['f0/1'])run(id,['interface '+n,'switchport mode trunk','switchport trunk native vlan 1000','switchport trunk allowed vlan 10,20,30,1000']);const unused=network.keys(id).filter(n=>!(id==='S1'?['F0/1','F0/5','F0/6']:['F0/1','F0/18']).includes(n));for(const n of unused)run(id,['interface '+n,'switchport mode access','switchport access vlan 999','shutdown']);run(id,['interface vlan 10','ip address 192.168.10.'+(id==='S1'?11:12)+' 255.255.255.0','no shutdown','exit','ip default-gateway 192.168.10.1','end']);}run('R1',['enable','conf t','int g0/1','no shut']);for(const v of [10,20,30,1000])run('R1',['int g0/1.'+v,'encapsulation dot1q '+v+(v===1000?' native':''),'description '+(v===1000?'Native VLAN':'Network '+v),...(v===1000?[]:['ip address 192.168.'+v+'.1 255.255.255.0'])]);run('R1',['end']);}
 lesson=null;vlanExercise=true;vlanStage=-1;selected='S1:F0/6';pcSelected='';network.lastPing=null;afterEdit();q('#nf-all').click();q('#nf-ping-source').value='PC1';q('#nf-ping-target').value='192.168.30.3';cliDetails.open=true;invalidatePing();announce(example?'مثال مكتمل؛ افحصه ثم غيّر الإعدادات وشاهد أثرها.':'المختبر جاهز؛ ابدأ بإنشاء VLAN على S1 وS2.');save();}
q('#nf-vlan-lab').onclick=()=>setupVlan(false);q('#nf-vlan-example').onclick=()=>setupVlan(true);

