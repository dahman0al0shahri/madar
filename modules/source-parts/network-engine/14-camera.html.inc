// Resizing clears the drawing buffer, even at the same size. Only resize changed
// views, inside the frame that redraws them, never in a ResizeObserver callback.
const viewSize=new T.Vector2();
function resizeView(output,element){const w=element.clientWidth,h=element.clientHeight;if(!w||!h)return false;output.getSize(viewSize);if(viewSize.x===w&&viewSize.y===h)return false;output.setSize(w,h,false);return true;}
