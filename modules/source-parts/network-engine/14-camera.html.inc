function fitCloseup(target,plug,port){if(!plug)return;const box=new T.Box3().setFromObject(plug),points=[port.clone()];for(const x of [box.min.x,box.max.x])for(const y of [box.min.y,box.max.y])for(const z of [box.min.z,box.max.z])points.push(V(x,y,z));for(let i=0;i<3;i++){const edge=Math.max(...points.map(p=>{const v=p.clone().project(closeCamera);return Math.max(Math.abs(v.x),Math.abs(v.y));}));if(edge<=.88)break;closeCamera.position.sub(target).multiplyScalar(edge/.88).add(target);closeCamera.updateMatrixWorld();}}
