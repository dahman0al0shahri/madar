function createDevice(id,type,position,configured=true){const base=F.models[type+'1'],g=base.clone(true),materials=new Map();g.traverse(o=>{if(o.material&&!Array.isArray(o.material)){if(!materials.has(o.material))materials.set(o.material,o.material.clone());o.material=materials.get(o.material);}});g.position.fromArray(position);if(type==='R')g.rotation.y=Math.PI;const obsolete=[];g.traverse(o=>{if(o.material?.emissive&&[0x5dad25,0x538f37,0x4b9b39].includes(o.material.emissive.getHex()))obsolete.push(o);});obsolete.forEach(o=>o.parent.remove(o));g.userData.device=id;scene.add(g);const ledPos=type==='S'?V(-1.94,-.032,1.26):type==='R'?V(-.95,.27,1.30):V(1.69,.72,.526);devices[id]={type,g,sys:makeLed(g,ledPos,.04),screen:null};power[id]=true;boot[id]=0;if(type==='PC')g.traverse(o=>{if(o.material?.emissiveMap)devices[id].screen=o.material;});const button=document.createElement('button');button.type='button';button.className='nf-device-label';button.textContent=id;button.dataset.device=id;button.onclick=()=>{selectDevice(id);focusPorts(selected);};q('#nf-labels').append(button);labels[id]=button;
if(type==='S'){for(let i=0;i<12;i++)for(let row=0;row<2;row++)addPort(id,'F0/'+(i*2+row+1),[-.92+i*.22,.087-row*.18,1.252],[0,0,1]);addPort(id,'G0/1',[1.76,-.04,1.253],[0,0,1],.225,.18);addPort(id,'G0/2',[2.04,-.04,1.253],[0,0,1],.225,.18);}
else if(type==='R'){addPort(id,'G0/0',[.32,-.18,-1.314],[0,0,-1],.25,.20);addPort(id,'G0/1',[-.06,-.18,-1.314],[0,0,-1],.25,.20);if(!configured)for(const k of Object.keys(ports).filter(k=>ports[k].id===id))admin[k]=false;}
else{const io=new T.Group();io.position.set(1.47,.22,-1.11);io.rotation.y=Math.PI;g.add(io);F.panel(io,.82,1.95,.015,[[0,-.37,.245,.195]],F.steel);F.ports(io,[[0,-.37,.035,.235,.185]]);io.children.filter(o=>o.material?.emissive?.getHex()===0x5dad25).forEach(o=>io.remove(o));addPort(id,'F0',[1.47,-.15,-1.15],[0,0,-1],.235,.185);}
const op=document.createElement('option');op.value=id;op.textContent=id+' · '+(type==='R'?'Router':type==='S'?'Switch':'حاسب PC');q('#nf-device').append(op);return id;}
function removeCable(c){c.plugs.forEach(p=>RJ.release(p));scene.remove(c.mesh);c.mesh.geometry.dispose();c.mesh.material.dispose();cables.splice(cables.indexOf(c),1);}
function removeDevice(id){for(const c of [...cables])if([c.a,c.b,c.homeA,c.homeB].some(k=>k&&k.startsWith(id+':')))removeCable(c);scene.remove(devices[id].g);labels[id].remove();delete labels[id];delete devices[id];delete power[id];delete boot[id];delete cliSessions[id];network.forget(id);for(const k of Object.keys(ports).filter(k=>ports[k].id===id)){delete ports[k];delete admin[k];}q('#nf-device').querySelector('option[value="'+id+'"]').remove();}
