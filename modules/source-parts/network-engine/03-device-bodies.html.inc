  if(ended||!h.id||ids.has(h.id)||![1,2,3,4].includes(h.degree)||!h.benefit||!h.body||!Array.isArray(h.adds)||!h.adds.length||!h.authorReview)throw Error('Unreviewed or invalid assistance');
