<script>
(function(root){'use strict';
const VERSION=1,WEIGHTS=Object.freeze({degree:3,count:1,full:3}),LABELS={1:'تلميح من الدرجة الأولى',2:'تلميح من الدرجة الثانية',3:'تلميح من الدرجة الثالثة',full:'كشف الخطوة كاملة'};
const clone=x=>JSON.parse(JSON.stringify(x));
function validate(step){
 if(!step?.id||!step.revision||!step.goal||!Array.isArray(step.answerFacts)||!step.answerFacts.length||!Array.isArray(step.hints)||!step.hints.length)throw Error('Incomplete assistance step');
 const known=new Set(step.givenFacts||[]),ids=new Set(),texts=new Set();let last=0,ended=false;
